{
  "name": "texuli-workspace",
  "private": true,
  "description": "Texuli: a Svelte 5 component library built from small, owned pieces, for people and agents.",
  "author": "Dailybot, Inc.",
  "license": "MIT",
  "type": "module",
  "version": "0.0.0",
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=24.20.0"
  },
  "scripts": {
    "dev": "pnpm --filter @texuli/website dev",
    "build": "pnpm --filter @texuli/website build",
    "preview": "pnpm --filter @texuli/website preview",
    "lint": "biome check && pnpm check:trojan-source",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm check:layers && pnpm check:surfaces",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium webkit",
    "check:layers": "tsx scripts/check-layers.ts",
    "check:skill": "tsx scripts/check-skill.ts",
    "check:surfaces": "tsx scripts/generate-surfaces.ts --check",
    "size": "tsx scripts/size.ts",
    "visual": "tsx scripts/visual.ts",
    "visual:update": "tsx scripts/visual.ts --update",
    "test:perf": "TEXULI_PERF=1 vitest run tests/perf packages/blocks/tests/code.test.ts packages/blocks/tests/text.test.ts",
    "verify:packages": "tsx scripts/packages.ts",
    "check:docs": "tsx scripts/check-docs.ts",
    "check:trojan-source": "tsx scripts/check-trojan-source.ts"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "^1.64.1",
    "@sveltejs/package": "^3.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/svelte": "^5.4.2",
    "@texuli/catalog": "workspace:*",
    "@texuli/core": "workspace:*",
    "@texuli/primitives": "workspace:*",
    "@texuli/tokens": "workspace:*",
    "@types/node": "^24.19.2",
    "happy-dom": "^21.0.3",
    "publint": "^0.3.25",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "tailwindcss": "^4.3.3",
    "texuli": "workspace:*",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
