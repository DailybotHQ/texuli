{
  "name": "@texuli/agent",
  "version": "0.0.0",
  "private": true,
  "description": "The texuli.com agent service: a stateless edge worker that turns a chat prompt into a validated, untrusted blueprint draft. Fake replay provider only; never a real model key in the repository.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "dev": "tsx src/node.ts"
  },
  "dependencies": {
    "@texuli/blocks": "workspace:*",
    "@texuli/catalog": "workspace:*",
    "@texuli/core": "workspace:*"
  },
  "devDependencies": {
    "@texuli/tools": "workspace:*"
  },
  "sideEffects": [
    "**/*.css"
  ]
}
