    "check:csp": "tsx tests/csp-coverage.mts"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/svelte": "^9.1.0",
    "@texuli/blocks": "workspace:*",
    "@texuli/catalog": "workspace:*",
    "@texuli/charts": "workspace:*",
    "@texuli/chat": "workspace:*",
    "@texuli/core": "workspace:*",
    "@texuli/examples": "workspace:*",
    "@texuli/media": "workspace:*",
    "@texuli/player": "workspace:*",
    "@texuli/tokens": "workspace:*",
    "astro": "^7.4.0",
    "svelte": "^5.57.2",
    "texuli": "workspace:*"
  },
  "devDependencies": {
    "typescript": "6.0.3"
  }
}
