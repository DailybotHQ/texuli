{
  "name": "@texuli/website",
  "version": "0.0.0",
  "private": true,
  "description": "texuli.com: the Texuli documentation, catalog and live examples, built with Astro.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "prebuild": "node ../../scripts/generate-examples-catalog.mjs",
    "build": "astro check && astro build",
