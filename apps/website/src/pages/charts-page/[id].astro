---
/**
 * /charts-page/<family>/ — one chart family with contract and live demos.
 */
import ChartFamilyFrame from '../../components/charts-page/ChartFamilyFrame.astro';
import FamilyDemo from '../../components/charts-page/FamilyDemo.svelte';
import { CHART_FAMILIES, familyById } from '../../components/charts-page/families.ts';
import BaseLayout from '../../layouts/BaseLayout.astro';

export function getStaticPaths() {
  return CHART_FAMILIES.map((family) => ({ params: { id: family.id } }));
}

const id = Astro.params.id ?? '';
const family = familyById(id);
if (!family) {
  throw new Error(`Unknown chart family: ${id}`);
}
---

<BaseLayout
  title={`${family.title} charts`}
  description={`${family.summary} Data contract and interactive examples.`}
>
  <nav class="crumb" aria-label="Breadcrumb">
    <ol>
      <li><a href="/charts-page/">Charts gallery</a></li>
      <li aria-current="page">{family.title}</li>
    </ol>
  </nav>
  <ChartFamilyFrame family={family} showPermalink={false} headingLevel={1}>
    <FamilyDemo id={family.id} client:load />
  </ChartFamilyFrame>
</BaseLayout>

<style>
  .crumb ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.5rem;
    margin: 0 0 1.25rem;
    padding: 0;
    list-style: none;
    font-size: 0.875rem;
  }
  .crumb li:not(:last-child)::after {
    content: '/';
    margin-inline-start: 0.5rem;
    color: var(--tx-foreground);
  }
  .crumb a {
    color: var(--tx-link, LinkText);
  }
</style>
