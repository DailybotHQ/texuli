---
import BlockFrame from '../../components/blocks-page/BlockFrame.astro';
import { PAGE_BLOCKS, type PageBlock } from '../../components/blocks-page/blocks.ts';
import AuthSection from '../../components/blocks-page/sections/AuthSection.svelte';
import FaqSection from '../../components/blocks-page/sections/FaqSection.svelte';
import FeaturesSection from '../../components/blocks-page/sections/FeaturesSection.svelte';
import FooterSection from '../../components/blocks-page/sections/FooterSection.svelte';
import HeroSection from '../../components/blocks-page/sections/HeroSection.svelte';
import PricingSection from '../../components/blocks-page/sections/PricingSection.svelte';
import { blockSource } from '../../components/blocks-page/sources.ts';
import BaseLayout from '../../layouts/BaseLayout.astro';

/** One page per block: the section as a full-width template. */
export function getStaticPaths() {
  return PAGE_BLOCKS.map((block) => ({ params: { id: block.id }, props: { block } }));
}

const { block } = Astro.props as { block: PageBlock };
const source = blockSource(block.file);
---

<BaseLayout title={`${block.title} template`} description={block.description}>
  <nav class="crumbs" aria-label="Breadcrumb">
    <a href="/blocks-page/">Blocks and templates</a>
    <span aria-hidden="true"> / </span>
    <span aria-current="page">{block.title}</span>
  </nav>
  <h1>{block.title} template</h1>
  <p class="lead">{block.description}</p>
  <BlockFrame block={block} source={source} standalone>
    {block.id === 'hero' && <HeroSection />}
    {block.id === 'features' && <FeaturesSection />}
    {block.id === 'pricing' && <PricingSection />}
    {block.id === 'faq' && <FaqSection client:visible />}
    {block.id === 'auth' && <AuthSection client:visible />}
    {block.id === 'footer' && <FooterSection />}
  </BlockFrame>
</BaseLayout>

<style>
  .crumbs {
    margin-block-end: 0.5rem;
    font-size: 0.875rem;
  }
  .crumbs a {
    color: var(--tx-link, LinkText);
  }
  h1 {
    margin-block: 0 0.25rem;
    font-size: clamp(1.75rem, 4vw, 2.25rem);
  }
  .lead {
    margin-block: 0 1rem;
    color: var(--tx-muted-foreground);
  }
</style>
