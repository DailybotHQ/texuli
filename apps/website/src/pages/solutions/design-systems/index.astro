    ctas: [
      { kind: 'primary', label: 'Open the design systems reference', href: '/design-systems/' },
    ],
  },
  demo: {
    title: 'A Ledgerline example',
    tryThis: ['Explore the static Ledgerline kit and its documented design-system APIs.'],
