---
import BuilderApp from '../../components/builder/BuilderApp.svelte';
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Blueprint builder"
  description="Compose an untrusted Texuli blueprint from catalog manifests, inspect it, and edit its JSON payload."
>
  <div class="builder-page" data-tx-builder-page>
    <header class="builder-page__header">
      <p class="eyebrow">Agent tools</p>
      <h1>Blueprint builder</h1>
      <p class="lead">
        Compose a draft from the player-supported catalog, edit its manifest-defined properties, and
        keep the JSON payload in sync. Drafts stay untrusted and are never activated here.
      </p>
    </header>
    <BuilderApp client:load />
  </div>
</BaseLayout>

<style>
  .builder-page { display: grid; gap: 1.5rem; }
  .builder-page__header { display: grid; gap: .4rem; }
  .eyebrow { margin: 0; font-size: .75rem; font-weight: 600; letter-spacing: .04em; text-transform: uppercase; color: var(--tx-foreground); }
  h1 { margin: 0; font-size: clamp(1.75rem, 4vw, 2.25rem); color: var(--tx-foreground); }
  .lead { margin: 0; max-inline-size: 48rem; color: var(--tx-foreground); }
</style>
