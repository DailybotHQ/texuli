---
import ShowcaseChrome from '../../../components/showcase/ShowcaseChrome.svelte';
import SlideDeckScreen from '../../../components/showcase/screens/SlideDeckScreen.svelte';
import BaseLayout from '../../../layouts/BaseLayout.astro';
---

<BaseLayout title="Slide deck" description="Presentation slides for a product walkthrough.">
  <ShowcaseChrome title="Slide deck" description="Presentation slides for a product walkthrough.">
    <SlideDeckScreen client:load />
    <p class="slides-link">
      This screen is a mock-up built from Texuli components. For the real deck stage, with reveal
      steps, slot masters, a presenter view and fullscreen, see
      <a href={`${import.meta.env.BASE_URL.replace(/\/+$/, '')}/slides-page/`}>Slides</a>.
    </p>
  </ShowcaseChrome>
</BaseLayout>
