---
/**
 * /theme-studio/ — the Design System Studio (PLAN_011 T-ds-studio): start,
 * edit, preview, check, diff, export and share a design-system document,
 * all in the browser. The URL is the theme studio's, so every existing link
 * (and every `#theme=` share link) keeps working.
 */
import DesignSystemStudio from '../../components/theme-studio/DesignSystemStudio.svelte';
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Design system studio"
  description="Build a Texuli design system from a seed color, a logo, a library theme or a token file: edit, preview five surfaces, check contrast, export and share."
>
  <div class="page" data-tx-theme-studio-page="">
    <header class="page__header">
      <p class="eyebrow">@texuli/tokens design systems · new in 0.10.0</p>
      <h1>Design system studio</h1>
      <p class="lead">
        Describe a brand once, as data. Start from a seed color, a logo, a library theme, mood
        words, or a DTCG, Tokens Studio or design-system file; edit identity, color, type, space,
        shape, elevation, motion, layout, components, accessibility targets and variants; watch a
        component sheet, a dashboard, a slide, a document and an email follow; read the contrast
        report and the diff; export JSON, CSS, a Tailwind preset, DTCG, Tokens Studio, a report or
        a sample email; share the whole document in a link. Nothing leaves this origin.
      </p>
      <p class="note">
        Design-system documents, their compiler and these exports shipped in 0.10.0 and are on npm in
        the 0.12 line (pre-1.0); earlier lines have the theme engine and the token contract they build
        on.
      </p>
    </header>
    <DesignSystemStudio base={import.meta.env.BASE_URL} client:load />
  </div>
</BaseLayout>

<style>
  .page {
    display: grid;
    gap: 1.5rem;
  }
  .eyebrow {
    margin: 0 0 0.35rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--tx-foreground);
  }
  h1 {
    margin: 0;
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    color: var(--tx-foreground);
  }
  .lead,
  .note {
    margin: 0.5rem 0 0;
    max-inline-size: 48rem;
    color: var(--tx-foreground);
  }
  .lead {
    font-size: 1.0625rem;
  }
  .note {
    font-size: 0.9375rem;
  }
</style>
