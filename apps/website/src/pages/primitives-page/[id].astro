---
import { SITE_THEME } from '../../components/foundation/site.ts';
/**
 * /primitives-page/<id>/ — one primitive: a live demo (lazy island), anatomy
 * diagram, import line, pattern, size budget and behavior checks.
 */
import AnatomyDiagram from '../../components/primitives-page/AnatomyDiagram.astro';
import BehaviorChecks from '../../components/primitives-page/BehaviorChecks.astro';
import LiveDemo from '../../components/primitives-page/live/LiveDemo.svelte';
import {
  importLine,
  PRIMITIVES,
  type PrimitiveDoc,
} from '../../components/primitives-page/primitives.ts';
import {
  kib,
  primitiveBehavior,
  primitiveBudget,
} from '../../components/primitives-page/sources.ts';
import BaseLayout from '../../layouts/BaseLayout.astro';

export function getStaticPaths() {
  return PRIMITIVES.map((doc) => ({ params: { id: doc.id }, props: { doc } }));
}

const { doc } = Astro.props as { doc: PrimitiveDoc };
const behavior = primitiveBehavior(doc.id);
const budget = primitiveBudget(doc.id);
---

<BaseLayout title={`${doc.name} primitive`} description={doc.summary}>
  <h1>{doc.name}</h1>
  <p class="lead">{doc.summary}</p>

  <dl class="facts">
    <dt>Import</dt>
    <dd><code data-import>{importLine(doc)}</code></dd>
    <dt>Pattern</dt>
    <dd>
      {doc.pattern.href ? <a href={doc.pattern.href}>{doc.pattern.name} (WAI-ARIA APG)</a> : doc.pattern.name}
    </dd>
    <dt>Size budget</dt>
    <dd data-budget>
      {budget === undefined ? 'No budget entry' : `${kib(budget)} gzip for @texuli/primitives/${doc.id}`}
    </dd>
    <dt>Reference</dt>
    <dd><code>packages/<wbr />primitives/<wbr />docs/<wbr />prim-{doc.id}.md</code></dd>
  </dl>

  <div class="block">
    <LiveDemo client:visible id={doc.id} name={doc.name} theme={SITE_THEME} />
  </div>

  <section class="block" aria-labelledby="anatomy-title">
    <h2 id="anatomy-title">Anatomy</h2>
    <AnatomyDiagram doc={doc} />
    {doc.notes?.map((note) => <p class="note" set:text={note.replaceAll('`', '')} />)}
  </section>

  <div class="block">
    <BehaviorChecks evidence={behavior} name={doc.name} />
  </div>
</BaseLayout>

<style>
  h1 {
    margin-block: 0 0.25rem;
    font-size: clamp(1.75rem, 4vw, 2.25rem);
  }
  .lead {
    margin-block: 0 1rem;
    max-inline-size: 46rem;
  }
  .facts {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.375rem 1rem;
    margin: 0 0 1.5rem;
  }
  .facts dt {
    color: var(--tx-muted-foreground);
  }
  .facts dd {
    margin: 0;
    min-inline-size: 0;
    /* Long paths break at their slashes (<wbr>), not mid-word. */
    overflow-wrap: break-word;
  }
  .facts a {
    color: var(--tx-link, LinkText);
  }
  .block {
    display: grid;
    gap: 0.75rem;
    margin-block-end: 2rem;
  }
  h2 {
    margin: 0;
    font-size: 1.35rem;
  }
  .note {
    margin: 0;
    color: var(--tx-muted-foreground);
  }
</style>
