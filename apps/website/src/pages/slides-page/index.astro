---
/**
 * /slides-page/: @texuli/slides on the @texuli/deck engine. A flagship deck
 * on the v2 stage (hash routes, fullscreen, presenter, blackout, laser,
 * help, overview, print and PPTX), JSON and Markdown live editors, layout
 * and background galleries and components on slides. Every island mounts
 * when it scrolls into view; everything else is static HTML.
 */
import PageBanner from '../../components/landing/PageBanner.astro';
import BackgroundsGallery from '../../components/slides-site/BackgroundsGallery.svelte';
import ComponentsShowcase from '../../components/slides-site/ComponentsShowcase.svelte';
import DeckEditorApp from '../../components/slides-site/editor/DeckEditorApp.svelte';
import FlagshipDeck from '../../components/slides-site/FlagshipDeck.svelte';
import LayoutsGallery from '../../components/slides-site/LayoutsGallery.svelte';
import {
  SLIDES_KEYS,
  SLIDES_PIECES,
  SLIDES_SECTIONS,
  SLIDES_STATUS,
} from '../../components/slides-site/page.ts';
import BaseLayout from '../../layouts/BaseLayout.astro';

const section = (id: string) => {
  const entry = SLIDES_SECTIONS.find((candidate) => candidate.id === id);
  if (!entry) throw new Error(`Unknown slides section ${id}`);
  return entry;
};
---

<BaseLayout
  title="Slides"
  description="@texuli/slides on the @texuli/deck engine (in development): decks from JSON or Markdown, 21 layouts, any Texuli component on a slide, presenter, print and PPTX."
>
  <div class="slides-page" data-tx-slides-page="">
    <header class="slides-page__hero">
      <PageBanner art="page-slides" />
      <p class="eyebrow">@texuli/slides · in development</p>
      <h1>Decks from JSON or Markdown, on one stage</h1>
      <p class="lead">
        One validated deck model, written by people or agents, presented on a keyboard-complete
        stage with a presenter view, steps, transitions and exports. Every slide can hold a Texuli
        component, and nothing a deck says can run code or reach another site. {SLIDES_STATUS}
      </p>
      <ol class="pieces" aria-label="The pieces">
        {
          SLIDES_PIECES.map((piece) => (
            <li class="pieces__item">
              <code>{piece.name}</code>
              <span>{piece.role}</span>
            </li>
          ))
        }
      </ol>
    </header>

    <nav class="toc" aria-label="On this page">
      <ul>
        {
          SLIDES_SECTIONS.map((entry) => (
            <li>
              <a href={`#${entry.id}`}>{entry.title}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <section class="demo" id="deck" aria-labelledby="deck-title">
      <h2 id="deck-title">{section('deck').title}</h2>
      <p>{section('deck').summary}</p>
      <ul class="keys" aria-label="Keyboard">
        {
          SLIDES_KEYS.map((entry) => (
            <li>
              {entry.keys.map((key, index) => (
                <>
                  {index > 0 ? ' or ' : ''}
                  <kbd>{key}</kbd>
                </>
              ))}
              : {entry.action}
            </li>
          ))
        }
      </ul>
      <FlagshipDeck client:visible />
    </section>

    <section class="demo" id="editor" aria-labelledby="editor-title">
      <h2 id="editor-title">{section('editor').title}</h2>
      <p>{section('editor').summary}</p>
      <DeckEditorApp client:visible />
    </section>

    <section class="demo" id="layouts" aria-labelledby="layouts-title">
      <h2 id="layouts-title">{section('layouts').title}</h2>
      <p>{section('layouts').summary}</p>
      <LayoutsGallery client:visible />
    </section>

    <section class="demo" id="backgrounds" aria-labelledby="backgrounds-title">
      <h2 id="backgrounds-title">{section('backgrounds').title}</h2>
      <p>{section('backgrounds').summary}</p>
      <BackgroundsGallery client:visible />
    </section>

    <section class="demo" id="components" aria-labelledby="components-title">
      <h2 id="components-title">{section('components').title}</h2>
      <p>{section('components').summary}</p>
      <ComponentsShowcase client:visible />
    </section>

    <section class="demo demo--aside" id="export" aria-labelledby="export-title">
      <h2 id="export-title">{section('export').title}</h2>
      <p>{section('export').summary}</p>
      <p>
        <a href="#deck">Go to the flagship deck and its export bar</a>. The PPTX writer has no
        dependencies; images, tables and chart snapshots it cannot write are listed in the file's
        notes instead of being dropped silently.
      </p>
    </section>
  </div>
</BaseLayout>

<style>
  .slides-page {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem;
  }
  .slides-page__hero {
    display: grid;
    gap: 0.75rem;
  }
  .eyebrow {
    margin: 0;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--tx-foreground);
  }
  h1 {
    margin: 0;
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    line-height: 1.1;
    color: var(--tx-foreground);
  }
  .lead {
    margin: 0;
    max-inline-size: 46rem;
    font-size: 1.0625rem;
    color: var(--tx-foreground);
  }
  .pieces {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .pieces__item {
    display: grid;
    gap: 0.1rem;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--tx-border, CanvasText);
    border-radius: 0.75rem;
    background: var(--tx-surface, Canvas);
    font-size: 0.8125rem;
  }
  .pieces__item code {
    font-weight: 600;
  }
  .pieces__item span {
    color: var(--tx-muted-foreground, CanvasText);
  }
  .toc ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .toc a,
  .demo a {
    color: var(--tx-link, LinkText);
  }
  .demo {
    display: grid;
    gap: 0.75rem;
    min-inline-size: 0;
    scroll-margin-block-start: 5rem;
  }
  .demo h2 {
    margin: 0;
    font-size: clamp(1.25rem, 2.5vw, 1.5rem);
  }
  .demo > p {
    margin: 0;
    max-inline-size: 46rem;
  }
  .keys {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.875rem;
  }
  .demo--aside {
    padding: 1rem;
    border: 1px dashed var(--tx-border, CanvasText);
    border-radius: 1rem;
  }
</style>
