---
/**
 * /native/ — Texuli Native, "Beyond the browser". The page keeps its URL and assembles the
 * twelve moments of the native story from the sections in `components/sections/native/`:
 *
 *   01 hero and platform status         NativeHero
 *   02 one blueprint, many renderers    BlueprintDiagram (a real golden fixture)
 *   03 web and native side by side      NativeDemo (the only island, client:visible)
 *   04 why share a foundation           WhyKmp (kept from the first /native/)
 *   05 how the renderer consumes it     WhyKmp, "How the renderer consumes the contract"
 *   06 components that travel           ComponentsThatTravel
 *   07 complex solutions, shared intent ComplexSolutionsTravel
 *   09 honest compatibility matrix      NativeMatrixSummary (platform rows, per-group counts) and
 *                                       a link to /native/compatibility/ (the full generated matrix)
 *   11 what exists and what is planned  NativeEvidenceRoadmap (kept from the first /native/)
 *      questions                        NativeFaq
 *   08 native should feel native,
 *   10 humans and agents on every target,
 *   12 start building                   NativePrinciples (one section, three parts)
 *
 * The page-native banner is not shown: with the matrix moved and the demo CSS trimmed, the
 * page still measured over its 122 KB cap with it (decisions/native-budget.md, step 3).
 *
 * Every status and count is derived (compatibility data, parity.json, registry), never typed
 * here. JSON-LD stays Organization-only: nothing native is installable yet.
 */
import BlueprintDiagram from '../../components/sections/native/blueprint/BlueprintDiagram.astro';
import NativeDemo from '../../components/sections/native/demo/NativeDemo.astro';
import NativeFaq from '../../components/sections/native/faq/NativeFaq.astro';
import NativeHero from '../../components/sections/native/hero/NativeHero.astro';
import NativeMatrixSummary from '../../components/sections/native/matrix/NativeMatrixSummary.astro';
import NativeEvidenceRoadmap from '../../components/sections/native/NativeEvidenceRoadmap.astro';
import NativePrinciples from '../../components/sections/native/principles/NativePrinciples.astro';
import ComplexSolutionsTravel from '../../components/sections/native/travel/ComplexSolutionsTravel.astro';
import ComponentsThatTravel from '../../components/sections/native/travel/ComponentsThatTravel.astro';
import WhyKmp from '../../components/sections/native/WhyKmp.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Texuli Native — your interface language, beyond the browser"
  description="One blueprint contract for web and native. The web is available today; the Compose renderer is in development and paints a read-only slice; Android and iOS are planned."
  landing
>
  <div class="landing native-page" data-tx-landing="" data-tx-native-page="">
    <NativeHero />
    <BlueprintDiagram />
    <NativeDemo />
    <WhyKmp />
    <ComponentsThatTravel />
    <ComplexSolutionsTravel />
    <NativeMatrixSummary />
    <NativeEvidenceRoadmap />
    <NativeFaq />
    <NativePrinciples />
  </div>
</BaseLayout>

