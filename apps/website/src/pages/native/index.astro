---
/**
 * /native/ — the native-focused landing (sub-site IA decision 2, owned by
 * analysis_results/subsite-ia-routes.md). Landing shell, not a fenced
 * sub-site: it shares the shell system, theme, CSP and analytics of the one
 * site. G7 (T-45..T-48) fills the marked section slots with composable
 * components; this scaffold carries only real, honest status copy — no
 * lorem, no fake screenshots, no "coming soon" fluff.
 *
 * Metadata per the T-17 contract (analysis_results/subsite-ia-nav.md §3):
 * JSON-LD is Organization-only — nothing installable exists yet, so a
 * SoftwareApplication node would be dishonest. Canonical and the OG set are
 * emitted by SeoHead; the sitemap picks the route up via the build pipeline.
 *
 * Shell note: T-32 owns the nav/header wiring (the platform group and the
 * landing-variant links); until it lands, the page renders the standard
 * non-landing header over the landing main.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';

const organizationJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      name: 'Dailybot, Inc.',
      url: 'https://dailybot.com/',
    },
  ],
};
---

<BaseLayout
  title="Texuli native — the same catalog, rendered by Compose"
  description="The Texuli contract renders native surfaces with Compose through Kotlin Multiplatform. In development, conformance-tested, and open about its status."
  landing
  jsonLd={organizationJsonLd}
>
  <div class="landing" data-tx-landing="">
    <section class="native-hero" data-tx-native-slot="hero">
      <p class="native-hero__eyebrow">Native</p>
      <h1>Texuli native — the same catalog, rendered by Compose</h1>
      <p class="native-hero__lead">
        One component contract, two runtimes. The web runtime ships today with Svelte 5; the
        native renderer drives Compose through Kotlin Multiplatform and is in development —
        conformance-tested against the same behavior suite, not yet published.
      </p>
      <p>
        <a href="/web-and-native/">Why web and native, one contract</a>
      </p>
    </section>
    <!-- T-46: the runtime story — how the KMP renderer consumes the contract. -->
    <!-- T-47: the spec-contract mechanism — one manifest, TS + Kotlin projections. -->
    <!-- T-48: honest status, roadmap granularity and the final section wiring. -->
  </div>
</BaseLayout>

<style>
  .native-hero {
    display: grid;
    gap: 1rem;
    padding-block: clamp(2rem, 6vw, 4rem);
  }
  .native-hero__eyebrow {
    margin: 0;
  }
  .native-hero__lead {
    max-inline-size: 44rem;
  }
</style>
