---
/**
 * /component-pages/<id>/ — one page per catalog manifest id (static paths).
 */
import ComponentPageBody from '../../components/component-pages/ComponentPageBody.astro';
import { familyNote } from '../../components/component-pages/family-notes.ts';
import {
  COMPONENT_PAGES,
  getComponentPage,
} from '../../components/component-pages/load-manifests.ts';
import { metaDescription } from '../../components/seo/seo.ts';
import BaseLayout from '../../layouts/BaseLayout.astro';

export function getStaticPaths() {
  return COMPONENT_PAGES.map((entry) => ({
    params: { id: entry.id },
  }));
}

const { id } = Astro.params;
if (!id) throw new Error('Missing component id');
const entry = getComponentPage(id);
if (!entry) throw new Error(`Unknown component page id: ${id}`);
// The share card reads this: one-line summary plus the family differentiator
// (punch-list rows 1 and 3 — the per-component art itself is routed to the
// SEO surface).
const note = familyNote(entry.group, entry.id);
const description = metaDescription(
  `${entry.summary}${note ? ` ${note.headline}` : ''}`,
  `Catalog id ${entry.id}.`
);
---

<BaseLayout title={entry.label} description={description}>
  <p class="crumb">
    <a href="/component-pages/">Components</a>
    <span aria-hidden="true"> / </span>
    <span>{entry.label}</span>
  </p>
  <ComponentPageBody entry={entry} />
</BaseLayout>

<style>
  .crumb {
    margin: 0 0 1rem;
    font-size: 0.875rem;
    color: var(--tx-muted-foreground);
  }
  .crumb a {
    color: inherit;
  }
</style>
