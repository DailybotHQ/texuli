---
/**
 * /component-pages/ — index of every catalog component page (static).
 */
import { Badge } from 'texuli/badge';
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from 'texuli/card';
import { familyNote } from '../../components/component-pages/family-notes.ts';
import {
  COMPONENT_PAGES,
  componentPagePath,
  componentPagesByGroup,
} from '../../components/component-pages/load-manifests.ts';
import PageBanner from '../../components/landing/PageBanner.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

const byGroup = componentPagesByGroup();
const groups = [...byGroup.keys()].sort((a, b) => a.localeCompare(b, 'en'));
---

<BaseLayout
  title="Components"
  description="One static page per catalog component: examples, props, keyboard, accessibility and guidance — generated from manifests."
>
  <PageBanner art="page-components" />
  <h1>Components</h1>
  <p class="lead">
    {COMPONENT_PAGES.length} pages generated from the closed catalog. No runtime network; plain
    text from manifests only.
  </p>

  {
    groups.map((group) => (
      <section class="group" aria-labelledby={`g-${group}`}>
        <h2 id={`g-${group}`}>
          {group} <Badge variant="secondary">{byGroup.get(group)!.length}</Badge>
        </h2>
        {familyNote(group) && <p class="family-note">{familyNote(group)?.headline}</p>}
        <ul class="grid">
          {byGroup.get(group)!.map((entry) => (
            <li>
              <a class="tile" href={componentPagePath(entry.id)}>
                <Card variant="flat">
                  <CardHeader>
                    <CardTitle level={3}>{entry.label}</CardTitle>
                    <CardDescription>
                      <code>{entry.id}</code>
                    </CardDescription>
                  </CardHeader>
                  <CardContent>
                    <p>{entry.summary}</p>
                  </CardContent>
                </Card>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</BaseLayout>

<style>
  h1 {
    margin-block: 0 0.25rem;
    font-size: clamp(2rem, 6vw, 3rem);
    line-height: 1.15;
  }
  .lead {
    margin-block: 0 2rem;
    color: var(--tx-muted-foreground);
    font-size: 1.1rem;
    max-inline-size: 40rem;
  }
  .group {
    margin-block-end: 2rem;
  }
  .group h2 {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 0.75rem;
    font-size: 1.25rem;
    text-transform: capitalize;
  }
  .family-note {
    margin: -0.35rem 0 0.75rem;
    color: var(--tx-muted-foreground);
    font-size: 0.95rem;
  }
  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
    grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
  }
  .tile {
    display: block;
    text-decoration: none;
    color: inherit;
    border-radius: var(--tx-radius, 0.5rem);
  }
  .tile:focus-visible {
    outline: 2px solid var(--tx-ring);
    outline-offset: 2px;
  }
  p {
    margin: 0;
    font-size: 0.9rem;
  }
</style>
