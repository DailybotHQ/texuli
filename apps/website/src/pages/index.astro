---
import HomeFinal from '../components/sections/home/HomeFinal.astro';
import HomeHero from '../components/sections/home/HomeHero.astro';
import HomePitch from '../components/sections/home/HomePitch.astro';
import HomeProof from '../components/sections/home/HomeProof.astro';
import HomeQuickstart from '../components/sections/home/HomeQuickstart.astro';
import HomeStories from '../components/sections/home/HomeStories.astro';
import '../components/sections/home/home.css';
/**
 * texuli.com home (PLAN_012): the illustrated landing in ten bands, in the
 * order of the plan's landing IA: hero, pitch, five story bands (Universal,
 * Web + native, Your brand, For agents, Accessible), a computed proof band,
 * the quickstart and the final call to action. Copy lives in
 * `components/sections/home/home-content.ts`; illustration slots in
 * `data/illustrations.json` (docs/ILLUSTRATIONS.md). JSON-LD per the
 * T-site-ia contract, unchanged. The bands below the hero rise in on scroll
 * (PLAN_006 T-79 row 13): CSS only, behind
 * `prefers-reduced-motion: no-preference` and a scroll-timeline support
 * check, translate only so contrast and visibility never depend on it.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { libraryJsonLd } from '../lib/schema';

const HOME_TITLE = 'One component catalog for web and native';
const HOME_DESCRIPTION =
  'Interfaces from texels: one owned, accessible component catalog. Svelte 5 for the web ' +
  'today, a Kotlin Multiplatform renderer in development, safe for agents.';
---

<BaseLayout
  title={HOME_TITLE}
  description={HOME_DESCRIPTION}
  landing
  jsonLd={libraryJsonLd()}
>
  <div class="landing" data-tx-landing="">
    <HomeHero />
    <HomePitch />
    <HomeStories />
    <HomeProof />
    <HomeQuickstart />
    <HomeFinal />
  </div>
</BaseLayout>

<style>
  /* Each section carries its own block padding: they stack as full-width
     bands, no extra gap. */
  .landing {
    display: grid;
    gap: 0;
  }
  /* Scroll reveal (row 13): each band after the hero rises 1.5rem as it
     enters the viewport. Opt-in motion only, and transform only — no
     opacity — so nothing is ever hidden or low-contrast, with or without
     support. */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .landing > :global(section + section) {
        /* Longhands on purpose: the build minifier folds a full
           `animation` shorthand plus `animation-timeline` into one
           shorthand Chromium rejects; without duration it cannot merge. */
        animation-name: landing-rise;
        animation-timing-function: var(--site-motion-linked-easing);
        animation-fill-mode: both;
        animation-timeline: view();
        animation-range: entry 0% entry 60%;
      }
    }
  }
  @keyframes landing-rise {
    from {
      translate: 0 1.5rem;
    }
    to {
      translate: 0 0;
    }
  }
</style>
