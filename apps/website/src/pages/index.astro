---
import HomeAgents22 from '../components/sections/home/agents-22/HomeAgents22.astro';
import HomeBuiltWith from '../components/sections/home/built-with/HomeBuiltWith.astro';
import HomeFinal22 from '../components/sections/home/final-22/HomeFinal22.astro';
import HomePitch from '../components/sections/home/HomePitch.astro';
import HomeStories from '../components/sections/home/HomeStories.astro';
import HomeHero22 from '../components/sections/home/hero-22/HomeHero22.astro';
import { HOME_OWN, HOME_PROOF, loadHomeProof } from '../components/sections/home/home-content.ts';
import LandingStory from '../components/sections/home/LandingStory.astro';
import HomeSolutions from '../components/sections/home/solutions/HomeSolutions.astro';
import HomeWebNative from '../components/sections/home/web-native/HomeWebNative.astro';
import '../components/sections/home/home.css';
import { safeHref } from '@texuli/core/url-policy';
import { withBase } from '../components/foundation/site.ts';
/**
 * texuli.com home (Home 2.2): nine static bands carrying the ten storyboard messages, in
 * the order of `HOME_BANDS` (components/sections/home/home-content.ts): hero, small pieces,
 * Web & Native (first half), complete Solutions, humans and agents, design systems, built
 * with Texuli, accessible and owned (with the computed proof row), and the two-path close.
 * No client island (ADR-030). Copy lives beside each section; the kept bands read
 * home-content.ts. JSON-LD per the T-site-ia contract, unchanged. The bands below the hero
 * rise in on scroll: CSS only, behind `prefers-reduced-motion: no-preference` and a
 * scroll-timeline support check, translate only so contrast and visibility never depend
 * on it.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { libraryJsonLd } from '../lib/schema';

const HOME_TITLE = 'Build any interface, for web and native';
const HOME_DESCRIPTION =
  'One owned, accessible Svelte 5 component library to build any interface, safe for ' +
  'agents, with a Kotlin Multiplatform renderer in development.';

const base = import.meta.env.BASE_URL;
const proof = await loadHomeProof();
const resolveHref = (href: string): string | undefined => {
  const safe = safeHref(href, 'developer');
  return safe === undefined ? undefined : withBase(base, safe);
};
---

<BaseLayout
  title={HOME_TITLE}
  description={HOME_DESCRIPTION}
  landing
  jsonLd={libraryJsonLd()}
>
  <div class="landing" data-tx-landing="">
    <HomeHero22 />
    <HomePitch />
    <HomeWebNative />
    <HomeSolutions />
    <HomeAgents22 />
    <HomeStories />
    <HomeBuiltWith />
    <LandingStory story={HOME_OWN} index={2} side="start">
      <ul class="home-own-proof" role="list" aria-label={HOME_PROOF.label}>
        {
          proof.map((stat) => (
            <li data-tx-proof={stat.id}>
              <a href={resolveHref(stat.href)}>
                <span class="home-own-proof__value">{stat.value}</span>
                <span class="home-own-proof__label">{stat.label}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </LandingStory>
    <HomeFinal22 />
  </div>
</BaseLayout>

<style>
  /* Each section carries its own block padding: they stack as full-width
     bands, no extra gap. */
  .landing {
    display: grid;
    gap: 0;
  }
  /* Scroll reveal (row 13): each band after the hero rises 1.5rem as it
     enters the viewport. Opt-in motion only, and transform only — no
     opacity — so nothing is ever hidden or low-contrast, with or without
     support. */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .landing > :global(section + section) {
        /* Longhands on purpose: the build minifier folds a full
           `animation` shorthand plus `animation-timeline` into one
           shorthand Chromium rejects; without duration it cannot merge. */
        animation-name: landing-rise;
        animation-timing-function: var(--site-motion-linked-easing);
        animation-fill-mode: both;
        animation-timeline: view();
        animation-range: entry 0% entry 60%;
      }
    }
  }
  @keyframes landing-rise {
    from {
      translate: 0 1.5rem;
    }
    to {
      translate: 0 0;
    }
  }
</style>
