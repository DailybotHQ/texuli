---
import WebAgentsCta from '../components/sections/web/WebAgentsCta.astro';
import WebCorrelation from '../components/sections/web/WebCorrelation.astro';
import WebHero from '../components/sections/web/WebHero.astro';
import WebWhySvelte from '../components/sections/web/WebWhySvelte.astro';
/**
 * texuli.com home (PLAN_006 T-44): the unified landing assembled from the
 * four blueprint sections in order — hero, why Svelte for the web, the
 * correlation demo, agents + closing CTA (narrative blueprint §5 s1..s4).
 * The retired minimal-landing sections (LandingHero, FeatureCards,
 * AgentsSection and their islands) are deleted with this integration.
 * Metadata and JSON-LD per the T-site-ia contract, unchanged.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { libraryJsonLd } from '../lib/schema';
---

<BaseLayout
  title="Texuli"
  description="Interfaces from texels. Owned, accessible Svelte 5 components that people and agents can build anything with."
  landing
  jsonLd={libraryJsonLd()}
>
  <div class="landing" data-tx-landing="">
    <WebHero />
    <WebWhySvelte />
    <WebCorrelation />
    <WebAgentsCta />
  </div>
</BaseLayout>

<style>
  /* Each section carries its own block padding: they stack as full-width
     bands, no extra gap. */
  .landing {
    display: grid;
    gap: 0;
  }
</style>
