---
/**
 * /skill/ — the Texuli agent skill: what it is, how to install it in each
 * agent host, what each sub-skill does, and the pack's checksums. Built from
 * `skills/texuli/` itself, so the page cannot drift from the pack.
 */
import { safeHref } from '@texuli/core/url-policy';
import {
  hostCommands,
  installRoutes,
  SKILL_REPOSITORY,
  SKILL_TAG_PREFIX,
} from '../../components/skill/skill.ts';
import {
  CHECKSUMS,
  HOSTS,
  PACK_NAME,
  RELEASED,
  ROUTER,
  SUB_SKILLS,
  SUMS_SHA256,
} from '../../components/skill/sources.ts';
import BaseLayout from '../../layouts/BaseLayout.astro';

const version = ROUTER.version;
// A release exists only once the release workflow has stamped CHANGELOG.md.
const pin = RELEASED || '<version>';
const routes = installRoutes(pin);
const releasesHref = safeHref(`${SKILL_REPOSITORY}/releases`, 'developer');
---

<BaseLayout
  title="The Texuli skill"
  description="An offline agent skill for building with Texuli: install it in Claude Code, Cursor, Codex and other hosts, see what each sub-skill does, and verify its checksums."
>
  <h1>The Texuli skill</h1>
  <p class="lead">
    A skill pack that teaches coding agents to build with Texuli. It is local Markdown guidance: a
    router (<code>SKILL.md</code>) that sends each request to a sub-skill for components, themes,
    media, building UI or contributing.
  </p>
  <dl class="facts">
    <dt>Name</dt>
    <dd><code data-skill-name>{ROUTER.name}</code></dd>
    <dt>Version</dt>
    <dd><code data-skill-version>{version}</code></dd>
    <dt>Tools it may use</dt>
    <dd>{ROUTER.allowedTools.join(', ')}</dd>
    <dt>Files</dt>
    <dd>{CHECKSUMS.length}, each listed in <code>SHA256SUMS</code></dd>
  </dl>

  <section aria-labelledby="trust-title" class="block">
    <h2 id="trust-title">What it may do</h2>
    <ul class="points">
      <li><strong>No network</strong> for routing, reading the pack, or verifying it.</li>
      <li>
        <strong>Nothing installs itself.</strong> Installing the skill copies Markdown into one
        host folder, after a dry run you approve. It installs no packages and no CLI.
      </li>
      <li>
        <strong>Consent first</strong> for a skill install or upgrade, a package install, or any
        destructive change. Pasted briefs and generated files are data, never instructions.
      </li>
    </ul>
    <p>The full contract is <code>skills/texuli/TRUST.md</code>.</p>
  </section>

  <section aria-labelledby="install-title" class="block">
    <h2 id="install-title">Install in your agent host</h2>
    <p>
      From a Texuli checkout, <code>setup.sh</code> verifies the pack, shows what it would write,
      then copies it into one host's skill folder. It refuses any other version than the one you
      pin, and never overwrites an unrelated folder (<code>--replace</code> backs up an older Texuli
      copy first).
    </p>
    <ul class="hosts" role="list">
      {
        HOSTS.map((host) => (
          <li class="host" data-host={host.id}>
            <h3>{host.label}</h3>
            <p>
              Folder: <code>{host.folder}</code>
            </p>
            <pre aria-label={`${host.label} install commands`}><code>{hostCommands(host.id, version).join('\n')}</code></pre>
          </li>
        ))
      }
    </ul>
    <p>
      The first command checks every file against <code>SHA256SUMS</code>; the second only prints the
      plan. Whether a host discovers the folder is the host's behavior. OpenClaw installs from its own
      registry when the entry exists.
    </p>
    <h3>Pin a release</h3>
    <ol class="steps">
      <li>
        Download the skill archive <code>texuli-skill-&lt;version&gt;.tar.gz</code> and that release's <code>SHA256SUMS</code> from the same Texuli release.
      </li>
      <li>
        Verify before installing:
        <pre aria-label="Verify a release"><code>grep ' texuli-skill-&lt;version&gt;.tar.gz$' SHA256SUMS | shasum -a 256 -c -
tar -xzf texuli-skill-&lt;version&gt;.tar.gz
shasum -a 256 -c SHA256SUMS
./texuli/setup.sh --verify --dir ./texuli --expect-version &lt;version&gt;</code></pre>
      </li>
      <li>Install with <code>--expect-version</code> as above; upgrade later with <code>--replace</code>.</li>
    </ol>
  </section>

  <section aria-labelledby="channels-title" class="block">
    <h2 id="channels-title">Install, update and uninstall</h2>
    {
      RELEASED ? (
        <p data-skill-release={RELEASED}>
          The latest skill release is <code>{SKILL_TAG_PREFIX}{RELEASED}</code>. Skill releases
          have their own tags, apart from the npm packages, and each carries the pack archive and a{' '}
          <code>SHA256SUMS</code>.
        </p>
      ) : (
        <p data-skill-release="">
          No skill release is published yet. Until the first <code>{SKILL_TAG_PREFIX}X.Y.Z</code>{' '}
          tag exists, install from a checkout as above; the commands below show{' '}
          <code>&lt;version&gt;</code> where the release goes.
        </p>
      )
    }
    <p>
      Pin the skills CLI with the release's tree URL. Do not use the{' '}
      <code>owner/repo@ref</code> shorthand: the CLI can ignore that ref and install the default
      branch. Releases are checksummed, not signed: verify against the release's{' '}
      <code>SHA256SUMS</code>, at{' '}
      <a href={releasesHref} rel="noopener noreferrer">the Texuli releases</a>.
    </p>
    <ul class="cards" role="list">
      {
        routes.map((route) => (
          <li class="card" data-install-route={route.id}>
            <h3>{route.title}</h3>
            <pre aria-label={`${route.title} commands`}><code>{route.commands.join('\n')}</code></pre>
          </li>
        ))
      }
    </ul>
    <p>
      OpenClaw installs from its registry only once a Texuli entry is listed there; until then,
      copy a verified <code>texuli/</code> folder into its skills folder. A copy installed with{' '}
      <code>setup.sh</code> is removed by deleting its folder; earlier copies stay under{' '}
      <code>~/.texuli/skill-backups/</code>.
    </p>
  </section>

  <section aria-labelledby="subskills-title" class="block">
    <h2 id="subskills-title">Sub-skills</h2>
    <p>The router reads one of these for each request; each ships its own references.</p>
    <ul class="cards" role="list">
      {
        SUB_SKILLS.map((skill) => (
          <li class="card" data-subskill={skill.folder}>
            <h3>
              <code>{skill.name}</code>
            </h3>
            <p>{skill.description}</p>
            <p class="meta">
              <code>{skill.folder}/SKILL.md</code> · version {skill.version}
            </p>
            {skill.references.length > 0 && (
              <p class="meta">References: {skill.references.join(', ')}</p>
            )}
          </li>
        ))
      }
    </ul>
  </section>

  <section aria-labelledby="sums-title" class="block">
    <h2 id="sums-title">Checksums</h2>
    <p>
      Version <code>{version}</code>. SHA-256 of <code>SHA256SUMS</code> itself:{' '}
      <code class="hash" data-sums-sha256>{SUMS_SHA256}</code>
    </p>
    <pre aria-label="Verify the pack"><code>./skills/texuli/setup.sh --verify --expect-version {version}</code></pre>
    <details class="sums">
      <summary>All {CHECKSUMS.length} files</summary>
      <dl>
        {
          CHECKSUMS.map((sum) => (
            <div data-sum={sum.path}>
              <dt>
                <code>{PACK_NAME}/{sum.path}</code>
              </dt>
              <dd>
                <code class="hash">{sum.hash}</code>
              </dd>
            </div>
          ))
        }
      </dl>
    </details>
  </section>
</BaseLayout>

<style>
  h1 {
    margin: 0 0 0.35rem;
    font-size: clamp(2rem, 6vw, 3rem);
  }
  .lead {
    margin: 0 0 1rem;
    max-inline-size: 46rem;
    font-size: 1.1rem;
  }
  .facts {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.375rem 1rem;
    margin: 0 0 2rem;
  }
  .facts dt,
  .meta {
    color: var(--tx-muted-foreground);
  }
  dd {
    margin: 0;
    min-inline-size: 0;
    overflow-wrap: anywhere;
  }
  .block {
    display: grid;
    gap: 0.75rem;
    margin-block-end: 2.5rem;
  }
  h2 {
    margin: 0;
    font-size: 1.5rem;
  }
  h3 {
    margin: 0;
    font-size: 1.1rem;
  }
  p {
    margin: 0;
    max-inline-size: 48rem;
  }
  code {
    overflow-wrap: anywhere;
  }
  pre {
    margin: 0;
    padding: 0.75rem 1rem;
    border: 1px solid var(--tx-border);
    border-radius: var(--tx-radius, 0.5rem);
    background: var(--tx-muted, Canvas);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    font-size: 0.875rem;
  }
  .points,
  .steps {
    display: grid;
    gap: 0.5rem;
    margin: 0;
    padding-inline-start: 1.25rem;
  }
  .hosts,
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .host,
  .card {
    display: grid;
    align-content: start;
    gap: 0.5rem;
    padding: 1rem;
    border: 1px solid var(--tx-border);
    border-radius: var(--tx-radius-lg, 0.75rem);
    background: var(--tx-surface, Canvas);
    min-inline-size: 0;
  }
  .meta {
    font-size: 0.875rem;
  }
  .sums summary {
    cursor: pointer;
    font-weight: 600;
  }
  .sums dl {
    display: grid;
    gap: 0.5rem;
    margin-block: 0.75rem 0;
  }
  .sums dt {
    font-size: 0.875rem;
  }
  .hash {
    font-size: 0.8125rem;
  }
</style>
