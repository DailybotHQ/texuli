---
/**
 * The base layout every texuli.com page uses: document metadata, the
 * no-flash appearance bootstrap, the site theme compiled at build time,
 * Texuli's base stylesheet, the brand icons, a skip link, the slim header,
 * main and footer.
 *
 * - **Docs shell** (every page but the home): the header carries search, the
 *   appearance switch and the phone menu; the sidebar holds all navigation
 *   (a lazy drawer below 64rem). Docs pages also get the reading layout:
 *   prose width, "Copy page", "On this page" (80rem and up) and the pager.
 * - **Landing** (`landing`, the home): the landing header and a full-width
 *   main, with no sidebar.
 *
 * Everything is static: the theme CSS and the bootstrap script are inlined
 * at build time, so a page makes no network request it does not ship — the
 * one exception is /tx-ready.js, shared and cached across pages.
 */
/**
 * Layer order must load before Texuli base.css so `tx.*` join this stack
 * (site-base < tx.base < tx.components < site-overrides). See site-layers.css,
 * which also holds the shell's global styles.
 */
import '../styles/site-layers.css';
import '@texuli/tokens/base.css';
import { compileThemeCss } from '@texuli/tokens';
import { loadLibraryTheme } from '@texuli/tokens/library';
import { noFlashScript } from '@texuli/tokens/no-flash';
import UmamiLoader from '../components/analytics/UmamiLoader.astro';
import BrandHead from '../components/brand/BrandHead.astro';
import CopyPage from '../components/docs/CopyPage.astro';
import DocsPager from '../components/docs/DocsPager.astro';
import PageToc from '../components/docs/PageToc.astro';
import { isDocsPath, pagerFor } from '../components/foundation/nav-data.ts';
import SiteFooter from '../components/foundation/SiteFooter.astro';
import SiteHeader from '../components/foundation/SiteHeader.astro';
import SiteSidebar from '../components/foundation/SiteSidebar.astro';
import { APPEARANCE_NAMESPACE, SITE_NAME, SITE_THEME } from '../components/foundation/site.ts';
import { breadcrumbJsonLd, breadcrumbTrail } from '../components/seo/breadcrumbs';
import JsonLd from '../components/seo/JsonLd.astro';
import SeoHead from '../components/seo/SeoHead.astro';

/**
 * Explicit page-readiness signal for E2E and prefetchers, served from
 * /tx-ready.js (a cached same-origin file: per-page inline bytes would push
 * tight document budgets over). The specs detect the tag's
 * `data-tx-ready-script` marker to tell shell pages from standalone
 * documents. See public/tx-ready.js for the contract.
 */

interface Props {
  title: string;
  description: string;
  lang?: string;
  dir?: 'ltr' | 'rtl';
  /** Keep the page out of search results and the sitemap (the 404). */
  noindex?: boolean;
  /** The home landing: the landing header, a full-width main and no sidebar. */
  landing?: boolean;
  /** Structured data (schema.org), code-authored — see src/lib/schema.ts. */
  jsonLd?: Record<string, unknown>;
}

const {
  title,
  description,
  lang = 'en',
  dir = 'ltr',
  noindex = false,
  landing = false,
  jsonLd = undefined,
} = Astro.props;
const fullTitle = title === SITE_NAME ? title : `${title} · ${SITE_NAME}`;
// Both are generated by @texuli/tokens at build time (validated theme values,
// a fixed script with JSON-escaped constants), never from page data.
const themeCss = compileThemeCss(await loadLibraryTheme(SITE_THEME));
const bootstrap = noFlashScript(APPEARANCE_NAMESPACE, 'system');

const base = import.meta.env.BASE_URL;
const current = Astro.url.pathname.slice(base.replace(/\/+$/, '').length) || '/';
const docs = !landing && !noindex && isDocsPath(current);
const pager = docs ? pagerFor(current) : {};
// Nested listed pages announce their real nav hierarchy; unlisted pages get
// no trail and no markup (see components/seo/breadcrumbs.ts).
const crumbs = breadcrumbTrail(current);
// "Copy page": the title line here; the body is converted from the built page,
// between the markers below, by `copyPageIntegration` (rendering the slot twice
// here would emit the island runtime into a string that never reaches the page).
const markdownHead = docs
  ? `# ${title}\n\nSource: ${new URL(Astro.url.pathname, Astro.site ?? 'https://texuli.com').href}\n\n`
  : '';
---

<!doctype html>
<html lang={lang} dir={dir} data-tx-theme={SITE_THEME} data-tx-mode="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!--
      Cascade layer order must be the first CSS in the document. Later sheets
      (tokens base, components, site-layers) join this order. Hyphenated host
      names stay top-level so site-overrides can follow tx.components.
    -->
    <style is:inline>
      @layer site-base, tx.base, tx.components, site-overrides;
    </style>
    <script is:inline set:html={bootstrap} />
    <script>
      // Outbound documentation link events (T-38): one delegated listener,
      // idempotent, silent unless analytics is enabled. Bundled once.
      import { setupOutboundDocTracking } from '../lib/outbound-links.ts';
      setupOutboundDocTracking();
    </script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <SeoHead title={fullTitle} {description} siteName={SITE_NAME} {lang} {noindex} />
    <BrandHead />
    {jsonLd && <JsonLd data={jsonLd} />}
    {crumbs.length >= 2 && <JsonLd data={breadcrumbJsonLd(crumbs)} />}
    <style is:inline set:html={themeCss}></style>
    {/* Analytics mounts here (T-39): renders nothing unless enabled. */}
    <UmamiLoader />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    {
      landing ? (
        <>
          <SiteHeader variant="landing" />
          <main id="main" tabindex="-1" class="landing-main">
            <slot />
          </main>
          <SiteFooter />
        </>
      ) : (
        <>
          <SiteHeader />
          <div class="site-shell">
            <SiteSidebar />
            <div class="site-column">
              <div class="site-content" data-layout={docs ? 'docs' : 'wide'}>
                <main id="main" tabindex="-1">
                  {docs && <CopyPage head={markdownHead} />}
                  <Fragment set:html="<!--tx-page-body-->" />
                  <slot />
                  <Fragment set:html="<!--/tx-page-body-->" />
                  {docs && <DocsPager previous={pager.previous} next={pager.next} />}
                </main>
                {docs && <PageToc />}
              </div>
              <SiteFooter />
            </div>
          </div>
        </>
      )
    }
    <script is:inline src={`${base}tx-ready.js`} data-tx-ready-script defer />
  </body>
</html>
