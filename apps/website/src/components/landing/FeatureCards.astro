---
/**
 * Three feature pillars under the hero.
 */
import { Card, CardContent, CardHeader, CardTitle } from 'texuli/card';
import SiteIllustration from './SiteIllustration.astro';

const features = [
  {
    slot: 'feature-owned',
    title: 'Owned end to end',
    body: 'Every primitive, token and style lives in this repository—no borrowed heads, no HTML sinks.',
  },
  {
    slot: 'feature-accessible',
    title: 'Accessible by default',
    body: 'Keyboard paths, focus rings, contrast and reduced motion are built into the components, not bolted on later.',
  },
  {
    slot: 'feature-agents',
    title: 'Built for agents',
    body: 'A closed catalog, safe renderer and llms.txt let agents compose interfaces without inventing markup.',
  },
] as const;
---

<section class="features" aria-labelledby="features-title" data-tx-landing-features="">
  <header class="features__head">
    <h2 id="features-title">Why Texuli</h2>
    <p>Small pieces with strong contracts—ready for people and agents.</p>
  </header>
  <ul class="features__grid">
    {
      features.map((feature) => (
        <li>
          <Card variant="flat" class="feature">
            <SiteIllustration slot={feature.slot} class="feature__art" />
            <CardHeader>
              <CardTitle level={3}>{feature.title}</CardTitle>
            </CardHeader>
            <CardContent>
              <p>{feature.body}</p>
            </CardContent>
          </Card>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .features {
    display: grid;
    gap: 1.25rem;
    max-inline-size: 72rem;
    margin-inline: auto;
    padding-block: clamp(1.5rem, 4vw, 3rem);
    padding-inline: 1rem;
  }
  .features__head h2 {
    margin: 0 0 0.35rem;
    font-size: clamp(1.5rem, 3vw, 2rem);
    color: var(--tx-foreground);
  }
  .features__head p {
    margin: 0;
    max-inline-size: 40rem;
    color: var(--tx-muted-foreground);
  }
  .features__grid {
    display: grid;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
  }
  .features__grid :global(.feature) {
    display: grid;
    gap: 0.25rem;
    block-size: 100%;
  }
  .features__grid :global(.feature__art) {
    border-radius: calc(var(--tx-radius, 0.5rem) * 1.1);
    margin-block-end: 0.35rem;
  }
  .features__grid p {
    margin: 0;
    color: var(--tx-foreground);
  }
</style>
