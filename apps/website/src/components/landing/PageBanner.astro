---
/**
 * Section-page header art: one illustration slot above the page title.
 */
import SiteIllustration from './SiteIllustration.astro';

interface Props {
  /**
   * The illustration slot id. Named `art`, not `slot`: Astro reads a `slot`
   * attribute on a component's direct child as a named-slot target and
   * drops it when the parent has no such slot.
   */
  art: string;
}

const { art } = Astro.props;
---

<div class="page-banner" data-tx-page-banner={art}>
  <SiteIllustration {art} class="page-banner__art" />
</div>

<style>
  .page-banner {
    margin-block-end: 1.25rem;
  }
  .page-banner :global(.page-banner__art) {
    max-inline-size: 48rem;
  }
</style>
