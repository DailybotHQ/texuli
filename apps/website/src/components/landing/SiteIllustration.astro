---
import { getImage } from 'astro:assets';
/**
 * Reusable illustration slot: fixed aspect ratio, explicit width/height, lazy
 * decode, required alt. When the WebP file is missing, a CSS gradient built
 * from theme tokens fills the frame so layout never collapses.
 */
import type { ImageMetadata } from 'astro';
import { ILLUSTRATION_SIZES, illustrationFor, illustrationWidths } from './illustrations.ts';

interface Props {
  /** The illustration slot id (not `slot`, which Astro reserves; see PageBanner). */
  art: string;
  class?: string;
  /** Override alt from the manifest when the surrounding context needs a different description. */
  alt?: string;
}

const { art: slot, class: className = '', alt: altOverride } = Astro.props;
const entry = illustrationFor(slot);
if (!entry) {
  throw new Error(`Unknown illustration slot "${slot}". Add it to src/data/illustrations.json.`);
}

// Every file in src/assets/illustrations, keyed by its name. A missing file
// keeps the slot on its fallback; a present one gets build-time widths.
const files = import.meta.glob<{ default: ImageMetadata }>('../../assets/illustrations/*.webp', {
  eager: true,
});
const asset = (file: string) => files[`../../assets/illustrations/${file}`]?.default;
const sizes = ILLUSTRATION_SIZES[entry.variant];
const widths = illustrationWidths(entry);
/** The full file as `src`, plus smaller WebP widths derived at build time as `srcset`. */
async function responsive(image: ImageMetadata | undefined) {
  if (!image) return undefined;
  const smaller = widths.filter((width) => width < image.width);
  const derived = await Promise.all(
    smaller.map((width) => getImage({ src: image, width, format: 'webp', quality: 82 }))
  );
  const srcset = [
    ...derived.map((result, index) => `${result.src} ${smaller[index]}w`),
    `${image.src} ${image.width}w`,
  ].join(', ');
  return { src: image.src, srcset };
}
const light = await responsive(asset(entry.file));
const dark = light && entry.fileDark ? await responsive(asset(entry.fileDark)) : undefined;
const hasFile = light !== undefined;
const hasDark = dark !== undefined;
const eager = entry.priority === true;
const alt = altOverride ?? entry.alt;
const ratio = `${entry.width} / ${entry.height}`;

/**
 * Until the artwork exists, the slot paints a texel mosaic: Texuli's own
 * motif (small owned units composing a whole) in theme tones. The pattern is
 * seeded by the slot name, so each banner is distinct and stable.
 */
let seed = 2166136261;
for (const char of slot) seed = Math.imul(seed ^ char.charCodeAt(0), 16777619) >>> 0;
const tiles = Array.from({ length: 48 }, (_, index) => {
  seed = Math.imul(seed ^ (index + 1), 2654435761) >>> 0;
  const roll = seed % 100;
  // Mostly quiet ground, a few mid tones, rare strong texels.
  return roll < 46 ? 0 : roll < 72 ? 1 : roll < 88 ? 2 : roll < 96 ? 3 : 4;
});
---

<figure
  class:list={[
    'site-illustration',
    `site-illustration--${entry.variant}`,
    className,
    { 'site-illustration--fallback': !hasFile, 'site-illustration--has-dark': hasDark },
  ]}
  data-tx-illustration={slot}
  data-tx-illustration-variant={entry.variant}
  data-tx-illustration-ready={hasFile ? 'file' : 'fallback'}
  style={`--si-w:${entry.width};--si-h:${entry.height};--si-ratio:${ratio};`}
>
  {
    light ? (
      <>
        <img
          class="site-illustration__light"
          src={light.src}
          srcset={light.srcset}
          sizes={sizes}
          alt={alt}
          width={entry.width}
          height={entry.height}
          loading={eager ? 'eager' : 'lazy'}
          fetchpriority={eager ? 'high' : undefined}
          decoding={eager ? 'sync' : 'async'}
        />
        {dark && (
          <img
            class="site-illustration__dark"
            src={dark.src}
            srcset={dark.srcset}
            sizes={sizes}
            alt={alt}
            width={entry.width}
            height={entry.height}
            loading="lazy"
            decoding="async"
          />
        )}
      </>
    ) : (
      <div
        class="site-illustration__fallback"
        role="img"
        aria-label={alt}
        style={`aspect-ratio:${ratio};`}
      >
        <div class="site-illustration__texels" aria-hidden="true">
          {tiles.map((tone) => (tone === 0 ? <i /> : <i class={`t${tone}`} />))}
        </div>
      </div>
    )
  }
</figure>

<style>
  .site-illustration {
    display: block;
    margin: 0;
    overflow: hidden;
    border-radius: calc(var(--tx-radius, 0.5rem) * 1.25);
    border: 1px solid color-mix(in oklab, var(--tx-border) 80%, transparent);
    background: var(--tx-muted);
    inline-size: 100%;
    max-inline-size: 100%;
  }
  /* Landing plates and bands sit flush on the light theme (the art carries
     its own light ground); the dark theme frames them with a soft glow so
     the light ground reads as a lit product shot, not a patch. */
  .site-illustration--plate,
  .site-illustration--band {
    border-color: transparent;
    background: transparent;
  }
  :global(:root[data-tx-mode='dark']) .site-illustration--plate,
  :global(:root[data-tx-mode='dark']) .site-illustration--band {
    border-color: color-mix(in oklab, var(--tx-primary) 35%, transparent);
    box-shadow: 0 0 0 1px color-mix(in oklab, var(--tx-primary) 18%, transparent),
      0 1.5rem 4rem -1.5rem color-mix(in oklab, var(--tx-primary) 45%, transparent);
  }
  .site-illustration__dark {
    display: none !important;
  }
  :global(:root[data-tx-mode='dark']) .site-illustration--has-dark .site-illustration__light {
    display: none !important;
  }
  :global(:root[data-tx-mode='dark']) .site-illustration--has-dark .site-illustration__dark {
    display: block !important;
  }
  :global(:root[data-tx-mode='dark']) .site-illustration--has-dark {
    border-color: transparent;
    box-shadow: none;
  }
  .site-illustration img {
    display: block;
    inline-size: 100%;
    block-size: auto;
    aspect-ratio: var(--si-ratio);
    object-fit: cover;
  }
  .site-illustration__fallback {
    position: relative;
    inline-size: 100%;
    overflow: hidden;
    background:
      radial-gradient(90% 120% at 100% 0%, rgb(109 74 255 / 0.14), transparent 60%),
      color-mix(in oklab, var(--tx-muted) 60%, var(--tx-background));
  }
  .site-illustration__texels {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    align-content: center;
    gap: clamp(4px, 1.1vw, 10px);
    padding: clamp(10px, 3vw, 28px);
  }
  /* Lean markup: bare <i> cells (no scope attribute each), tones as t1–t4. */
  .site-illustration__texels > :global(i) {
    aspect-ratio: 1;
    border-radius: 22%;
    border: 1px solid color-mix(in oklab, var(--tx-border) 70%, transparent);
  }
  /* Fallback texels use the illustration palette (docs/ILLUSTRATIONS.md):
     lilac glass, a stronger lilac, the brand violet, and the rare orange. */
  .site-illustration__texels > :global(.t1) {
    background: color-mix(in oklab, #b9a8ff 22%, var(--tx-background));
  }
  .site-illustration__texels > :global(.t2) {
    background: color-mix(in oklab, #b9a8ff 55%, var(--tx-background));
    border-color: transparent;
  }
  .site-illustration__texels > :global(.t3) {
    background: #6d4aff;
    border-color: transparent;
  }
  /* The rare strong texel is the social image's warm orange highlight
     (docs/ILLUSTRATIONS.md palette), decorative only. */
  .site-illustration__texels > :global(.t4) {
    background: oklch(0.76 0.15 50);
    border-color: transparent;
  }
  @media (forced-colors: active) {
    .texel {
      border-color: CanvasText;
    }
    .texel--3,
    .site-illustration__texels > :global(.t4) {
      background: CanvasText;
    }
  }
</style>
