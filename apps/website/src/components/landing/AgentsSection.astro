---
/**
 * Agents path: catalog → safe renderer → any interface, with a tiny live excerpt.
 */
import { withBase } from '../foundation/site.ts';
import AgentsPlayground from './AgentsPlayground.svelte';

const base = import.meta.env.BASE_URL;
const code = `// Agent output is a catalog tree — never raw HTML
{
  "type": "card",
  "props": { "title": "Harbor pulse" },
  "children": [
    { "type": "badge", "props": { "label": "Live" } },
    { "type": "button", "props": { "label": "Open" } }
  ]
}`;
---

<section class="agents" aria-labelledby="agents-title" data-tx-landing-agents="">
  <header class="agents__head">
    <h2 id="agents-title">Built so agents can ship UI safely</h2>
    <p>
      Catalog in, safe renderer out. Agents pick closed components; people get real keyboard paths
      and theme tokens—no HTML sinks.
    </p>
    <ol class="agents__steps">
      <li><span>1</span> Catalog</li>
      <li><span>2</span> Safe renderer</li>
      <li><span>3</span> Any interface</li>
    </ol>
    <p class="agents__links">
      <a href={withBase(base, '/agents-page/')}>Agents overview</a>
      ·
      <a href={withBase(base, '/skill/')}>Agent skill</a>
      ·
      <a href={withBase(base, '/llms.txt')}>llms.txt</a>
    </p>
  </header>

  <div class="agents__stage">
    <pre class="agents__code" tabindex="0"><code>{code}</code></pre>
    <AgentsPlayground client:visible />
  </div>
</section>

<style>
  .agents {
    display: grid;
    gap: 1.5rem;
    max-inline-size: 72rem;
    margin-inline: auto;
    padding-block: clamp(1.5rem, 4vw, 3rem);
    padding-inline: 1rem;
  }
  @media (min-width: 900px) {
    .agents {
      grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
      align-items: start;
    }
  }
  .agents__head h2 {
    margin: 0 0 0.5rem;
    font-size: clamp(1.5rem, 3vw, 2rem);
    color: var(--tx-foreground);
  }
  .agents__head > p {
    margin: 0 0 1rem;
    max-inline-size: 36rem;
    color: var(--tx-muted-foreground);
  }
  .agents__steps {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0 0 1rem;
    padding: 0;
    list-style: none;
  }
  .agents__steps li {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-block-size: 2.25rem;
    padding-inline: 0.65rem;
    border-radius: 999px;
    border: 1px solid var(--tx-border);
    background: var(--tx-card, var(--tx-background));
    color: var(--tx-foreground);
    font-size: 0.875rem;
    font-weight: 600;
  }
  .agents__steps span {
    display: inline-grid;
    place-items: center;
    inline-size: 1.25rem;
    block-size: 1.25rem;
    border-radius: 999px;
    background: var(--tx-primary);
    color: var(--tx-primary-foreground, var(--tx-background));
    font-size: 0.7rem;
  }
  .agents__links {
    margin: 0;
    font-size: 0.9rem;
  }
  .agents__stage {
    display: grid;
    gap: 0.75rem;
  }
  .agents__code {
    margin: 0;
    padding: 0.9rem 1rem;
    overflow: auto;
    border-radius: var(--tx-radius, 0.5rem);
    border: 1px solid var(--tx-border);
    background: color-mix(in oklab, var(--tx-muted) 55%, var(--tx-background));
    color: var(--tx-foreground);
    font-size: 0.78rem;
    line-height: 1.45;
  }
  .agents__code:focus-visible {
    outline: 2px solid var(--tx-ring);
    outline-offset: 2px;
  }
</style>
