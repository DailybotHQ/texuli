---
/**
 * Landing hero: large headline, one-line subhead, primary and secondary CTAs.
 * The interactive moments grid is a single hydrated island.
 */
import { Button } from 'texuli/button';
import { withBase } from '../foundation/site.ts';
import HeroMoments from './HeroMoments.svelte';
import SiteIllustration from './SiteIllustration.astro';

const base = import.meta.env.BASE_URL;
---

<section class="hero" aria-labelledby="landing-hero-title" data-tx-landing-hero="">
  <div class="hero__copy">
    <p class="hero__eyebrow">Svelte 5 · owned end to end</p>
    <h1 id="landing-hero-title">Interfaces from texels.</h1>
    <p class="hero__sub">
      Owned, accessible Svelte 5 components that people and agents can build anything with.
    </p>
    <div class="hero__actions">
      <Button href={withBase(base, '/guides/getting-started/')} variant="outline" class="hero__cta-primary">
        Start building
      </Button>
      <Button href={withBase(base, '/component-pages/')} variant="ghost">
        Browse components
      </Button>
    </div>
  </div>

  <div class="hero__visual" data-tx-landing-hero-visual="">
    <SiteIllustration slot="hero-bg" class="hero__bg" />
    <HeroMoments client:load />
  </div>
</section>

<style>
  .hero {
    display: grid;
    gap: clamp(1.5rem, 4vw, 2.5rem);
    padding-block: clamp(1.25rem, 4vw, 2.5rem) clamp(2rem, 5vw, 3.5rem);
    padding-inline: 1rem;
    max-inline-size: 72rem;
    margin-inline: auto;
  }
  @media (min-width: 960px) {
    .hero {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 1.1fr);
      align-items: center;
    }
  }
  .hero__copy {
    display: grid;
    gap: 1rem;
    max-inline-size: 36rem;
  }
  .hero__eyebrow {
    margin: 0;
    color: var(--tx-muted-foreground);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  h1 {
    margin: 0;
    color: var(--tx-foreground);
    font-size: clamp(2.75rem, 9vw, 4.75rem);
    line-height: 1.02;
    letter-spacing: -0.03em;
    font-weight: 750;
  }
  .hero__sub {
    margin: 0;
    max-inline-size: 34rem;
    color: var(--tx-foreground);
    font-size: clamp(1.05rem, 2.4vw, 1.25rem);
    line-height: 1.45;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-block-start: 0.35rem;
  }
  /* Solid primary using surface tokens so contrast stays AA on every theme. */
  .hero__actions :global(.hero__cta-primary) {
    background: var(--tx-foreground);
    color: var(--tx-background);
    border-color: var(--tx-foreground);
  }
  .hero__actions :global(.hero__cta-primary:hover) {
    background: color-mix(in oklab, var(--tx-foreground) 88%, var(--tx-background));
    color: var(--tx-background);
  }
  .hero__visual {
    position: relative;
    isolation: isolate;
  }
  .hero__visual :global(.hero__bg) {
    position: absolute;
    inset: 0;
    z-index: 0;
    opacity: 0.55;
    pointer-events: none;
  }
  .hero__visual :global(.hero__bg img),
  .hero__visual :global(.site-illustration__fallback) {
    min-block-size: 100%;
  }
</style>
