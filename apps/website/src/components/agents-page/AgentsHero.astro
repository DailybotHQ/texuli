---
/**
 * Hero for the Texuli for agents page.
 */
import { Button } from 'texuli/button';
import { withBase } from '../foundation/site.ts';

const base = import.meta.env.BASE_URL;
---

<section class="hero" aria-labelledby="agents-hero-title">
  <p class="hero__eyebrow">For coding agents</p>
  <h1 id="agents-hero-title">Texuli for agents</h1>
  <p class="hero__lead">
    A closed catalog, emit tiers, a sink-free renderer and local tools—so agents build real
    interfaces without inventing components or HTML sinks. For coding agents and the people who
    run them: connect the MCP server at <a href={withBase(base, '/mcp-server/')}>/mcp</a> or install
    the <a href={withBase(base, '/skill/')}>Texuli skill</a>, then let the agent read llms.txt
    and the catalog below.
  </p>
  <div class="hero__actions">
    <Button href={withBase(base, '/llms/llms.txt')} variant="outline">Open llms.txt</Button>
    <Button href={withBase(base, '/catalog/catalog.json')} variant="outline">Open catalog JSON</Button>
  </div>
</section>

<style>
  .hero {
    display: grid;
    gap: 0.75rem;
    max-inline-size: 44rem;
    color: var(--tx-foreground);
    margin-block-end: 2rem;
  }
  .hero__eyebrow {
    margin: 0;
    font-size: 0.875rem;
  }
  h1 {
    margin: 0;
    font-size: clamp(2rem, 6vw, 3rem);
    line-height: 1.15;
  }
  .hero__lead {
    margin: 0;
    font-size: 1.125rem;
    max-inline-size: 40rem;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-block-start: 0.35rem;
  }
  .hero :global([data-tx-button]) {
    color: var(--tx-foreground) !important;
    background: var(--tx-background) !important;
    border-color: var(--tx-border) !important;
  }
</style>
