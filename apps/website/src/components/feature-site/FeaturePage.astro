---
/**
 * The frame of a feature showcase page (/forms-page/, /canvas-page/, and
 * the 0.8.0 pages that follow): the status eyebrow, the one h1, the lead,
 * the package pieces and the in-page table of contents, then the page's
 * sections in the default slot. Sections use the shared classes below
 * (`fx-section`, `fx-pair`, `fx-panel`, `fx-note`, `fx-status`,
 * `fx-rules`, `fx-keys`, `fx-docs`), so every showcase reads the same.
 * Static: no client JavaScript of its own.
 */
interface Piece {
  readonly name: string;
  readonly role: string;
}
interface Section {
  readonly id: string;
  readonly title: string;
}
interface Props {
  /** The status line above the h1 (for example "@texuli/forms · in development · on npm from 0.8.0"). */
  eyebrow: string;
  title: string;
  pieces: readonly Piece[];
  piecesLabel: string;
  sections: readonly Section[];
  /** A data attribute value on the root, for tests (`data-tx-feature-page`). */
  name: string;
}

const { eyebrow, title, pieces, piecesLabel, sections, name } = Astro.props;
---

<div class="fx-page" data-tx-feature-page={name}>
  <header class="fx-hero">
    <p class="fx-eyebrow">{eyebrow}</p>
    <h1>{title}</h1>
    <div class="fx-lead"><slot name="lead" /></div>
    <ol class="fx-pieces" aria-label={piecesLabel}>
      {
        pieces.map((piece) => (
          <li class="fx-pieces__item">
            <code>{piece.name}</code>
            <span>{piece.role}</span>
          </li>
        ))
      }
    </ol>
  </header>

  <nav class="fx-toc" aria-label="Sections on this page">
    <ul>
      {
        sections.map((entry) => (
          <li>
            <a href={`#${entry.id}`}>{entry.title}</a>
          </li>
        ))
      }
    </ul>
  </nav>

  <slot />
</div>

<style>
  .fx-page {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2rem;
  }
  .fx-hero {
    display: grid;
    gap: 0.75rem;
  }
  .fx-eyebrow {
    margin: 0;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--tx-foreground);
  }
  h1 {
    margin: 0;
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    line-height: 1.1;
    color: var(--tx-foreground);
  }
  .fx-lead :global(p) {
    margin: 0;
    max-inline-size: 46rem;
    font-size: 1.0625rem;
    color: var(--tx-foreground);
  }
  .fx-pieces {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .fx-pieces__item {
    display: grid;
    gap: 0.1rem;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--tx-border, CanvasText);
    border-radius: 0.75rem;
    background: var(--tx-surface, Canvas);
    font-size: 0.8125rem;
  }
  .fx-pieces__item code {
    font-weight: 600;
  }
  .fx-pieces__item span {
    color: var(--tx-muted-foreground, CanvasText);
  }
  .fx-toc ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .fx-toc a {
    color: var(--tx-link, LinkText);
  }

  .fx-page :global(.fx-section) {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.75rem;
    min-inline-size: 0;
    scroll-margin-block-start: 5rem;
  }
  .fx-page :global(.fx-section > h2) {
    margin: 0;
    font-size: clamp(1.25rem, 2.5vw, 1.5rem);
  }
  .fx-page :global(.fx-section h3) {
    margin: 0;
    font-size: 1.0625rem;
  }
  .fx-page :global(.fx-section > p) {
    margin: 0;
    max-inline-size: 46rem;
  }
  .fx-page :global(.fx-pair) {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
    gap: 1rem;
    align-items: start;
  }
  .fx-page :global(.fx-pair > *),
  .fx-page :global(.fx-panel) {
    min-inline-size: 0;
  }
  .fx-page :global(.fx-panel) {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.6rem;
  }
  .fx-page :global(.fx-section pre) {
    max-inline-size: 100%;
    overflow-x: auto;
  }
  .fx-page :global(.fx-pair--code pre) {
    max-block-size: 22rem;
    overflow: auto;
  }
  .fx-page :global(.fx-note) {
    margin: 0;
    font-size: 0.875rem;
  }
  .fx-page :global(.fx-status) {
    margin: 0;
    max-inline-size: 46rem;
    padding: 0.75rem 1rem;
    border-inline-start: 4px solid var(--tx-info, CanvasText);
    border-radius: 0.5rem;
    background: var(--tx-info-soft, Canvas);
    color: var(--tx-info-soft-foreground, CanvasText);
    font-size: 0.9rem;
  }
  .fx-page :global(.fx-rules) {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .fx-page :global(.fx-rules > li) {
    display: grid;
    align-content: start;
    gap: 0.4rem;
    min-inline-size: 0;
    padding: 0.9rem 1rem;
    border: 1px solid var(--tx-border, CanvasText);
    border-radius: 0.85rem;
    background: var(--tx-surface, Canvas);
  }
  .fx-page :global(.fx-rules p) {
    margin: 0;
    font-size: 0.9rem;
  }
  .fx-page :global(.fx-table-wrap) {
    max-inline-size: 100%;
    overflow-x: auto;
  }
  .fx-page :global(.fx-table-wrap:focus-visible) {
    outline: 2px solid var(--tx-ring, Highlight);
    outline-offset: 2px;
  }
  .fx-page :global(.fx-table) {
    inline-size: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
  }
  .fx-page :global(.fx-table caption) {
    padding-block-end: 0.4rem;
    text-align: start;
    font-weight: 600;
  }
  .fx-page :global(.fx-table th),
  .fx-page :global(.fx-table td) {
    padding: 0.45rem 0.6rem;
    border-block-end: 1px solid var(--tx-border, CanvasText);
    text-align: start;
    vertical-align: top;
  }
  .fx-page :global(.fx-table kbd) {
    font-family: inherit;
    font-weight: 600;
  }
  .fx-page :global(.fx-list) {
    display: grid;
    gap: 0.3rem;
    margin: 0;
    padding-inline-start: 1.25rem;
    max-inline-size: 46rem;
  }
  .fx-page :global(.fx-list code) {
    overflow-wrap: anywhere;
  }
</style>
