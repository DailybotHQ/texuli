---
/**
 * Texels → Texuli → Interfaces: small units compose into components, and
 * components compose into complete interfaces.
 */
const texels = Array.from({ length: 16 }, (_, index) => [1, 6, 9, 12, 15].includes(index));
const pieces = Array.from({ length: 9 }, (_, index) => index === 4);
---

<figure class="diagram">
  <ol>
    <li>
      <div class="grid four" aria-hidden="true">
        {texels.map((strong) => <span class:list={{ strong }} />)}
      </div>
      <strong>Texels</strong>
      <span>Behavior and tokens</span>
    </li>
    <li>
      <div class="grid three" aria-hidden="true">
        {pieces.map((strong) => <span class:list={{ strong }} />)}
      </div>
      <strong>Texuli</strong>
      <span>Components</span>
    </li>
    <li>
      <svg class="window" viewBox="0 0 120 96" aria-hidden="true">
        <rect x="4" y="4" width="112" height="88" rx="10" />
        <line x1="4" y1="24" x2="116" y2="24" />
        <rect x="16" y="36" width="40" height="44" rx="5" />
        <rect x="66" y="36" width="38" height="18" rx="5" />
        <rect x="66" y="62" width="38" height="18" rx="5" />
      </svg>
      <strong>Interfaces</strong>
      <span>Anything you can describe</span>
    </li>
  </ol>
  <figcaption>Small units → reusable components → complete interfaces, composed by people and agents.</figcaption>
</figure>

<style>
  .diagram {
    margin: 0;
    padding: clamp(1rem, 4vw, 2rem);
    border: 1px solid var(--line);
    border-radius: 1rem;
    background: var(--surface);
  }
  ol {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  li {
    display: grid;
    justify-items: center;
    gap: 0.5rem;
    text-align: center;
  }
  li span {
    color: var(--muted);
    font-size: 0.875rem;
  }
  .grid {
    display: grid;
    gap: 6px;
    inline-size: min(100%, 7rem);
    aspect-ratio: 1;
  }
  .four {
    grid-template-columns: repeat(4, 1fr);
  }
  .three {
    grid-template-columns: repeat(3, 1fr);
  }
  .grid span {
    border-radius: 4px;
    background: var(--accent-soft);
  }
  .grid span.strong {
    background: var(--accent);
  }
  .window {
    inline-size: min(100%, 8rem);
    fill: none;
    stroke: var(--accent);
    stroke-width: 5;
  }
  figcaption {
    margin-block-start: 1.5rem;
    color: var(--muted);
    font-size: 0.875rem;
    text-align: center;
  }
  @media (max-width: 30rem) {
    ol {
      grid-template-columns: 1fr;
    }
  }
</style>
