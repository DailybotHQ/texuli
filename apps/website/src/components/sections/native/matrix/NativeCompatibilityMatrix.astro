---
import { safeHref } from '@texuli/core/url-policy';
import {
  NATIVE_MATRIX_GROUPS,
  NATIVE_MATRIX_PLATFORMS,
  NATIVE_MATRIX_ROWS,
  NATIVE_MATRIX_STATUSES,
  NATIVE_MATRIX_TOTALS,
  NATIVE_MATRIX_VERSION,
  nativeMatrixKey,
} from './matrix-data.ts';

const codeHref = (path: string) =>
  safeHref(`https://github.com/DailybotHQ/texuli/blob/main/${path}`, 'developer');
const groupId = (group: string) => `native-matrix-group-${nativeMatrixKey(group)}`;
const statusId = (status: string) => `native-matrix-status-${nativeMatrixKey(status)}`;
---

<section
  class="native-matrix"
  aria-labelledby="native-matrix-title"
  data-tx-native-matrix=""
  data-spec-version={NATIVE_MATRIX_VERSION}
>
  <div class="native-matrix__heading">
    <p class="native-matrix__eyebrow">Generated from parity and trace files · Spec {NATIVE_MATRIX_VERSION}</p>
    <h2 id="native-matrix-title">Compatibility, component by component</h2>
    <p>
      Statuses come from the versioned native parity catalog and checked-in conformance traces.
      Filters update this table without loading a client-side app.
    </p>
  </div>

  <div class="native-matrix__platforms" aria-labelledby="native-matrix-platforms-title">
    <h3 id="native-matrix-platforms-title">Platform status</h3>
    <ul class="native-matrix__platform-list">
      {NATIVE_MATRIX_PLATFORMS.map((platform) => (
        <li class="native-matrix__platform" data-platform-status={platform.status}>
          <div class="native-matrix__platform-heading">
            <h4>{platform.target}</h4>
            <span class="native-matrix__badge" data-status={nativeMatrixKey(platform.status)}>
              {platform.status}
            </span>
          </div>
          <p>{platform.detail}</p>
          <ul class="native-matrix__evidence" aria-label={`${platform.target} evidence`}>
            {platform.evidence.map((path) => {
              const href = codeHref(path);
              return <li>{href ? <a href={href}>{path}</a> : <code>{path}</code>}</li>;
            })}
          </ul>
        </li>
      ))}
    </ul>
  </div>

  <fieldset class="native-matrix__filters" aria-describedby="native-matrix-filter-help">
    <legend>Filter components</legend>
    <p id="native-matrix-filter-help">Choose one group and one status. Both filters apply to the table.</p>
    <div class="native-matrix__filter-set" role="group" aria-label="Component group">
      <span class="native-matrix__filter-label">Group</span>
      <label><input type="radio" name="native-matrix-group" id="native-matrix-group-all" checked /> All groups</label>
      {NATIVE_MATRIX_GROUPS.map((group) => (
        <label>
          <input type="radio" name="native-matrix-group" id={groupId(group)} /> {group}
        </label>
      ))}
    </div>
    <div class="native-matrix__filter-set" role="group" aria-label="Compatibility status">
      <span class="native-matrix__filter-label">Status</span>
      <label><input type="radio" name="native-matrix-status" id="native-matrix-status-all" checked /> All statuses</label>
      {NATIVE_MATRIX_STATUSES.map((status) => (
        <label>
          <input type="radio" name="native-matrix-status" id={statusId(status)} /> {status}
        </label>
      ))}
    </div>
  </fieldset>

  <p class="native-matrix__totals" data-tx-native-matrix-totals="">
    {NATIVE_MATRIX_TOTALS.catalog} catalog components · {NATIVE_MATRIX_TOTALS.painted} paint in Compose Desktop · {NATIVE_MATRIX_TOTALS.placeholder} placeholders
  </p>

  <div
    class="native-matrix__table-wrap"
    tabindex="0"
    role="region"
    aria-label="Scrollable native compatibility table"
  >
    <table class="native-matrix__table">
      <caption>Web and native compatibility for spec {NATIVE_MATRIX_VERSION}. Filtered rows leave the table.</caption>
      <thead>
        <tr>
          <th scope="col">Component</th>
          <th scope="col">Group</th>
          <th scope="col">Web</th>
          <th scope="col">Compose Desktop</th>
          <th scope="col">Conformance</th>
          <th scope="col">Evidence</th>
        </tr>
      </thead>
      <tbody>
        {NATIVE_MATRIX_ROWS.map((row) => (
          <tr
            class="native-matrix__row"
            data-component-id={row.id}
            data-group={nativeMatrixKey(row.group)}
            data-statuses={row.statuses.join(' ')}
          >
            <th scope="row"><code>{row.id}</code></th>
            <td>{row.group}</td>
            <td><span class="native-matrix__badge" data-status={nativeMatrixKey(row.web)}>{row.web}</span></td>
            <td><span class="native-matrix__badge" data-status={nativeMatrixKey(row.composeDesktop)}>{row.composeDesktop}</span></td>
            <td><span class="native-matrix__badge" data-status={nativeMatrixKey(row.conformance)}>{row.conformance}</span></td>
            <td>
              <ul class="native-matrix__evidence" aria-label={`${row.id} evidence`}>
                <li>
                  {codeHref(row.evidence.parity) ? (
                    <a href={codeHref(row.evidence.parity)}>Parity catalog</a>
                  ) : <code>{row.evidence.parity}</code>}
                </li>
                {row.evidence.traces.map((path) => {
                  const href = codeHref(path);
                  return <li>{href ? <a href={href}>Conformance trace</a> : <code>{path}</code>}</li>;
                })}
              </ul>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <p class="native-matrix__legend-title">Status legend</p>
  <ul class="native-matrix__legend" aria-label="Compatibility status legend">
    {NATIVE_MATRIX_STATUSES.map((status) => (
      <li><span class="native-matrix__badge" data-status={nativeMatrixKey(status)}>{status}</span></li>
    ))}
  </ul>
</section>

<style>
  .native-matrix {
    display: grid;
    gap: 1.25rem;
    max-inline-size: 78rem;
    margin-inline: auto;
    padding: clamp(2.5rem, 7vw, 5rem) clamp(1rem, 4vw, 1.5rem);
    color: var(--tx-foreground, CanvasText);
  }
  .native-matrix__heading { max-inline-size: 48rem; }
  .native-matrix__eyebrow {
    margin: 0 0 0.45rem;
    color: var(--tx-muted-foreground, GrayText);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.04em;
  }
  .native-matrix h2 { margin: 0; font-size: clamp(1.65rem, 4vw, 2.4rem); line-height: 1.15; }
  .native-matrix__heading > p:last-child { color: var(--tx-muted-foreground, GrayText); line-height: 1.55; }
  .native-matrix h3 { margin: 0; font-size: 1.2rem; }
  .native-matrix h4 { margin: 0; font-size: 1rem; }
  .native-matrix__platforms { display: grid; gap: 0.75rem; }
  .native-matrix__platform-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .native-matrix__platform {
    display: grid;
    align-content: start;
    gap: 0.6rem;
    min-inline-size: 0;
    padding: 0.9rem;
    border: 1px solid var(--tx-border, GrayText);
    border-radius: var(--tx-radius, 0.75rem);
    background: var(--tx-surface, Canvas);
  }
  .native-matrix__platform-heading { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.5rem; }
  .native-matrix__platform p { margin: 0; color: var(--tx-muted-foreground, GrayText); line-height: 1.5; }
  .native-matrix__evidence { display: flex; flex-wrap: wrap; gap: 0.4rem 0.9rem; margin: 0; padding: 0; list-style: none; font-size: 0.84rem; }
  .native-matrix__evidence a { overflow-wrap: anywhere; }
  .native-matrix__filters { display: grid; gap: 0.75rem; margin: 0; padding: 1rem; border: 1px solid var(--tx-border, GrayText); border-radius: var(--tx-radius, 0.75rem); }
  .native-matrix__filters legend { padding-inline: 0.35rem; font-weight: 700; }
  .native-matrix__filters > p { margin: 0; color: var(--tx-muted-foreground, GrayText); font-size: 0.9rem; }
  .native-matrix__filter-set { display: flex; flex-wrap: wrap; align-items: center; gap: 0.35rem 0.75rem; }
  .native-matrix__filter-set label { display: inline-flex; align-items: center; gap: 0.35rem; min-block-size: 2rem; cursor: pointer; }
  .native-matrix__filter-set input { accent-color: var(--tx-primary, #6842d8); }
  .native-matrix__filter-label { min-inline-size: 4rem; font-weight: 700; }
  .native-matrix__totals { margin: 0; color: var(--tx-muted-foreground, GrayText); font-size: 0.9rem; }
  .native-matrix__table-wrap { max-inline-size: 100%; overflow: auto; border: 1px solid var(--tx-border, GrayText); border-radius: var(--tx-radius, 0.75rem); }
  .native-matrix__table-wrap:focus-visible { outline: var(--tx-focus-ring-width, 2px) solid var(--tx-ring, Highlight); outline-offset: 3px; }
  .native-matrix__table { inline-size: 100%; min-inline-size: 58rem; border-collapse: collapse; text-align: start; }
  .native-matrix__table caption { padding: 0.75rem; color: var(--tx-muted-foreground, GrayText); text-align: start; }
  .native-matrix__table th, .native-matrix__table td { padding: 0.65rem 0.75rem; border-block-start: 1px solid var(--tx-border, GrayText); vertical-align: top; }
  .native-matrix__table thead th { background: var(--tx-surface, Canvas); text-align: start; }
  .native-matrix__row:nth-child(even) { background: color-mix(in oklab, var(--tx-surface, Canvas) 72%, transparent); }
  .native-matrix__row th[scope='row'] { font-family: var(--tx-font-mono, ui-monospace, monospace); text-align: start; }
  .native-matrix__badge { display: inline-flex; padding: 0.15rem 0.5rem; border: 1px solid var(--tx-border, GrayText); border-radius: 999px; font-size: 0.8rem; font-weight: 700; white-space: nowrap; }
  .native-matrix__badge[data-status='supported'] { border-color: color-mix(in oklab, #16834a 55%, var(--tx-border, GrayText)); }
  .native-matrix__badge[data-status='partial'], .native-matrix__badge[data-status='experimental'] { border-style: dashed; }
  .native-matrix__badge[data-status='planned'], .native-matrix__badge[data-status='unsupported'], .native-matrix__badge[data-status='not-applicable'] { color: var(--tx-muted-foreground, GrayText); }
  .native-matrix__legend-title { margin: 0; font-weight: 700; }
  .native-matrix__legend { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 0; padding: 0; list-style: none; }

  .native-matrix:has(#native-matrix-group-all:checked) .native-matrix__row { display: table-row; }
  .native-matrix:has(#native-matrix-status-all:checked) .native-matrix__row { display: table-row; }
  .native-matrix:has(#native-matrix-status-supported:checked) .native-matrix__row:not([data-statuses~='supported']),
  .native-matrix:has(#native-matrix-status-partial:checked) .native-matrix__row:not([data-statuses~='partial']),
  .native-matrix:has(#native-matrix-status-experimental:checked) .native-matrix__row:not([data-statuses~='experimental']),
  .native-matrix:has(#native-matrix-status-planned:checked) .native-matrix__row:not([data-statuses~='planned']),
  .native-matrix:has(#native-matrix-status-unsupported:checked) .native-matrix__row:not([data-statuses~='unsupported']),
  .native-matrix:has(#native-matrix-status-not-applicable:checked) .native-matrix__row:not([data-statuses~='not-applicable']) { display: none; }
  .native-matrix:has(#native-matrix-group-canvas:checked) .native-matrix__row:not([data-group='canvas']),
  .native-matrix:has(#native-matrix-group-chat:checked) .native-matrix__row:not([data-group='chat']),
  .native-matrix:has(#native-matrix-group-composition:checked) .native-matrix__row:not([data-group='composition']),
  .native-matrix:has(#native-matrix-group-content:checked) .native-matrix__row:not([data-group='content']),
  .native-matrix:has(#native-matrix-group-data:checked) .native-matrix__row:not([data-group='data']),
  .native-matrix:has(#native-matrix-group-display:checked) .native-matrix__row:not([data-group='display']),
  .native-matrix:has(#native-matrix-group-documents:checked) .native-matrix__row:not([data-group='documents']),
  .native-matrix:has(#native-matrix-group-forms:checked) .native-matrix__row:not([data-group='forms']),
  .native-matrix:has(#native-matrix-group-layouts:checked) .native-matrix__row:not([data-group='layouts']),
  .native-matrix:has(#native-matrix-group-overlays:checked) .native-matrix__row:not([data-group='overlays']),
  .native-matrix:has(#native-matrix-group-schema-forms:checked) .native-matrix__row:not([data-group='schema-forms']),
  .native-matrix:has(#native-matrix-group-sheets:checked) .native-matrix__row:not([data-group='sheets']),
  .native-matrix:has(#native-matrix-group-state:checked) .native-matrix__row:not([data-group='state']),
  .native-matrix:has(#native-matrix-group-workflows:checked) .native-matrix__row:not([data-group='workflows']) { display: none; }

  @media (max-width: 40rem) {
    .native-matrix__filter-label { flex-basis: 100%; }
    .native-matrix__platform-heading { align-items: flex-start; }
  }
</style>
