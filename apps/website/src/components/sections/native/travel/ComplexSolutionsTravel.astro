---
import { safeHref } from '@texuli/core/url-policy';
import { REPOSITORY_URL } from '../../../foundation/site.ts';
import { NATIVE_SHARED_SOLUTIONS } from './travel-content.ts';

const codeHref = (path: string) => safeHref(`${REPOSITORY_URL}/blob/main/${path}`, 'developer');
---

<section class="native-solutions-travel" aria-labelledby="native-solutions-travel-title" data-tx-native-solutions-travel="">
  <div class="native-solutions-travel__heading">
    <p class="native-solutions-travel__eyebrow">Shared intent, adapted experience</p>
    <h2 id="native-solutions-travel-title">Complex solutions share a model, not a screen</h2>
    <p>
      A presentation, document, workflow, canvas, or workbook can keep its domain data and intent
      while each platform chooses an appropriate reading, editing, and navigation experience.
      The current native evidence is component-level; it does not certify these complete solution editors.
    </p>
  </div>

  <ul class="native-solutions-travel__list">
    {NATIVE_SHARED_SOLUTIONS.map((solution) => {
      const href = codeHref(solution.path);
      return (
        <li class="native-solutions-travel__item" data-solution={solution.title.toLowerCase()}>
          <h3>{solution.title}</h3>
          <p>{solution.sharedIntent}</p>
          <p class="native-solutions-travel__package">Web package: <code>{solution.package}</code></p>
          {href && <a href={href}>Read package capabilities</a>}
        </li>
      );
    })}
  </ul>
</section>

<style>
  .native-solutions-travel { display: grid; gap: 1rem; max-inline-size: 78rem; margin-inline: auto; padding: clamp(2.5rem, 7vw, 5rem) clamp(1rem, 4vw, 1.5rem); color: var(--tx-foreground, CanvasText); }
  .native-solutions-travel__heading { max-inline-size: 48rem; }
  .native-solutions-travel__eyebrow { margin: 0 0 0.45rem; color: var(--tx-muted-foreground, GrayText); font-size: 0.85rem; font-weight: 700; letter-spacing: 0.05em; }
  .native-solutions-travel h2 { margin: 0; font-size: clamp(1.65rem, 4vw, 2.4rem); line-height: 1.15; }
  .native-solutions-travel__heading > p:last-child { color: var(--tx-muted-foreground, GrayText); line-height: 1.55; }
  .native-solutions-travel__list { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr)); gap: 0.75rem; margin: 0; padding: 0; list-style: none; }
  .native-solutions-travel__item { display: grid; align-content: start; gap: 0.65rem; min-inline-size: 0; padding: 1rem; border: 1px solid var(--tx-border, GrayText); border-radius: var(--tx-radius, 0.75rem); background: var(--tx-surface, Canvas); }
  .native-solutions-travel__item h3 { margin: 0; font-size: 1.1rem; }
  .native-solutions-travel__item p { margin: 0; line-height: 1.5; }
  .native-solutions-travel__package { color: var(--tx-muted-foreground, GrayText); font-size: 0.9rem; }
</style>
