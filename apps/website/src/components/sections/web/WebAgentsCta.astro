---
/**
 * Unified landing, agents + closing CTA section (PLAN_006 T-43). The agents
 * strip (closed catalog, sink-free renderer, any interface), the served
 * agent surfaces, and the closing band with the real preview install
 * command and the playground as its primary action (narrative blueprint
 * §5 s6 and s8).
 *
 * All copy lives in `web-agents-content.ts`; the unit test
 * (`apps/website/tests/web-agents-cta.test.ts`) pins every claim against
 * the file it cites. Static markup plus one small module script for the
 * copy button, which rides the analytics `code_copy` seam exactly like
 * CopyPage.astro (`web-copy-command.ts`). No island, no motion, no HTML
 * sinks; links resolve through the URL policy (developer tier).
 */
import { safeHref } from '@texuli/core/url-policy';
import { Button } from 'texuli/button';
import { withBase } from '../../foundation/site.ts';
import {
  WEB_AGENTS_CLOSING,
  WEB_AGENTS_CTA_LINKS,
  WEB_AGENTS_IDS,
  WEB_AGENTS_INSTALL,
  WEB_AGENTS_LEDE,
  WEB_AGENTS_STEPS,
  WEB_AGENTS_SURFACES,
  WEB_AGENTS_TITLE,
} from './web-agents-content.ts';

const base = import.meta.env.BASE_URL;

const resolveHref = (href: string): string | undefined => {
  const safe = safeHref(href, 'developer');
  return safe === undefined ? undefined : withBase(base, safe);
};
---

<section class="web-agents" aria-labelledby={WEB_AGENTS_IDS.section} data-tx-web-agents="">
  <h2 id={WEB_AGENTS_IDS.section}>{WEB_AGENTS_TITLE}</h2>
  <p class="web-agents__lede">{WEB_AGENTS_LEDE.text}</p>

  <h3 id={WEB_AGENTS_IDS.story}>From catalog to interface</h3>
  <ol class="web-agents__steps" role="list">
    {
      WEB_AGENTS_STEPS.map((step) => (
        <li class="web-agents__card">
          <p>
            <strong>{step.title}.</strong> {step.body}
          </p>
        </li>
      ))
    }
  </ol>

  <h3 id={WEB_AGENTS_IDS.surfaces}>What agents can read here</h3>
  <ul class="web-agents__surfaces" role="list">
    {
      WEB_AGENTS_SURFACES.map((link) => (
        <li class="web-agents__card">
          <a class="web-agents__link" href={resolveHref(link.href)}>{link.label}</a>
          <p>{link.description}</p>
        </li>
      ))
    }
  </ul>

  <div class="web-agents__band">
    <h3 id={WEB_AGENTS_IDS.install}>{WEB_AGENTS_CLOSING}</h3>
    <div class="web-agents__install" data-copy-command="">
      <pre
        tabindex="0"
        role="region"
        aria-label="Install command"
      ><code>{WEB_AGENTS_INSTALL.command}</code></pre>
      <Button variant="outline" size="sm" data-copy-command-button="">Copy install command</Button>
      <template data-copy-command-text="">{WEB_AGENTS_INSTALL.command}</template>
      <p class="web-agents__status" role="status" data-copy-command-status=""></p>
    </div>
    <p class="web-agents__note">{WEB_AGENTS_INSTALL.note}</p>
    <div class="web-agents__actions">
      {
        WEB_AGENTS_CTA_LINKS.map((link) => (
          <a
            href={resolveHref(link.href)}
            class={link.role === 'primary'
              ? 'web-agents__cta web-agents__cta--primary'
              : 'web-agents__cta web-agents__cta--secondary'}
          >
            {link.label}
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .web-agents {
    display: grid;
    gap: 1.25rem;
    max-inline-size: 72rem;
    margin-inline: auto;
    padding-block: clamp(2rem, 5vw, 3.5rem);
    padding-inline: clamp(1rem, 4vw, 1.5rem);
  }
  .web-agents h2 {
    margin: 0;
    font-size: clamp(1.5rem, 3vw, 2rem);
    line-height: 1.2;
    color: var(--tx-foreground);
  }
  .web-agents h3 {
    margin: 0.5rem 0 0;
    font-size: 1.1rem;
    color: var(--tx-foreground);
  }
  .web-agents__lede {
    margin: 0;
    max-inline-size: 46rem;
    color: var(--tx-muted-foreground);
    line-height: 1.6;
  }
  .web-agents__steps,
  .web-agents__surfaces {
    display: grid;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 56rem) {
    .web-agents__steps {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .web-agents__surfaces {
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr));
    }
  }
  .web-agents__card {
    display: grid;
    gap: 0.4rem;
    align-content: start;
    border: var(--tx-border-width, 1px) solid var(--tx-border);
    border-radius: var(--tx-radius, 0.5rem);
    padding: 0.85rem 1rem;
    background: var(--tx-card, var(--tx-background));
    min-inline-size: 0;
  }
  .web-agents__card p {
    margin: 0;
    color: var(--tx-foreground);
    line-height: 1.55;
  }
  .web-agents__surfaces .web-agents__card p {
    color: var(--tx-muted-foreground);
    font-size: 0.9rem;
  }
  .web-agents__link {
    color: var(--tx-primary);
    font-weight: 600;
    text-decoration-thickness: from-font;
    text-underline-offset: 0.2em;
    overflow-wrap: anywhere;
  }
  .web-agents__link:focus-visible,
  .web-agents__cta:focus-visible,
  .web-agents pre:focus-visible {
    outline: 2px solid var(--tx-ring);
    outline-offset: 2px;
  }
  .web-agents__band {
    display: grid;
    gap: 0.85rem;
    justify-items: start;
    margin-block-start: 0.5rem;
    border: var(--tx-border-width, 1px) solid var(--tx-border);
    border-radius: var(--tx-radius, 0.5rem);
    padding: clamp(1rem, 4vw, 1.75rem);
    background: color-mix(in oklab, var(--tx-muted) 35%, var(--tx-background));
  }
  .web-agents__band h3 {
    margin: 0;
    font-size: clamp(1.2rem, 2.6vw, 1.5rem);
  }
  .web-agents__install {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    max-inline-size: 100%;
  }
  .web-agents pre {
    margin: 0;
    max-inline-size: 100%;
    padding-block: 0.55rem;
    padding-inline: 0.9rem;
    overflow: auto;
    border: 1px solid var(--tx-border);
    border-radius: var(--tx-radius, 0.5rem);
    background: var(--tx-background);
    color: var(--tx-foreground);
    font-size: 0.9rem;
    text-align: start;
  }
  .web-agents__status {
    margin: 0;
    color: var(--tx-muted-foreground);
    font-size: 0.875rem;
  }
  .web-agents__note {
    margin: 0;
    max-inline-size: 46rem;
    color: var(--tx-muted-foreground);
    font-size: 0.9rem;
    line-height: 1.5;
  }
  .web-agents__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .web-agents__cta {
    display: inline-block;
    border: 1px solid var(--tx-border);
    border-radius: var(--tx-radius, 0.5rem);
    padding-block: 0.6rem;
    padding-inline: 1.1rem;
    font-weight: 600;
    text-decoration: none;
  }
  .web-agents__cta--primary {
    background: var(--tx-foreground);
    border-color: var(--tx-foreground);
    color: var(--tx-background);
  }
  .web-agents__cta--primary:hover {
    background: color-mix(in oklab, var(--tx-foreground) 88%, var(--tx-background));
    color: var(--tx-background);
  }
  .web-agents__cta--secondary {
    background: transparent;
    color: var(--tx-foreground);
  }
  .web-agents__cta--secondary:hover {
    background: color-mix(in oklab, var(--tx-muted) 45%, var(--tx-background));
  }
  @media (forced-colors: active) {
    .web-agents pre,
    .web-agents__band,
    .web-agents__card {
      border-color: CanvasText;
    }
    .web-agents__cta {
      border-color: ButtonText;
    }
    /* Forced colors (T-87, axe color-contrast): the filled CTA's author
       text color would sit on the forced Canvas, so name system colors. */
    .web-agents__cta--primary,
    .web-agents__cta--primary:hover {
      border-color: LinkText;
      background: Canvas;
      color: LinkText;
    }
  }
</style>

<script>
  import { wireCopyCommand } from './web-copy-command.ts';

  for (const host of document.querySelectorAll<HTMLElement>('[data-copy-command]')) {
    wireCopyCommand(host);
  }
</script>
