---
/**
 * Unified landing hero (PLAN_006 T-40). The platform story from the
 * narrative blueprint: the earned h1 stays, the eyebrow + sub do the
 * platform work, and the visual moment is the real token engine — six
 * library themes loaded at build and painted as real swatch tiles. No
 * screenshots, no fake product shots, no version claims (blueprint §6:
 * the hero claims the system, the footer owns the npm status).
 *
 * Static markup only — no island, no motion — so reduced-motion
 * preferences are respected by construction. Every link resolves through
 * the URL policy (`safeHref`, developer tier: app-authored site routes).
 */
import { safeHref } from '@texuli/core/url-policy';
import { withBase } from '../../foundation/site.ts';
import {
  countAllThemes,
  loadHeroThemes,
  WEB_HERO_ACTIONS,
  WEB_HERO_EYEBROW,
  WEB_HERO_GRID_CAPTION,
  WEB_HERO_GRID_LINKS,
  WEB_HERO_IDS,
  WEB_HERO_SUB,
  WEB_HERO_TITLE,
} from './web-hero-content.ts';

const base = import.meta.env.BASE_URL;
const [themes, themeCount] = await Promise.all([loadHeroThemes(), countAllThemes()]);

const resolveHref = (href: string): string | undefined => {
  const safe = safeHref(href, 'developer');
  return safe === undefined ? undefined : withBase(base, safe);
};
---

<section class="web-hero" aria-labelledby={WEB_HERO_IDS.hero} data-tx-web-hero="">
  <div class="web-hero__copy">
    <p class="web-hero__eyebrow">{WEB_HERO_EYEBROW}</p>
    <h1 id={WEB_HERO_IDS.hero}>{WEB_HERO_TITLE}</h1>
    <p class="web-hero__sub">{WEB_HERO_SUB}</p>
    <div class="web-hero__actions">
      {
        WEB_HERO_ACTIONS.map((link) => (
          <a
            href={resolveHref(link.href)}
            class={link.role === 'primary'
              ? 'web-hero__cta web-hero__cta--primary'
              : 'web-hero__cta web-hero__cta--secondary'}
          >
            {link.label}
          </a>
        ))
      }
    </div>
  </div>

  <div class="web-hero__visual">
    <h2 class="web-hero__themes-title" id={WEB_HERO_IDS.themes}>{themeCount} themes, one engine</h2>
    <ul class="web-hero__themes" role="list">
      {
        themes.map((theme) => (
          <li
            class="web-hero__theme"
            data-tx-hero-theme={theme.id}
            style={`--swatch-background: ${theme.swatches.background}; --swatch-foreground: ${theme.swatches.foreground}; --swatch-primary: ${theme.swatches.primary}; --swatch-primary-foreground: ${theme.swatches.primaryForeground}; --swatch-accent: ${theme.swatches.accent};`}
          >
            <span class="web-hero__theme-name">{theme.name}</span>
            <span class="web-hero__chips" aria-hidden="true">
              <span class="hero-chip hero-chip--text">Aa</span>
              <span class="hero-chip hero-chip--primary" />
              <span class="hero-chip hero-chip--accent" />
            </span>
          </li>
        ))
      }
    </ul>
    <p class="web-hero__caption">{WEB_HERO_GRID_CAPTION}</p>
    <p class="web-hero__grid-links">
      {
        WEB_HERO_GRID_LINKS.map((link) => (
          <a href={resolveHref(link.href)}>{link.label}</a>
        ))
      }
    </p>
  </div>
</section>

<style>
  .web-hero {
    display: grid;
    gap: clamp(1.5rem, 4vw, 2.5rem);
    max-inline-size: 72rem;
    margin-inline: auto;
    padding-block: clamp(1.25rem, 4vw, 2.5rem) clamp(2rem, 5vw, 3.5rem);
    padding-inline: clamp(1rem, 4vw, 1.5rem);
  }
  @media (min-width: 56rem) {
    .web-hero {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
      align-items: center;
    }
  }
  .web-hero__copy {
    display: grid;
    gap: 1rem;
    max-inline-size: 36rem;
  }
  .web-hero__eyebrow {
    margin: 0;
    color: var(--tx-muted-foreground);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .web-hero h1 {
    margin: 0;
    color: var(--tx-foreground);
    font-size: clamp(2.5rem, 8.5vw, 4.5rem);
    line-height: 1.02;
    letter-spacing: -0.03em;
    font-weight: 750;
    text-wrap: balance;
  }
  .web-hero__sub {
    margin: 0;
    max-inline-size: 34rem;
    color: var(--tx-foreground);
    font-size: clamp(1rem, 2.4vw, 1.15rem);
    line-height: 1.5;
  }
  .web-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-block-start: 0.35rem;
  }
  .web-hero__cta {
    display: inline-block;
    border: 1px solid var(--tx-border);
    border-radius: var(--tx-radius, 0.5rem);
    padding-block: 0.6rem;
    padding-inline: 1.1rem;
    font-weight: 600;
    text-decoration: none;
  }
  .web-hero__cta--primary {
    background: var(--tx-foreground);
    border-color: var(--tx-foreground);
    color: var(--tx-background);
  }
  .web-hero__cta--primary:hover {
    background: color-mix(in oklab, var(--tx-foreground) 88%, var(--tx-background));
    color: var(--tx-background);
  }
  .web-hero__cta--secondary {
    background: transparent;
    color: var(--tx-foreground);
  }
  .web-hero__cta--secondary:hover {
    background: color-mix(in oklab, var(--tx-muted) 45%, var(--tx-background));
  }
  .web-hero__cta:focus-visible {
    outline: 2px solid var(--tx-ring);
    outline-offset: 2px;
  }
  .web-hero__visual {
    display: grid;
    gap: 0.75rem;
    min-inline-size: 0;
  }
  .web-hero__themes-title {
    margin: 0;
    color: var(--tx-muted-foreground);
    font-size: 0.95rem;
    font-weight: 650;
  }
  .web-hero__themes {
    display: grid;
    gap: 0.6rem;
    margin: 0;
    padding: 0;
    list-style: none;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 9.5rem), 1fr));
  }
  .web-hero__theme {
    display: grid;
    gap: 0.5rem;
    align-content: space-between;
    border: 1px solid var(--tx-border);
    border-radius: var(--tx-radius, 0.5rem);
    padding: 0.6rem;
    background: var(--swatch-background);
    color: var(--swatch-foreground);
    min-inline-size: 0;
  }
  .web-hero__theme-name {
    font-size: 0.85rem;
    font-weight: 650;
    overflow-wrap: anywhere;
  }
  .web-hero__chips {
    display: flex;
    gap: 0.35rem;
  }
  .hero-chip {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    inline-size: 1.6rem;
    block-size: 1.6rem;
    border-radius: 0.35rem;
    border: 1px solid color-mix(in oklab, var(--swatch-foreground) 25%, transparent);
    font-size: 0.7rem;
    font-weight: 650;
  }
  .hero-chip--text {
    background: var(--swatch-background);
    color: var(--swatch-foreground);
  }
  .hero-chip--primary {
    background: var(--swatch-primary);
    color: var(--swatch-primary-foreground);
  }
  .hero-chip--accent {
    background: var(--swatch-accent);
  }
  .web-hero__caption {
    margin: 0;
    color: var(--tx-muted-foreground);
    font-size: 0.85rem;
    line-height: 1.5;
  }
  .web-hero__grid-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    margin: 0;
    font-size: 0.9rem;
  }
  .web-hero__grid-links a {
    color: var(--tx-primary);
    text-decoration-thickness: from-font;
    text-underline-offset: 0.2em;
  }
  .web-hero__grid-links a:focus-visible {
    outline: 2px solid var(--tx-ring);
    outline-offset: 2px;
    border-radius: 2px;
  }
  @media (max-width: 22.5rem) {
    .web-hero__themes {
      grid-template-columns: 1fr;
    }
  }
  @media (forced-colors: active) {
    .web-hero__theme,
    .hero-chip {
      border-color: CanvasText;
    }
  }
</style>
