---
/**
 * Home 2.2 hero (PLAN_015 T-home-hero): an eyebrow, the pinned accent h1, a
 * short subhead, a platform status line (Web available, Native in
 * development), three calls to action (Explore solutions, Explore native,
 * Get started), the install line, the computed proof row and the eager
 * `home-hero` illustration. Static markup with no client island (ADR-030
 * keeps the home static). Copy lives in `hero-content.ts`. Every link
 * resolves through the URL policy (`safeHref`, developer tier, because
 * these are app-authored routes). Wiring it into `src/pages/index.astro`
 * belongs to the home integration task.
 */
import { safeHref } from '@texuli/core/url-policy';
import { withBase } from '../../../foundation/site.ts';
import SiteIllustration from '../../../landing/SiteIllustration.astro';
import CopyCommand from '../CopyCommand.astro';
import { HOME_HERO, HOME_INSTALL_COMMAND, loadHomeHeroProof } from '../home-content.ts';
import { HERO_22, HERO_22_IDS } from './hero-content.ts';

const base = import.meta.env.BASE_URL;
const proof = await loadHomeHeroProof();
const resolveHref = (href: string): string | undefined => {
  const safe = safeHref(href, 'developer');
  return safe === undefined ? undefined : withBase(base, safe);
};
---

<section class="hero22" aria-labelledby={HERO_22_IDS.heading} data-tx-home-hero="">
  <div class="hero22__inner">
    <div class="hero22__copy">
      <p class="hero22__eyebrow" data-tx-hero-eyebrow="">
        {
          HERO_22.eyebrow.map((item, index) => (
            <>
              {index > 0 && <span class="hero22__sep" aria-hidden="true"> · </span>}
              <span>{item}</span>
            </>
          ))
        }
      </p>
      <h1 id={HERO_22_IDS.heading}>
        {HERO_22.title.lead}{' '}
        <span class="hero22__accent">{HERO_22.title.accent}</span>
      </h1>
      <p class="hero22__sub">{HERO_22.sub}</p>
      <ul class="hero22__status" role="list" id={HERO_22_IDS.status} aria-label={HERO_22.statusLabel}>
        {
          HERO_22.status.map((row) => (
            <li class="hero22__status-item" data-tx-hero-status={row.id} data-status={row.status}>
              <span class="hero22__dot" aria-hidden="true" />
              <span class="hero22__platform">{row.platform}:</span> <span>{row.status}</span>
            </li>
          ))
        }
      </ul>
      <div class="hero22__actions">
        {
          HERO_22.actions.map((link) => (
            <a
              href={resolveHref(link.href)}
              class={`home-cta home-cta--${link.role}`}
              data-tx-hero-action={link.role}
            >
              {link.label}
              {link.role === 'text' && <span aria-hidden="true">&nbsp;→</span>}
            </a>
          ))
        }
      </div>
      <CopyCommand command={HOME_INSTALL_COMMAND} />
      <ul class="hero22__proof" role="list" aria-label={HOME_HERO.proofLabel}>
        {
          proof.map((stat) => (
            <li data-tx-hero-proof={stat.id}>
              <a class="hero22__stat" href={resolveHref(stat.href)}>
                <span class="hero22__stat-value">{stat.value}</span>{' '}
                <span class="hero22__stat-label">{stat.label}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
    <div class="hero22__art">
      <SiteIllustration art="home-hero" />
    </div>
  </div>
</section>

<style>
  .hero22 {
    background: var(--home-ground);
    border-block-end: 1px solid color-mix(in oklab, var(--tx-border) 60%, transparent);
  }
  .hero22__inner {
    display: grid;
    gap: clamp(1.5rem, 4vw, 3rem);
    max-inline-size: 76rem;
    margin-inline: auto;
    padding-block: clamp(2rem, 6vw, 4.5rem);
    padding-inline: clamp(1rem, 4vw, 1.5rem);
  }
  @media (min-width: 60rem) {
    .hero22__inner {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
      align-items: center;
      min-block-size: min(46rem, calc(100svh - 4rem));
    }
  }
  .hero22__copy {
    display: grid;
    gap: 1.25rem;
    justify-items: start;
    max-inline-size: 36rem;
    min-inline-size: 0;
  }
  .hero22__eyebrow {
    margin: 0;
    padding-block: 0.3rem;
    padding-inline: 0.85rem;
    border: 1px solid color-mix(in oklab, var(--home-accent) 35%, transparent);
    border-radius: 999px;
    background: color-mix(in oklab, var(--home-accent) 8%, var(--tx-background));
    color: var(--tx-foreground);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.02em;
  }
  .hero22__sep {
    color: var(--home-accent-text);
  }
  .hero22 h1 {
    margin: 0;
    color: var(--tx-foreground);
    font-size: clamp(2.75rem, 9vw, 5.25rem);
    line-height: 1;
    letter-spacing: -0.035em;
    font-weight: 800;
    text-wrap: balance;
  }
  .hero22__accent {
    color: var(--home-accent-text);
  }
  .hero22__sub {
    margin: 0;
    color: var(--tx-muted-foreground);
    font-size: clamp(1.05rem, 2.4vw, 1.25rem);
    line-height: 1.5;
  }
  .hero22__status {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
    color: var(--tx-foreground);
    font-size: 0.9rem;
  }
  .hero22__status-item {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .hero22__platform {
    font-weight: 700;
  }
  .hero22__dot {
    inline-size: 0.55rem;
    block-size: 0.55rem;
    border-radius: 999px;
    background: var(--tx-success, var(--home-accent));
  }
  .hero22__status-item[data-status='in development'] .hero22__dot {
    background: transparent;
    border: 2px solid var(--home-accent-text);
  }
  .hero22__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
  }
  .hero22__proof {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.75rem;
    inline-size: 100%;
    margin: 0;
    padding: 0;
    padding-block-start: 1.1rem;
    border-block-start: 1px solid color-mix(in oklab, var(--tx-border) 80%, transparent);
    list-style: none;
  }
  .hero22__stat {
    display: grid;
    gap: 0.1rem;
    min-block-size: 2.75rem;
    border-radius: 0.375rem;
    color: var(--tx-foreground);
    text-decoration: none;
  }
  .hero22__stat-value {
    font-size: clamp(1.4rem, 4vw, 1.9rem);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
  }
  .hero22__stat-label {
    color: var(--tx-muted-foreground);
    font-size: 0.85rem;
  }
  .hero22__stat:hover .hero22__stat-label {
    color: var(--tx-foreground);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .hero22__stat:focus-visible {
    outline: 2px solid var(--tx-ring);
    outline-offset: 2px;
  }
  .hero22__art {
    min-inline-size: 0;
  }
  @media (max-width: 30rem) {
    .hero22__proof {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .hero22__actions :global(.home-cta--primary),
    .hero22__actions :global(.home-cta--secondary) {
      flex: 1 1 100%;
      text-align: center;
    }
  }
</style>
