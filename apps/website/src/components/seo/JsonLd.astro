---
/**
 * Structured data as an inline JSON-LD block (T-18). Data arrives
 * type-checked from the schema module (code-authored constants — never
 * page data or agent output) and is serialized once at build time. The CSP
 * integration hashes every inline script in the built HTML, so the block
 * is budgeted like the rest — `check:csp` proves coverage.
 * `serializeJsonLd` escapes `<`, `>`, `&`, U+2028 and U+2029 so no string
 * in the data can close the element (S-7).
 */
import { serializeJsonLd } from './json-ld.ts';

interface Props {
  /** A schema.org object, or an array of them; serialized as-is. */
  data: Record<string, unknown>;
}

const { data } = Astro.props;
---

<script is:inline type="application/ld+json" set:html={serializeJsonLd(data)} />
