---
/**
 * Search and social metadata for one page (T-site-seo): canonical URL,
 * Open Graph, a large-image card and the page's own social image, built at
 * compile time by the SEO integration (`/og/<page>.png`), plus env-gated
 * search-engine verification metas (rendered only when the owner's token
 * exists). `noindex` keeps a page (the 404) out of search results and the
 * sitemap. Every page also links the agentic resource discovery catalog
 * (`rel="ai-catalog"`), the same target as its `Link` response header.
 */
import { ANALYTICS } from '../../lib/constances';
import { DISCOVERY_PATHS } from './agent-discovery.ts';
import {
  absoluteUrl,
  normalizePagePath,
  OG_IMAGE_HEIGHT,
  OG_IMAGE_WIDTH,
  ogImageFile,
} from './seo.ts';

interface Props {
  /** The full document title (`Page · Texuli`). */
  title: string;
  description: string;
  siteName: string;
  lang?: string;
  noindex?: boolean;
}

const { title, description, siteName, lang = 'en', noindex = false } = Astro.props;
const site = Astro.site;
const base = import.meta.env.BASE_URL;
const pagePath = normalizePagePath(Astro.url.pathname, base);
const canonical = site ? absoluteUrl(site, base, pagePath) : undefined;
const image = site && !noindex ? absoluteUrl(site, base, ogImageFile(pagePath)) : undefined;
// Root-relative (plus the base): a few bytes on every page, same target as the header.
const aiCatalog = `${base.replace(/\/$/, '')}${DISCOVERY_PATHS.aiCatalog}`;
const locale = lang.replace('-', '_');
// Env-gated (constances.ts): empty tokens render no meta at all.
const { google, bing } = ANALYTICS.verification;
---

{canonical && !noindex && <link rel="canonical" href={canonical} />}
{noindex && <meta name="robots" content="noindex" />}
<link rel="ai-catalog" href={aiCatalog} />
<meta property="og:type" content="website" />
<meta property="og:site_name" content={siteName} />
<meta property="og:locale" content={locale === 'en' ? 'en_US' : locale} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{canonical && <meta property="og:url" content={canonical} />}
{image && <meta property="og:image" content={image} />}
{image && <meta property="og:image:type" content="image/png" />}
{image && <meta property="og:image:width" content={String(OG_IMAGE_WIDTH)} />}
{image && <meta property="og:image:height" content={String(OG_IMAGE_HEIGHT)} />}
{image && <meta property="og:image:alt" content={title} />}
<meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
{image && <meta name="twitter:image" content={image} />}
{image && <meta name="twitter:image:alt" content={title} />}
{google && <meta name="google-site-verification" content={google} />}
{bing && <meta name="msvalidate.01" content={bing} />}
