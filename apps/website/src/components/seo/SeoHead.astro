---
/**
 * Search and social metadata for one page (T-site-seo): canonical URL,
 * Open Graph, a large-image card and the page's own social image, built at
 * compile time by the SEO integration (`/og/<page>.png`). `noindex` keeps
 * a page (the 404) out of search results and the sitemap.
 */
import {
  absoluteUrl,
  normalizePagePath,
  OG_IMAGE_HEIGHT,
  OG_IMAGE_WIDTH,
  ogImageFile,
} from './seo.ts';

interface Props {
  /** The full document title (`Page · Texuli`). */
  title: string;
  description: string;
  siteName: string;
  lang?: string;
  noindex?: boolean;
}

const { title, description, siteName, lang = 'en', noindex = false } = Astro.props;
const site = Astro.site;
const base = import.meta.env.BASE_URL;
const pagePath = normalizePagePath(Astro.url.pathname, base);
const canonical = site ? absoluteUrl(site, base, pagePath) : undefined;
const image = site && !noindex ? absoluteUrl(site, base, ogImageFile(pagePath)) : undefined;
const locale = lang.replace('-', '_');
---

{canonical && !noindex && <link rel="canonical" href={canonical} />}
{noindex && <meta name="robots" content="noindex" />}
<meta property="og:type" content="website" />
<meta property="og:site_name" content={siteName} />
<meta property="og:locale" content={locale === 'en' ? 'en_US' : locale} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{canonical && <meta property="og:url" content={canonical} />}
{image && <meta property="og:image" content={image} />}
{image && <meta property="og:image:type" content="image/png" />}
{image && <meta property="og:image:width" content={String(OG_IMAGE_WIDTH)} />}
{image && <meta property="og:image:height" content={String(OG_IMAGE_HEIGHT)} />}
{image && <meta property="og:image:alt" content={title} />}
<meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
{image && <meta name="twitter:image" content={image} />}
{image && <meta name="twitter:image:alt" content={title} />}
