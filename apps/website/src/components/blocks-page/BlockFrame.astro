---
import { Code, CopyButton } from 'texuli/kbd-code';
import { addCommand, blockPath, type PageBlock } from './blocks.ts';
import SourceCopyButton from './SourceCopyButton.svelte';

/**
 * One block on the blocks page: the live preview, the `texuli add` command
 * and the exact source, each copyable.
 */
interface Props {
  block: PageBlock;
  source: string;
  /** On the block's own page the preview is the content; no link back to itself. */
  standalone?: boolean;
}

const { block, source, standalone = false } = Astro.props;
const command = addCommand(block);
const titleId = `block-${block.id}-title`;
const sourceId = `block-${block.id}-source`;
---

<section class="block" id={`block-${block.id}`} aria-labelledby={titleId} data-block={block.id}>
  {
    !standalone && (
      <header class="block__header">
        <h2 id={titleId}>{block.title}</h2>
        <p class="block__description">{block.description}</p>
        <a class="block__link" href={blockPath(block.id)}>
          Open the {block.title.toLowerCase()} template
        </a>
      </header>
    )
  }
  {standalone && <h2 id={titleId} class="block__sr-only">Preview, install and source</h2>}
  <div class="block__preview" role="region" aria-label={`${block.title} preview`}>
    <slot />
  </div>
  <div class="block__install">
    <h3 class="block__label">Install</h3>
    {
      command ? (
        <div class="block__row">
          <Code value={command} variant="block" />
          <CopyButton client:load value={command} label={`Copy the ${block.title} install command`} />
        </div>
      ) : (
        <p class="block__note">Nothing to add: plain markup on Texuli tokens.</p>
      )
    }
  </div>
  <details class="block__source">
    <summary>Source: {block.file}</summary>
    <div class="block__row">
      <SourceCopyButton client:idle {sourceId} label={`Copy the ${block.title} source`} />
    </div>
    <!-- Long lines scroll here: a focusable, named region keyboard users can scroll (WCAG 2.1.1). -->
    <div
      class="block__code"
      id={sourceId}
      role="region"
      aria-label={`${block.title} source code`}
      tabindex="0"
    >
      <Code value={source} variant="block" language="svelte" />
    </div>
  </details>
</section>

<style>
  .block {
    display: grid;
    gap: 1rem;
    padding-block: 1.5rem;
    border-block-start: var(--tx-border-width, 1px) solid var(--tx-border, currentColor);
  }
  .block__header {
    display: grid;
    gap: 0.375rem;
  }
  h2 {
    margin: 0;
    font-size: 1.5rem;
  }
  .block__description,
  .block__note {
    margin: 0;
    color: var(--tx-muted-foreground, GrayText);
  }
  .block__link {
    color: var(--tx-link, LinkText);
    justify-self: start;
  }
  .block__preview {
    min-inline-size: 0;
    padding: clamp(0.75rem, 3vw, 1.5rem);
    border: var(--tx-border-width, 1px) dashed var(--tx-border-strong, currentColor);
    border-radius: var(--tx-radius-lg, 0.75rem);
    background: var(--tx-background, Canvas);
  }
  .block__install {
    display: grid;
    gap: 0.5rem;
  }
  .block__label {
    margin: 0;
    font-size: 1rem;
  }
  .block__row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    min-inline-size: 0;
  }
  .block__source {
    min-inline-size: 0;
  }
  .block__source summary {
    cursor: pointer;
    font-weight: 600;
  }
  .block__source[open] summary {
    margin-block-end: 0.5rem;
  }
  .block__code {
    max-inline-size: 100%;
    overflow-x: auto;
    border-radius: var(--tx-radius, 0.5rem);
  }
  .block__code :global(.tx-code--block) {
    overflow: visible;
    inline-size: max-content;
    min-inline-size: 100%;
  }
  .block__code:focus-visible {
    outline: var(--tx-focus-ring-width, 2px) solid var(--tx-ring, Highlight);
    outline-offset: 2px;
  }
  .block__sr-only {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .block__link:focus-visible,
  .block__source summary:focus-visible {
    outline: var(--tx-focus-ring-width, 2px) solid var(--tx-ring, Highlight);
    outline-offset: 2px;
  }
</style>
