---
/**
 * Docs page chrome: static sidebar, mobile details menu, TOC, previous/next.
 * Edit-free (no third-party edit links). Fully static except the site theme switch.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { isDocsPath } from '../foundation/nav-data.ts';
import DocsMobileNav from './DocsMobileNav.astro';
import DocsPager from './DocsPager.astro';
import DocsSidebar from './DocsSidebar.astro';
import DocsToc from './DocsToc.astro';
import { docsPager, type TocEntry } from './nav.ts';

interface Props {
  title: string;
  description: string;
  toc?: readonly TocEntry[];
  /** Optional JSON-LD graph, passed through to `BaseLayout` (T-52 TechArticle). */
  jsonLd?: Record<string, unknown>;
  /**
   * Render the docs-shell demo navigation (the sidebar and the phone
   * "Documentation menu" over `DOCS_SECTIONS`). Pages outside the demo
   * area turn it off: they already sit in the site's Primary sidebar, and
   * a second "Documentation" landmark without their page in it misleads
   * screen-reader and keyboard users (T-90).
   */
  demoNav?: boolean;
}

const { title, description, toc = [], jsonLd = undefined, demoNav = true } = Astro.props;
const base = import.meta.env.BASE_URL;
const current = Astro.url.pathname.slice(base.replace(/\/+$/, '').length) || '/';
const { prev, next } = docsPager(current);
/**
 * BaseLayout renders its own "On this page" (PageToc, 80rem and up) on
 * docs-layout paths; at that width the shell yields its side column so a
 * page never shows two such navigations (PLAN_006 P2-3).
 */
const layoutPageToc = isDocsPath(current);
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <div class="docs-shell" data-tx-docs-shell="">
    {demoNav && <DocsMobileNav currentPath={current} />}
    <div
      class:list={[
        'docs-shell__grid',
        !demoNav && 'docs-shell__grid--no-demo-nav',
        layoutPageToc && 'docs-shell__grid--page-toc',
      ]}
    >
      {demoNav && <DocsSidebar currentPath={current} />}
      <div class="docs-shell__main">
        <article class="docs-article" data-tx-docs-article="">
          <header class="docs-article__header">
            <p class="docs-article__eyebrow">Documentation</p>
            <h1>{title}</h1>
            <p class="docs-article__lead">{description}</p>
          </header>
          {
            toc.length > 0 && (
              <div class="docs-article__toc-mobile">
                <DocsToc entries={toc} titleId="docs-toc-title-mobile" />
              </div>
            )
          }
          <div class="docs-article__body">
            <slot />
          </div>
          <DocsPager prev={prev} next={next} />
        </article>
      </div>
      {
        toc.length > 0 && (
          <div class="docs-shell__toc">
            <DocsToc entries={toc} titleId="docs-toc-title-desktop" />
          </div>
        )
      }
    </div>
  </div>
</BaseLayout>

<style>
  /* The site column already provides the page gutter: no bleed past it. */
  .docs-shell {
    margin-inline: 0;
  }
  .docs-shell__grid {
    display: grid;
    gap: 1.25rem;
  }
  /* Base rule first: the media queries below must win the cascade. */
  .docs-shell__toc {
    display: none;
  }
  @media (min-width: 64rem) {
    .docs-shell__grid {
      grid-template-columns: 14rem minmax(0, 1fr) 13rem;
      align-items: start;
    }
    .docs-shell__grid--no-demo-nav {
      grid-template-columns: minmax(0, 1fr) 13rem;
    }
    .docs-shell__toc {
      display: block;
    }
    .docs-article__toc-mobile {
      display: none;
    }
  }
  /* Docs-layout pages: BaseLayout's PageToc owns "On this page" from 80rem
     (its breakpoint), so the shell drops its TOC column there. */
  @media (min-width: 80rem) {
    .docs-shell__grid--page-toc {
      grid-template-columns: 14rem minmax(0, 1fr);
    }
    .docs-shell__grid--page-toc.docs-shell__grid--no-demo-nav {
      grid-template-columns: minmax(0, 1fr);
    }
    .docs-shell__grid--page-toc .docs-shell__toc {
      display: none;
    }
  }
  .docs-article__header {
    margin-block-end: 1.25rem;
  }
  .docs-article__eyebrow {
    margin: 0 0 0.35rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--tx-foreground);
  }
  .docs-article h1 {
    margin: 0;
    font-size: clamp(1.75rem, 4vw, 2.25rem);
    line-height: 1.2;
    color: var(--tx-foreground);
  }
  .docs-article__lead {
    margin: 0.5rem 0 0;
    color: var(--tx-foreground);
    font-size: 1.0625rem;
  }
  .docs-article__body :global(h2) {
    margin-block: 1.75rem 0.5rem;
    font-size: 1.25rem;
    color: var(--tx-foreground);
    scroll-margin-block-start: 1rem;
  }
  .docs-article__body :global(h3) {
    margin-block: 1.25rem 0.35rem;
    font-size: 1.05rem;
    color: var(--tx-foreground);
    scroll-margin-block-start: 1rem;
  }
  .docs-article__body :global(p),
  .docs-article__body :global(li) {
    color: var(--tx-foreground);
  }
  .docs-article__body :global(ul) {
    padding-inline-start: 1.25rem;
  }
  .docs-article__toc-mobile {
    margin-block: 0 1.25rem;
  }
</style>
