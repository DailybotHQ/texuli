---
/**
 * Mobile docs navigation without a client island: native details/summary.
 * Desktop sidebar is shown from 64rem up; this block is hidden there.
 */
import { withBase } from '../foundation/site.ts';
import { DOCS_SECTIONS, type DocsNavSection, normalizeDocsPath } from './nav.ts';

interface Props {
  currentPath: string;
  label?: string;
  /** Override the default docs-shell tree (guides, catalog sections, …). */
  sections?: readonly DocsNavSection[];
  /** Accessible name for the nested nav landmark. */
  navLabel?: string;
}

const {
  currentPath,
  label = 'Documentation menu',
  sections = DOCS_SECTIONS,
  navLabel = 'Documentation',
} = Astro.props;
const base = import.meta.env.BASE_URL;
const here = normalizeDocsPath(currentPath);
---

<details class="docs-mobile" data-tx-docs-mobile-nav="">
  <summary class="docs-mobile__summary">{label}</summary>
  <nav class="docs-mobile__nav" aria-label={navLabel}>
    {
      sections.map((section) => (
        <div class="docs-mobile__section">
          <p class="docs-mobile__heading">{section.label}</p>
          <ul>
            {section.items.map((item) => {
              const active = normalizeDocsPath(item.href) === here;
              return (
                <li>
                  <a
                    href={withBase(base, item.href)}
                    aria-current={active ? 'page' : undefined}
                  >
                    {item.label}
                  </a>
                </li>
              );
            })}
          </ul>
        </div>
      ))
    }
  </nav>
</details>

<style>
  .docs-mobile {
    display: block;
    margin-block-end: 0.75rem;
    border: 1px solid var(--tx-border);
    border-radius: var(--tx-radius, 0.5rem);
    background: var(--tx-background);
    color: var(--tx-foreground);
  }
  @media (min-width: 64rem) {
    .docs-mobile {
      display: none;
    }
  }
  .docs-mobile__summary {
    display: flex;
    align-items: center;
    min-block-size: 2.75rem;
    padding-inline: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    list-style: none;
  }
  .docs-mobile__summary::-webkit-details-marker {
    display: none;
  }
  .docs-mobile__summary:focus-visible {
    outline: 2px solid var(--tx-ring);
    outline-offset: 2px;
  }
  .docs-mobile__nav {
    display: grid;
    gap: 1rem;
    padding: 0.5rem 0.85rem 0.85rem;
    border-block-start: 1px solid var(--tx-border);
  }
  .docs-mobile__heading {
    margin: 0 0 0.25rem;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .docs-mobile ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.15rem;
  }
  .docs-mobile a {
    display: flex;
    align-items: center;
    min-block-size: 2.5rem;
    padding-inline: 0.5rem;
    border-radius: var(--tx-radius, 0.375rem);
    color: var(--tx-foreground);
    text-decoration: none;
  }
  .docs-mobile a[aria-current='page'] {
    background: var(--tx-primary);
    color: var(--tx-primary-foreground);
    font-weight: 600;
  }
  .docs-mobile a:focus-visible {
    outline: 2px solid var(--tx-ring);
    outline-offset: 2px;
  }
  @media (forced-colors: active) {
    .docs-mobile {
      border-color: ButtonText;
      forced-color-adjust: none;
    }
    .docs-mobile a[aria-current='page'] {
      outline: 2px solid Highlight;
      background: SelectedItem;
      color: SelectedItemText;
    }
  }
</style>
