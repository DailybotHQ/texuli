---
/**
 * The Slides landing hero: the shared SolutionHero with the slides registry entry and
 * the copy in `hero-content.ts`. The art is the entry's `solution-slides-hero` plate; until
 * that slot and its WebP land, the hero paints the texel mosaic. The `page-slides` banner
 * (3:1) is not reused here: the hero column is a 6:5 plate and a banner would letterbox.
 */
import { getSolution } from '../../../../data/solutions/index.ts';
import SolutionHero from '../../shared/hero/SolutionHero.astro';
import { SLIDES_HERO } from './hero-content.ts';

const entry = getSolution('slides');
---

<SolutionHero entry={entry} {...SLIDES_HERO} />
