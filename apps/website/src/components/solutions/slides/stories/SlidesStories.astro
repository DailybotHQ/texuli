---
/**
 * The Slides signature stories: the shared SolutionStories block with the slides registry
 * entry and the copy in `stories-content.ts`. The first three stories use their own
 * `solution-slides-story-1..3` plates (the texel mosaic paints until the WebPs land); the
 * export story reuses the `page-slides` illustration. Every claim is backed by
 * `SLIDES_STORY_EVIDENCE`, which the unit test checks against the repository.
 */
import { getSolution } from '../../../../data/solutions/index.ts';
import SolutionStories from '../../shared/story/SolutionStories.astro';
import { SLIDES_STORIES } from './stories-content.ts';

const entry = getSolution('slides');
---

<SolutionStories entry={entry} {...SLIDES_STORIES} />
