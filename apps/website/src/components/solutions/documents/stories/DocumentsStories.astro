/**
 * The Documents signature stories: the shared SolutionStories block with the documents
 * registry entry and the copy in `stories-content.ts`. Each story paints its reserved
 * `solution-documents-story-<n>` art (the texel mosaic until the WebP lands). Every claim is backed
 * by `DOCUMENTS_STORY_EVIDENCE`, which the unit test checks against the repository.
 */
import { getSolution } from '../../../../data/solutions/index.ts';
import SolutionStories from '../../shared/story/SolutionStories.astro';
import { DOCUMENTS_STORIES } from './stories-content.ts';

const entry = getSolution('documents');
---

<SolutionStories entry={entry} {...DOCUMENTS_STORIES} />
