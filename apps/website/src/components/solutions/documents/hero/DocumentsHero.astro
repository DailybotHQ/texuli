---
/**
 * The Documents landing hero: the shared SolutionHero with the documents registry entry
 * and the copy in `hero-content.ts`. The art is the entry's `solution-documents-hero`
 * plate; until that slot and its WebP land, the hero paints the texel mosaic. The
 * `page-documents` banner (3:1) is not reused here: the hero column is a 6:5 plate and a
 * banner would letterbox.
 */
import { getSolution } from '../../../../data/solutions/index.ts';
import SolutionHero from '../../shared/hero/SolutionHero.astro';
import { DOCUMENTS_HERO } from './hero-content.ts';

const entry = getSolution('documents');
---

<SolutionHero entry={entry} {...DOCUMENTS_HERO} />
