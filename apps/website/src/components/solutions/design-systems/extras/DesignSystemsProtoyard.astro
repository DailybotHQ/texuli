---
/**
 * "Built on it: Protoyard" (slot 08): copy beside the `solution-design-systems-protoyard`
 * plate (texel fallback until its file lands). No Protoyard numbers without a public source;
 * the band links Protoyard's own site and its Built with page. Static markup; every href
 * passes the URL policy (developer tier).
 */
import { safeHref } from '@texuli/core/url-policy';
import { withBase } from '../../../foundation/site.ts';
import SiteIllustration from '../../../landing/SiteIllustration.astro';
import TexelMark from '../../../sections/home/TexelMark.astro';
import { DESIGN_SYSTEMS_PROTOYARD as band } from './extras-content.ts';

const base = import.meta.env.BASE_URL;
const headingId = `ds-${band.id}-heading`;
const links = band.links.flatMap((link) => {
  const safe = safeHref(link.href, 'developer');
  if (safe === undefined) return [];
  const external = /^https:/i.test(safe);
  return [{ label: link.label, href: external ? safe : withBase(base, safe), external }];
});
---

<section class="ds-protoyard" aria-labelledby={headingId} data-tx-ds-protoyard="">
  <div class="ds-protoyard__inner">
    <div class="ds-protoyard__copy">
      <p class="ds-protoyard__eyebrow"><TexelMark count={2} /><span>Built with Texuli</span></p>
      <h2 id={headingId}>{band.title}</h2>
      <p>{band.body}</p>
      <ul class="ds-protoyard__links" role="list">
        {
          links.map((link, index) => (
            <li>
              <a
                href={link.href}
                class:list={['ds-protoyard__cta', index === 0 ? 'ds-protoyard__cta--primary' : 'ds-protoyard__cta--text']}
                rel={link.external ? 'noopener' : undefined}
                data-tx-ds-protoyard-link={link.external ? 'external' : 'internal'}
              >
                {link.label}
                {index > 0 && <span aria-hidden="true">&nbsp;→</span>}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
    <div class="ds-protoyard__art">
      <SiteIllustration art={band.art} />
    </div>
  </div>
</section>

<style>
  .ds-protoyard {
    padding-block: clamp(3rem, 8vw, 6rem) 0;
    padding-inline: 1.25rem;
  }
  .ds-protoyard__inner {
    display: grid;
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: center;
    max-inline-size: 72rem;
    margin-inline: auto;
  }
  @media (min-width: 52rem) {
    .ds-protoyard__inner {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
    }
  }
  .ds-protoyard__copy {
    display: grid;
    gap: 1rem;
    min-inline-size: 0;
  }
  .ds-protoyard__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    color: var(--home-accent-text, var(--tx-foreground));
    font-weight: 650;
    font-size: 0.875rem;
  }
  .ds-protoyard h2 {
    margin: 0;
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    line-height: 1.15;
    letter-spacing: -0.01em;
  }
  .ds-protoyard p {
    margin: 0;
  }
  .ds-protoyard__links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.25rem;
    margin: 0.5rem 0 0;
    padding: 0;
    list-style: none;
  }
  .ds-protoyard__cta {
    display: inline-flex;
    align-items: center;
    min-block-size: 2.75rem;
    font-weight: 650;
    text-decoration: none;
    color: var(--tx-foreground);
  }
  .ds-protoyard__cta--primary {
    padding-inline: 1.25rem;
    border-radius: 999px;
    background: var(--home-accent, var(--tx-primary));
    color: var(--home-accent-ink, var(--tx-primary-foreground));
  }
  .ds-protoyard__cta--text {
    color: var(--home-accent-text, var(--tx-foreground));
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .ds-protoyard__cta:focus-visible {
    outline: 2px solid var(--tx-ring);
    outline-offset: 2px;
  }
  .ds-protoyard__art {
    min-inline-size: 0;
  }
  @media (forced-colors: active) {
    .ds-protoyard__cta--primary {
      border: 1px solid ButtonText;
    }
  }
</style>
