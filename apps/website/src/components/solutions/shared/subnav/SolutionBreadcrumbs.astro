---
/**
 * Visible breadcrumbs for a Solution landing. Landings use BaseLayout's landing mode, which
 * draws no visible trail, so the layout draws it here from the same nav source
 * (`breadcrumbTrail`) that feeds the BreadcrumbList JSON-LD, with the ADR-031 fallback
 * (see `solutionBreadcrumbs`). Links resolve through the URL policy (developer tier).
 */
import { safeHref } from '@texuli/core/url-policy';
import type { SolutionEntry } from '../../../../data/solutions/schema.ts';
import { withBase } from '../../../foundation/site.ts';
import { breadcrumbTrail } from '../../../seo/breadcrumbs';
import { solutionBreadcrumbs } from './sections.ts';

interface Props {
  entry: SolutionEntry;
}

const { entry } = Astro.props;
const base = import.meta.env.BASE_URL;
const crumbs = solutionBreadcrumbs(entry, breadcrumbTrail(entry.route));
const resolveHref = (href: string): string | undefined => {
  const safe = safeHref(href, 'developer');
  return safe === undefined ? undefined : withBase(base, safe);
};
---

<nav class="solution-crumbs" aria-label="Breadcrumb" data-solution-crumbs="">
  <ol class="solution-crumbs__list">
    {
      crumbs.map((crumb, index) => (
        <li class="solution-crumbs__item">
          <a
            class="solution-crumbs__link"
            href={resolveHref(crumb.href)}
            aria-current={index === crumbs.length - 1 ? 'page' : undefined}
          >
            {crumb.name}
          </a>
          {index < crumbs.length - 1 && (
            <span class="solution-crumbs__sep" aria-hidden="true">
              /
            </span>
          )}
        </li>
      ))
    }
  </ol>
</nav>

<style>
  .solution-crumbs {
    max-inline-size: 76rem;
    margin-inline: auto;
    padding-block: 0.75rem 0;
    padding-inline: clamp(1rem, 4vw, 1.5rem);
  }
  .solution-crumbs__list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.125rem 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.8125rem;
  }
  .solution-crumbs__item {
    display: inline-flex;
    align-items: baseline;
    gap: 0.5rem;
  }
  .solution-crumbs__link {
    display: inline-flex;
    align-items: center;
    min-block-size: 1.5rem;
    color: var(--tx-muted-foreground);
    text-decoration-color: transparent;
  }
  .solution-crumbs__link:hover,
  .solution-crumbs__link[aria-current='page'] {
    color: var(--tx-foreground);
  }
  .solution-crumbs__link:hover {
    text-decoration: underline;
  }
  .solution-crumbs__link:focus-visible {
    outline: 2px solid var(--tx-ring);
    outline-offset: 2px;
  }
  .solution-crumbs__sep {
    color: var(--tx-muted-foreground);
    user-select: none;
  }
</style>
