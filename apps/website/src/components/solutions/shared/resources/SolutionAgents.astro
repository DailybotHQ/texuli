---
/**
 * SolutionAgents (`SolutionAgentsProps`, ADR-030): how agents reach a Solution. A title,
 * a short body and the surfaces (MCP tools, catalog components, skill paths), each with
 * its honest status. Static markup, no island, no HTML sinks.
 */
import type { SolutionAgentsProps } from '../types.ts';
import './resources.css';
import { agentsView } from './resources-model.ts';

type Props = SolutionAgentsProps;

const view = agentsView(Astro.props);
---

<section
  class="solution-res solution-agents"
  aria-labelledby={view.headingId}
  data-tx-solution-agents={Astro.props.entry.slug}
>
  <div class="solution-res__inner">
    <div class="solution-res__head">
      <h2 id={view.headingId}>{view.title}</h2>
      <p class="solution-res__lede">{view.body}</p>
    </div>
    {
      view.surfaces.length > 0 && (
        <ul class="solution-res__grid" role="list">
          {view.surfaces.map((surface) => (
            <li class="solution-res__card" data-tx-agent-surface="">
              <h3>
                <code>{surface.label}</code>
              </h3>
              <p>{surface.detail}</p>
              <p class="solution-res__status" data-status={surface.status}>
                <span class="solution-res__dot" aria-hidden="true" />
                <span class="solution-res__sr">Status: </span>
                {surface.status}
              </p>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</section>

<style>
  .solution-agents code {
    font-family: var(--tx-font-mono, ui-monospace, monospace);
    font-size: 0.92em;
    overflow-wrap: anywhere;
  }
</style>
