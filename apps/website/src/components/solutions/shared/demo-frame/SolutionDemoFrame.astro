---
/**
 * Static frame for one Solution demo. The page owns the lazy client island in
 * the `demo` slot; this component only supplies its accessible, SSR markup.
 */
import type { SolutionDemoFrameProps } from '../types.ts';

const { entry, title, tryThis, label } = Astro.props as SolutionDemoFrameProps;
const headingId = `solution-demo-${entry.slug}-heading`;
const previewId = `solution-demo-${entry.slug}-preview`;
const hasSource = Astro.slots.has('source');
---

<section
  class="solution-demo"
  aria-labelledby={headingId}
  data-tx-solution-demo={entry.slug}
  data-tx-demo-budget-probe={entry.slug}
>
  <header class="solution-demo__header">
    <h2 id={headingId}>{title}</h2>
    <div class="solution-demo__actions" role="group" aria-label="Demo actions">
      <slot name="actions" />
      {
        hasSource && (
          <details class="solution-demo__source">
            <summary>View source</summary>
            <div class="solution-demo__source-content">
              <slot name="source" />
            </div>
          </details>
        )
      }
    </div>
  </header>

  <div class="solution-demo__try" role="group" aria-label="Try this">
    <p class="solution-demo__try-title">Try this</p>
    <ul>
      {tryThis.map((action) => <li>{action}</li>)}
    </ul>
  </div>

  <p class="solution-demo__reset-hint">
    Use Reset to return to the starting example.
  </p>

  <div class="solution-demo__preview" id={previewId} role="region" aria-label={`${label} static preview`}>
    <slot name="preview" />
  </div>

  <div class="solution-demo__island" role="region" aria-label={label}>
    <slot name="demo" />
  </div>

  <noscript>
    <p class="solution-demo__fallback">
      JavaScript is unavailable, so the interactive demo cannot load. The static preview remains above.
    </p>
  </noscript>
  <slot name="error">
    <p class="solution-demo__fallback" role="status">
      If the interactive demo cannot load, use the static preview above.
    </p>
  </slot>
</section>

<style>
  /*
   * The band is full width (SolutionLayout); the frame sits in the landing's 76rem column
   * (73rem inside its 1.5rem gutters), centered, with the same side gutter on narrow screens.
   */
  /*
   * The site theme (enterprise-neutral) carries no categorical chart palette, so demo content
   * that colors by it (canvas sticky notes: yellow, purple and pink read --tx-chart-4..6)
   * fell back to the text color mixed into the surface: plain grey. The demos get one
   * palette in the landing's colors instead.
   */
  .solution-demo {
    --tx-chart-1: #6d4aff;
    --tx-chart-2: #0f9d8f;
    --tx-chart-3: #2f6fe0;
    --tx-chart-4: #e0a100;
    --tx-chart-5: #9b5de5;
    --tx-chart-6: #e0529c;
    --tx-chart-7: #ff8a4c;
    --tx-chart-8: #2f9e44;
  }
  .solution-demo {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1rem;
    box-sizing: border-box;
    inline-size: min(100% - 2 * clamp(1rem, 4vw, 1.5rem), 73rem);
    margin-inline: auto;
    min-inline-size: 0;
    padding: clamp(1rem, 3vw, 1.5rem);
    border: 1px solid var(--tx-border, GrayText);
    border-radius: var(--tx-radius, 0.75rem);
    color: var(--tx-foreground, CanvasText);
    background: var(--tx-surface, Canvas);
    scroll-behavior: auto;
  }

  .solution-demo__header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1rem;
  }

  h2,
  p {
    margin: 0;
  }

  /* The landing's section title scale (stories, how it works), so the demo reads as a band. */
  h2 {
    font-size: clamp(1.6rem, 3.6vw, 2.25rem);
    font-weight: 800;
    line-height: 1.12;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .solution-demo__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }

  .solution-demo__source summary {
    cursor: pointer;
  }

  .solution-demo__source-content {
    max-inline-size: 100%;
    overflow: auto;
  }

  .solution-demo__try,
  .solution-demo__preview,
  .solution-demo__island {
    min-inline-size: 0;
    max-inline-size: 100%;
  }

  /*
   * One view of the demo at a time. A demo marks its root [data-demo-live] once it shows the
   * live view (canvas, sheets and workflows render it on the server; slides and documents
   * after Start). The static preview, and the note that points to it, then step aside so the
   * same deck, report, board or table never shows twice.
   */
  .solution-demo:has(.solution-demo__island [data-demo-live]) > .solution-demo__preview,
  .solution-demo:has(.solution-demo__island [data-demo-live]) > .solution-demo__fallback {
    display: none;
  }

  .solution-demo__try-title {
    font-weight: 650;
  }

  .solution-demo__try ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin: 0.5rem 0 0;
    padding-inline-start: 1.25rem;
  }

  .solution-demo__reset-hint,
  .solution-demo__fallback {
    color: var(--tx-muted-foreground, GrayText);
    font-size: 0.875rem;
  }

  .solution-demo__preview,
  .solution-demo__island {
    padding: clamp(0.75rem, 2vw, 1.25rem);
    border: 1px solid var(--tx-border, GrayText);
    border-radius: var(--tx-radius, 0.5rem);
    background: var(--tx-background, Canvas);
  }

  @media (prefers-reduced-motion: reduce) {
    .solution-demo,
    .solution-demo * {
      scroll-behavior: auto;
    }
  }

  @media (forced-colors: active) {
    .solution-demo,
    .solution-demo__preview,
    .solution-demo__island {
      border-color: CanvasText;
    }
  }
</style>
