---
/**
 * Sheets landing hero: the shared static SolutionHero with the Sheets registry entry.
 * Its entry selects the `solution-sheets-hero` plate; the texel mosaic is the fallback
 * until the art slot is registered.
 */
import { getSolution } from '../../../../data/solutions/index.ts';
import SolutionHero from '../../shared/hero/SolutionHero.astro';
import { SHEETS_HERO } from './hero-content.ts';

const entry = getSolution('sheets');
---

<SolutionHero entry={entry} {...SHEETS_HERO} />
