---
/**
 * The slim sticky header, for global utilities only.
 *
 * - `docs` (every docs page): the menu button below 64rem (it opens the
 *   sidebar as a drawer whose code loads on first press), the Texuli logo,
 *   site search (an input-like trigger with the Cmd/Ctrl+K hint) and the
 *   light/dark/system switch. Page links live in the sidebar.
 * - `landing` (`/`, `/native/`, later `/solutions/…` and `/built-with/…`,
 *   ADR-031): logo, global nav (Solutions · Components · Native · Themes ·
 *   Agents · Docs · GitHub; site items whose pages exist), search, the
 *   switch and Get started. From 64rem the items are inline; below, one
 *   keyboard-operable menu lists the same items (no hover-only).
 */
import { safeHref } from '@texuli/core/url-policy';
import { Button } from 'texuli/button';
import BrandLogo from '../brand/BrandLogo.astro';
import SiteSearch from '../search/SiteSearch.svelte';
import { LANDING_NAV } from './nav-data.ts';
import { GET_STARTED, REPOSITORY_URL, SITE_NAME, withBase } from './site.ts';
import ThemeSwitch from './ThemeSwitch.svelte';

interface Props {
  variant?: 'docs' | 'landing';
}

const { variant = 'docs' } = Astro.props;
const base = import.meta.env.BASE_URL;
const repositoryHref = safeHref(REPOSITORY_URL, 'developer');
---

<header class="site-header" data-tx-site-header="" data-variant={variant}>
  {
    variant === 'docs' && (
      <button type="button" class="menu" aria-haspopup="dialog" aria-expanded="false" data-site-menu="">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <span class="menu__label">Menu</span>
      </button>
    )
  }
  {
    variant === 'landing' && (
      <button
        type="button"
        class="menu"
        aria-haspopup="true"
        aria-expanded="false"
        aria-controls="tx-global-nav"
        data-landing-menu=""
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <span class="menu__label">Menu</span>
      </button>
    )
  }
  <a class="brand" href={withBase(base, '/')} aria-label={`${SITE_NAME} home`}>
    <BrandLogo height={24} />
  </a>
  {
    variant === 'landing' && (
      <nav class="global-nav" id="tx-global-nav" aria-label="Global" data-global-nav="">
        <ul class="global-nav__list">
          {
            LANDING_NAV.map((item) => {
              const href = item.external ? repositoryHref : withBase(base, item.href);
              if (!href) return null;
              return (
                <li>
                  <a
                    class="docs-link"
                    href={href}
                    rel={item.external ? 'noopener noreferrer' : undefined}
                  >
                    {item.label}
                  </a>
                </li>
              );
            })
          }
        </ul>
      </nav>
    )
  }
  <div class="tools">
    <SiteSearch client:load base={base} compact />
    <ThemeSwitch client:load />
    {
      variant === 'landing' && (
        <Button href={withBase(base, GET_STARTED)} size="sm" class="get-started">
          Get started
        </Button>
      )
    }
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    inset-block-start: 0;
    z-index: 40;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    box-sizing: border-box;
    block-size: var(--site-header-height);
    padding-inline: 1rem;
    border-block-end: 1px solid var(--tx-border);
    background: color-mix(in srgb, var(--tx-background) 92%, transparent);
    backdrop-filter: blur(8px);
  }
  .global-nav {
    min-inline-size: 0;
  }
  .global-nav__list {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    /* A 40px target even when the logo shrinks to 20px on phones (T-89). */
    min-block-size: 2.5rem;
    border-radius: var(--tx-radius, 0.375rem);
  }
  .docs-link {
    display: inline-flex;
    align-items: center;
    min-block-size: 2.5rem;
    padding-inline: 0.5rem;
    border-radius: var(--tx-radius, 0.375rem);
    color: var(--tx-foreground);
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }
  .docs-link:hover {
    background: color-mix(in srgb, var(--tx-foreground) 6%, transparent);
  }
  @media (max-width: 64rem) {
    .tools :global(.get-started) {
      display: none;
    }
    .site-header[data-variant='landing'] .global-nav {
      display: none;
      position: absolute;
      inset-block-start: var(--site-header-height);
      inset-inline: 0;
      padding: 0.5rem 1rem 0.75rem;
      border-block-end: 1px solid var(--tx-border);
      background: var(--tx-background);
    }
    .site-header[data-variant='landing'] .global-nav[data-open] {
      display: block;
    }
    .site-header[data-variant='landing'] .global-nav__list {
      flex-direction: column;
      align-items: stretch;
    }
  }
  /* The search trigger keeps its label but stops claiming 16rem and drops
     its decorative Cmd/Ctrl+K hint (aria-hidden; the shortcut still works),
     and the links pad less, so the doors fit beside it from 48rem up. At
     769px the header had about 19px to spare with macOS fonts and ran 20px
     past the viewport with Linux fonts in CI. */
  @media (min-width: 48rem) and (max-width: 64rem) {
    .site-header[data-variant='landing'] .tools :global([data-tx-command-trigger]) {
      min-inline-size: 8rem;
    }
    .site-header[data-variant='landing'] .tools :global(.tx-command-trigger__keys) {
      display: none;
    }
    .site-header[data-variant='landing'] .docs-link {
      padding-inline: 0.375rem;
    }
  }
  /* From 64rem the GitHub door and Get started join the doors: at 1025px the
     header had 37px to spare with macOS fonts and ran 18px past the
     viewport with Linux fonts in CI, so the search trigger claims 10rem,
     not 16rem, until 72rem. */
  @media (min-width: 64rem) and (max-width: 72rem) {
    .site-header[data-variant='landing'] .tools :global([data-tx-command-trigger]) {
      min-inline-size: 10rem;
    }
  }
  @media (min-width: 64rem) {
    .site-header[data-variant='landing'] .menu {
      display: none;
    }
  }
  .tools {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-inline-start: auto;
    min-inline-size: 0;
  }
  .tools :global([data-tx-command-trigger]) {
    min-inline-size: min(16rem, 40vw);
  }
  .menu {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    min-block-size: 2.5rem;
    min-inline-size: 2.5rem;
    padding-inline: 0.5rem;
    border: 1px solid var(--tx-border);
    border-radius: var(--tx-radius, 0.375rem);
    background: transparent;
    color: var(--tx-foreground);
    font: inherit;
    cursor: pointer;
  }
  .menu svg {
    inline-size: 1.25rem;
    block-size: 1.25rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
  }
  .menu__label {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .menu[aria-busy='true'] {
    cursor: progress;
  }
  @media (min-width: 64rem) {
    .menu {
      display: none;
    }
  }
  /* Narrow phones: the search trigger collapses to its glyph (the
     component hides the label visually, keeping it as the accessible name,
     and drops the Cmd/Ctrl+K hint, meaningless on touch). It keeps a
     2.5rem target instead of shrinking to nothing (T-79, core row 12). */
  @media (max-width: 30rem) {
    .tools :global([data-tx-command-trigger]) {
      min-inline-size: 2.5rem;
    }
    .brand :global(.brand-logo) {
      block-size: 20px;
    }
    /* Logo, menu, search glyph and the three-way switch fit 360px only with
       tighter spacing: it ran 9px past the viewport before (T-89). */
    .site-header {
      gap: 0.5rem;
      padding-inline: 0.75rem;
    }
    .tools {
      gap: 0.25rem;
    }
    .docs-link {
      padding-inline: 0.25rem;
    }
  }
  .brand:focus-visible,
  .docs-link:focus-visible,
  .menu:focus-visible {
    outline: 2px solid var(--tx-ring);
    outline-offset: 2px;
  }
  @media (forced-colors: active) {
    .site-header {
      background: Canvas;
    }
  }
</style>

<script>
  // Phones: loads the drawer on the first press only (a lazy chunk), then reuses it.
  import type { SiteDrawerHandle } from './site-drawer.ts';

  const button = document.querySelector<HTMLButtonElement>('[data-site-menu]');
  let drawer: Promise<SiteDrawerHandle> | undefined;
  button?.addEventListener('click', async () => {
    if (!drawer) {
      button.setAttribute('aria-busy', 'true');
      drawer = import('./site-drawer.ts').then(({ createSiteDrawer }) => createSiteDrawer(button));
      drawer.catch(() => {
        drawer = undefined;
      });
    }
    try {
      (await drawer).show();
    } finally {
      button.removeAttribute('aria-busy');
    }
  });

  const landingMenu = document.querySelector<HTMLButtonElement>('[data-landing-menu]');
  const globalNav = document.querySelector<HTMLElement>('[data-global-nav]');
  const setLandingOpen = (open: boolean) => {
    landingMenu?.setAttribute('aria-expanded', open ? 'true' : 'false');
    globalNav?.toggleAttribute('data-open', open);
  };
  landingMenu?.addEventListener('click', () => {
    setLandingOpen(landingMenu.getAttribute('aria-expanded') !== 'true');
  });
  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape' || landingMenu?.getAttribute('aria-expanded') !== 'true') return;
    setLandingOpen(false);
    landingMenu.focus();
  });
</script>
