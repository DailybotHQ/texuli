---
/**
 * The slim sticky header, for global utilities only.
 *
 * - `docs` (every docs page): the menu button below 64rem (it opens the
 *   sidebar as a drawer whose code loads on first press), the Texuli logo,
 *   site search (an input-like trigger with the Cmd/Ctrl+K hint) and the
 *   light/dark/system switch. Page links live in the sidebar.
 * - `landing` (the home): the logo, a Docs link, the platform doors (Web +
 *   native, Native), a GitHub door, search, the switch and a Get started
 *   button. Up to 64rem GitHub and Get started hide (the footer carries
 *   GitHub, the hero carries Start building) and up to 48rem the doors hide
 *   too: the page body carries the platform paths. Without that the header
 *   ran 152px past a 768px viewport (T-89, walks/responsive.md).
 */
import { safeHref } from '@texuli/core/url-policy';
import { Button } from 'texuli/button';
import BrandLogo from '../brand/BrandLogo.astro';
import SiteSearch from '../search/SiteSearch.svelte';
import { DOCS_HOME, GET_STARTED, REPOSITORY_URL, SITE_NAME, withBase } from './site.ts';
import ThemeSwitch from './ThemeSwitch.svelte';

interface Props {
  variant?: 'docs' | 'landing';
}

const { variant = 'docs' } = Astro.props;
const base = import.meta.env.BASE_URL;
const repositoryHref = safeHref(REPOSITORY_URL, 'developer');
---

<header class="site-header" data-tx-site-header="" data-variant={variant}>
  {
    variant === 'docs' && (
      <button type="button" class="menu" aria-haspopup="dialog" aria-expanded="false" data-site-menu="">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <span class="menu__label">Menu</span>
      </button>
    )
  }
  <a class="brand" href={withBase(base, '/')} aria-label={`${SITE_NAME} home`}>
    <BrandLogo height={24} />
  </a>
  {
    variant === 'landing' && (
      <a class="docs-link" href={withBase(base, DOCS_HOME)}>
        Docs
      </a>
    )
  }
  {
    variant === 'landing' && (
      <nav class="platform-links" aria-label="Platform">
        <a class="docs-link" href={withBase(base, '/web-and-native/')}>
          Web + native
        </a>
        <a class="docs-link" href={withBase(base, '/native/')}>
          Native
        </a>
      </nav>
    )
  }
  {
    variant === 'landing' && repositoryHref && (
      // Hides up to 64rem (data-repo-door), and with the doors up to 48rem.
      <span class="platform-links" data-repo-door=""><a class="docs-link" href={repositoryHref}>GitHub</a></span>
    )
  }
  <div class="tools">
    <SiteSearch client:load base={base} compact />
    <ThemeSwitch client:load />
    {
      variant === 'landing' && (
        <Button href={withBase(base, GET_STARTED)} size="sm" class="get-started">
          Get started
        </Button>
      )
    }
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    inset-block-start: 0;
    z-index: 40;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    box-sizing: border-box;
    block-size: var(--site-header-height);
    padding-inline: 1rem;
    border-block-end: 1px solid var(--tx-border);
    background: color-mix(in srgb, var(--tx-background) 92%, transparent);
    backdrop-filter: blur(8px);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    /* A 40px target even when the logo shrinks to 20px on phones (T-89). */
    min-block-size: 2.5rem;
    border-radius: var(--tx-radius, 0.375rem);
  }
  .docs-link {
    display: inline-flex;
    align-items: center;
    min-block-size: 2.5rem;
    padding-inline: 0.5rem;
    border-radius: var(--tx-radius, 0.375rem);
    color: var(--tx-foreground);
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }
  .docs-link:hover {
    background: color-mix(in srgb, var(--tx-foreground) 6%, transparent);
  }
  .platform-links {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }
  @media (max-width: 64rem) {
    .tools :global(.get-started),
    [data-repo-door] {
      display: none;
    }
  }
  /* The search trigger keeps its label but stops claiming 16rem, and the
     links pad less, so the doors fit beside it from 48rem up. At 769px the
     header had about 19px to spare with macOS fonts and ran past the
     viewport with Linux fonts in CI; this frees about 48px more. */
  @media (min-width: 48rem) and (max-width: 64rem) {
    .site-header[data-variant='landing'] .tools :global([data-tx-command-trigger]) {
      min-inline-size: 8rem;
    }
    .site-header[data-variant='landing'] .docs-link {
      padding-inline: 0.375rem;
    }
  }
  @media (max-width: 48rem) {
    .platform-links {
      display: none;
    }
  }
  .tools {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-inline-start: auto;
    min-inline-size: 0;
  }
  .tools :global([data-tx-command-trigger]) {
    min-inline-size: min(16rem, 40vw);
  }
  .menu {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    min-block-size: 2.5rem;
    min-inline-size: 2.5rem;
    padding-inline: 0.5rem;
    border: 1px solid var(--tx-border);
    border-radius: var(--tx-radius, 0.375rem);
    background: transparent;
    color: var(--tx-foreground);
    font: inherit;
    cursor: pointer;
  }
  .menu svg {
    inline-size: 1.25rem;
    block-size: 1.25rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
  }
  .menu__label {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .menu[aria-busy='true'] {
    cursor: progress;
  }
  @media (min-width: 64rem) {
    .menu {
      display: none;
    }
  }
  /* Narrow phones: the search trigger collapses to its glyph (the
     component hides the label visually, keeping it as the accessible name,
     and drops the Cmd/Ctrl+K hint, meaningless on touch). It keeps a
     2.5rem target instead of shrinking to nothing (T-79, core row 12). */
  @media (max-width: 30rem) {
    .tools :global([data-tx-command-trigger]) {
      min-inline-size: 2.5rem;
    }
    .brand :global(.brand-logo) {
      block-size: 20px;
    }
    /* Logo, Docs, search glyph and the three-way switch fit 360px only with
       tighter spacing: it ran 9px past the viewport before (T-89). */
    .site-header {
      gap: 0.5rem;
      padding-inline: 0.75rem;
    }
    .tools {
      gap: 0.25rem;
    }
    .docs-link {
      padding-inline: 0.25rem;
    }
  }
  .brand:focus-visible,
  .docs-link:focus-visible,
  .menu:focus-visible {
    outline: 2px solid var(--tx-ring);
    outline-offset: 2px;
  }
  @media (forced-colors: active) {
    .site-header {
      background: Canvas;
    }
  }
</style>

<script>
  // Phones: loads the drawer on the first press only (a lazy chunk), then reuses it.
  import type { SiteDrawerHandle } from './site-drawer.ts';

  const button = document.querySelector<HTMLButtonElement>('[data-site-menu]');
  let drawer: Promise<SiteDrawerHandle> | undefined;
  button?.addEventListener('click', async () => {
    if (!drawer) {
      button.setAttribute('aria-busy', 'true');
      drawer = import('./site-drawer.ts').then(({ createSiteDrawer }) => createSiteDrawer(button));
      drawer.catch(() => {
        drawer = undefined;
      });
    }
    try {
      (await drawer).show();
    } finally {
      button.removeAttribute('aria-busy');
    }
  });
</script>
