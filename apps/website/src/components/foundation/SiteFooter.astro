---
/**
 * Site footer: ecosystem columns (Solutions, Native, Built with Texuli) for
 * routes that exist, the product row (derived from NAV_GROUPS, T-32), the
 * project row (agent surfaces, changelog, the repository, license and brand)
 * and the status line for Dailybot, Inc.
 *
 * T-79 (core punch list rows 3, 4, 9, 14): the status line states the
 * release truth from docs/RELEASE.md — pre-1.0 packages on npm, no stable
 * release, the native renderer in development — and is the single
 * sitewide place the npm release is claimed (narrative
 * blueprint §6). No version number here, so it cannot drift from the
 * registry. External links (repository, license) pass the URL policy at
 * the developer tier; site routes take the base.
 *
 * PLAN_007 T-dailybot-credit: a subtle "Powered by Dailybot" credit after
 * the status line, the muted kicker plus the horizontal Dailybot logo
 * (black on light modes, white on dark ones, like BrandLogo). The link's
 * name comes from aria-label; both images are decorative (alt="") and only
 * one is displayed, so the other stays out of the accessibility tree. Same
 * tab, like every other external link on the site.
 */
import { safeHref } from '@texuli/core/url-policy';
import { LISTED_PRODUCTS } from '../../data/products/index.ts';
import { siteRouteExists, solutionNavLinks } from './nav-data.ts';
import { NAV_GROUPS, REPOSITORY_URL, withBase } from './site.ts';

const base = import.meta.env.BASE_URL;

/** The project row: site routes first, then the repository and license. */
const links = [
  { href: '/guides/', label: 'Guides' },
  { href: '/changelog/', label: 'Changelog' },
  { href: '/llms.txt', label: 'llms.txt' },
  { href: '/skill/', label: 'Agent skill' },
  { href: '/brand/', label: 'Brand' },
  { href: REPOSITORY_URL, label: 'GitHub' },
  { href: `${REPOSITORY_URL}/blob/main/LICENSE`, label: 'MIT license' },
] as const;

/** The Dailybot credit: same link as the READMEs, tagged for this site. */
const DAILYBOT_URL =
  'https://www.dailybot.com?utm_source=dailybotopensource&utm_medium=texuli-website';
const dailybotHref = safeHref(DAILYBOT_URL, 'developer');
const dailybotLogo = (tone: 'black' | 'white') =>
  `${base.replace(/\/?$/, '/')}brand/dailybot/logo-horizontal-${tone}.svg`;

const resolveHref = (href: string): string | undefined => {
  const safe = safeHref(href, 'developer');
  if (safe === undefined) return undefined;
  return safe.startsWith('/') ? withBase(base, safe) : safe;
};

/**
 * Product doors, one per nav group, resolved against NAV_GROUPS so the
 * footer never drifts from the sidebar (T-32). The platform door is the
 * native landing; everything else takes the group's first link under its
 * group label.
 */
const PRODUCT_GROUP_IDS = ['components', 'primitives', 'themes', 'platform', 'agents'];
const productLinks = PRODUCT_GROUP_IDS.flatMap((id) => {
  const group = NAV_GROUPS.find((candidate) => candidate.id === id);
  if (!group) return [];
  const href = id === 'platform' ? '/native/' : (group.links[0]?.href ?? '');
  const label = id === 'platform' ? 'Native' : group.label;
  return href ? [{ href, label }] : [];
});

/** Solutions landings that already have a page (ADR-031). Empty until those routes ship. */
const solutionLinks = solutionNavLinks();

/**
 * Built with Texuli: the catalog index, then listed products whose case-study
 * page exists. Ronin Builder stays out until it is listed and has a route.
 */
const builtWithLinks = [
  ...(siteRouteExists('/built-with/') ? [{ href: '/built-with/', label: 'Explore all' }] : []),
  ...LISTED_PRODUCTS.filter((product) => siteRouteExists(`/built-with/${product.id}/`)).map(
    (product) => ({ href: `/built-with/${product.id}/`, label: product.name })
  ),
];

const nativeLinks = siteRouteExists('/native/') ? [{ href: '/native/', label: 'Native' }] : [];
---

<footer class="site-footer" data-tx-site-footer="">
  <div class="site-footer__inner">
    <nav aria-label="Footer">
      {
        (solutionLinks.length > 0 || nativeLinks.length > 0 || builtWithLinks.length > 0) && (
          <div class="site-footer__columns">
            {
              solutionLinks.length > 0 && (
                <div class="site-footer__column">
                  <h2>Solutions</h2>
                  <ul>
                    {solutionLinks.map((link) =>
                      link.href ? (
                        <li>
                          <a href={withBase(base, link.href)}>{link.label}</a>
                        </li>
                      ) : null
                    )}
                  </ul>
                </div>
              )
            }
            {
              nativeLinks.length > 0 && (
                <div class="site-footer__column">
                  <h2>Native</h2>
                  <ul>
                    {nativeLinks.map((link) => (
                      <li>
                        <a href={withBase(base, link.href)}>{link.label}</a>
                      </li>
                    ))}
                  </ul>
                </div>
              )
            }
            {
              builtWithLinks.length > 0 && (
                <div class="site-footer__column">
                  <h2>Built with Texuli</h2>
                  <ul>
                    {builtWithLinks.map((link) => (
                      <li>
                        <a href={withBase(base, link.href)}>{link.label}</a>
                      </li>
                    ))}
                  </ul>
                </div>
              )
            }
          </div>
        )
      }
      <ul class="site-footer__products">
        {
          productLinks.map((link) => (
            <li>
              <a href={withBase(base, link.href)}>{link.label}</a>
            </li>
          ))
        }
      </ul>
      <ul class="site-footer__project">
        {
          links.map((link) => (
            <li>
              <a href={resolveHref(link.href)}>{link.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
    <p class="site-footer__status" data-tx-site-status="">
      <strong>Texuli</strong> is MIT licensed, by Dailybot, Inc. Pre-1.0 packages are on
      npm; no stable release yet. The native renderer is in development.
    </p>
    <a
      class="site-footer__credit"
      data-tx-site-credit=""
      href={dailybotHref}
      rel="noopener noreferrer"
      aria-label="Powered by Dailybot"
    >
      <span class="site-footer__kicker">Powered by</span>
      <img
        class="site-footer__credit-light"
        src={dailybotLogo('black')}
        alt=""
        width="82"
        height="20"
        loading="lazy"
        decoding="async"
      />
      <img
        class="site-footer__credit-dark"
        src={dailybotLogo('white')}
        alt=""
        width="82"
        height="20"
        loading="lazy"
        decoding="async"
      />
    </a>
  </div>
</footer>

<style is:global>
  /* Global but rooted at .site-footer: a scoped style would stamp a data-astro-cid
     attribute on every footer element of every page (about 1.5 KB of HTML each). */
  .site-footer {
    padding-block: 1.75rem;
    padding-inline: 1rem;
    border-block-start: 1px solid var(--tx-border);
    color: var(--tx-muted-foreground);
    font-size: 0.875rem;
  }
  .site-footer .site-footer__inner {
    display: grid;
    gap: 0.75rem;
    max-inline-size: 72rem;
    margin-inline: auto;
  }
  .site-footer ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .site-footer .site-footer__products {
    font-weight: 600;
  }
  .site-footer nav {
    display: grid;
    gap: 0.75rem;
  }
  .site-footer .site-footer__columns {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
  }
  .site-footer .site-footer__column h2 {
    margin: 0;
    color: var(--tx-foreground);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .site-footer .site-footer__column ul {
    flex-direction: column;
    gap: 0;
  }
  .site-footer a {
    color: var(--tx-link);
    text-decoration: none;
    min-block-size: 2.5rem;
    display: inline-flex;
    align-items: center;
  }
  .site-footer a:hover {
    text-decoration: underline;
  }
  .site-footer a:focus-visible {
    outline: 2px solid var(--tx-ring);
    outline-offset: 2px;
  }
  .site-footer p {
    margin: 0;
    max-inline-size: 46rem;
    line-height: 1.5;
  }
  .site-footer .site-footer__status strong {
    color: var(--tx-foreground);
  }
  .site-footer code {
    font-size: 0.85em;
  }
  /* The Dailybot credit: muted and small, wrapping under the status line. */
  .site-footer .site-footer__credit {
    justify-self: start;
    flex-wrap: wrap;
    gap: 0.5rem;
    max-inline-size: 100%;
    color: var(--tx-muted-foreground);
  }
  .site-footer .site-footer__credit:hover {
    text-decoration: none;
    opacity: 0.8;
  }
  .site-footer .site-footer__kicker {
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .site-footer .site-footer__credit img {
    block-size: 1.25rem;
    inline-size: auto;
    max-inline-size: 100%;
  }
  .site-footer .site-footer__credit-dark {
    display: none;
  }
  :root[data-tx-mode='dark'] .site-footer .site-footer__credit-light {
    display: none;
  }
  :root[data-tx-mode='dark'] .site-footer .site-footer__credit-dark {
    display: block;
  }
  /* Forced colors never recolor the SVG artwork and the forced Canvas follows
     the system palette, not the site mode: pick the logo by
     prefers-color-scheme, the BrandLogo rule (PLAN_006 P2-6). */
  @media (forced-colors: active) {
    .site-footer__credit-light,
    :root[data-tx-mode] .site-footer .site-footer__credit-light {
      display: block;
    }
    .site-footer__credit-dark,
    :root[data-tx-mode] .site-footer .site-footer__credit-dark {
      display: none;
    }
  }
  @media (forced-colors: active) and (prefers-color-scheme: dark) {
    .site-footer__credit-light,
    :root[data-tx-mode] .site-footer .site-footer__credit-light {
      display: none;
    }
    .site-footer__credit-dark,
    :root[data-tx-mode] .site-footer .site-footer__credit-dark {
      display: block;
    }
  }
</style>
