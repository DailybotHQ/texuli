{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git ls-files:*)",
      "Bash(git rev-parse:*)",
      "Bash(git check-ignore:*)",
      "Bash(pnpm lint)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm test)",
      "Bash(pnpm check)",
      "Bash(pnpm build)",
      "Bash(pnpm vitest run:*)",
      "Bash(pnpm --filter * typecheck)",
      "Bash(npx biome check:*)",
      "Bash(bash .agents/skills/deepworkplan/verify/conformance.sh:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(git add -A:*)",
      "Bash(git add --all:*)",
      "Bash(git push:*)",
      "Bash(git remote add:*)"
    ]
  }
}
