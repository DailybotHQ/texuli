{
  "$comment": "Target-neutral semantic roles for the dual-target golden gate (spec/Compose design 7.2). Both the web trace (web/trace.ts) and the native trace (texuli-spec SemanticTrace.kt) apply these rules to a validated render tree. A rule names the role, the props tried in order for the accessible name, and, for headings, the prop holding the level.",
  "version": 1,
  "default": { "role": "generic" },
  "components": [
    { "id": "layout-page", "role": "main", "name": ["title"] },
    { "id": "layout-doc", "role": "main", "name": ["title"] },
    { "id": "layout-deck", "role": "main", "name": ["title"] },
    { "id": "layout-card", "role": "group", "name": ["title"] },
    { "id": "layout-grid", "role": "group" },
    { "id": "layout-stack", "role": "generic" },
    { "id": "layout-row", "role": "generic" },
    { "id": "layout-split", "role": "generic" },
    { "id": "layout-tile", "role": "generic" },
    { "id": "deck-slide", "role": "generic" },
    { "id": "media-image", "role": "img", "name": ["alt"] },
    { "id": "document", "role": "article", "name": ["label"] },
    { "id": "schema-form", "role": "form", "name": ["label"] },
    { "id": "canvas", "role": "figure", "name": ["label"] },
    { "prefix": "charts-", "role": "figure", "name": ["title", "label"] },
    { "id": "data-grid", "role": "table", "name": ["caption"] },
    { "id": "data-cohort-table", "role": "table", "name": ["caption"] },
    { "id": "data-tree-view", "role": "tree", "name": ["label"] },
    { "id": "data-files", "role": "group", "name": ["label"] },
    { "id": "data-calendar", "role": "grid", "name": ["label"] },
    { "id": "data-timeline", "role": "figure", "name": ["label"] },
    { "id": "data-notification-inbox", "role": "list" },
    { "id": "data-board", "role": "group", "name": ["label"] },
    { "id": "data-map", "role": "figure", "name": ["label"] },
    { "id": "data-dashboard", "role": "region", "name": ["label"] },
    { "id": "data-dashboard-widget", "role": "group", "name": ["title"] },
    { "id": "data-filter-builder", "role": "group", "name": ["label"] }
  ],
  "blocks": {
    "heading": { "role": "heading", "name": ["text"], "level": "level" },
    "text": { "role": "paragraph" },
    "list": { "role": "list" },
    "quote": { "role": "blockquote" },
    "callout": { "role": "note", "name": ["title"] },
    "table": { "role": "table", "name": ["caption"] },
    "stat": { "role": "group" },
    "kpi": { "role": "group" },
    "chart": { "role": "figure", "name": ["title"] }
  }
}
