{
  "name": "@texuli/forms",
  "version": "0.10.0",
  "private": true,
  "description": "Schema-driven forms for Texuli: a closed form schema rendered with texuli components, multi-step flows, conditional logic on @texuli/core/expression, announced validation, drafts and autosave.",
  "keywords": [
    "svelte",
    "svelte-5",
    "forms",
    "validation",
    "components",
    "texuli"
  ],
  "homepage": "https://github.com/DailybotHQ/texuli#readme",
  "bugs": "https://github.com/DailybotHQ/texuli/issues",
  "license": "MIT",
  "author": "Dailybot, Inc.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DailybotHQ/texuli.git",
    "directory": "packages/forms"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "svelte": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./model": {
      "types": "./src/model/index.ts",
      "default": "./src/model/index.ts"
    },
    "./host": {
      "types": "./src/host/index.ts",
      "default": "./src/host/index.ts"
    },
    "./styles.css": "./src/styles.css"
  },
  "scripts": {
    "typecheck": "node ../../scripts/typecheck-svelte.mjs"
  },
  "dependencies": {
    "@texuli/core": "0.10.0",
    "texuli": "0.10.0"
  },
  "peerDependencies": {
    "svelte": "^5.57.2"
  }
}
