{
  "name": "@texuli/sheets",
  "version": "0.11.4",
  "private": true,
  "description": "Spreadsheets for Texuli: an owned formula engine (a linear-time parser, a closed function set, a dependency graph with incremental recalculation and bounded evaluation), a framework-free workbook model, CSV import and export that neutralizes formula injection, and an accessible Svelte 5 sheet view over the data grid.",
  "keywords": [
    "spreadsheet",
    "sheets",
    "formula",
    "csv",
    "svelte",
    "texuli"
  ],
  "homepage": "https://github.com/DailybotHQ/texuli#readme",
  "bugs": "https://github.com/DailybotHQ/texuli/issues",
  "license": "MIT",
  "author": "Dailybot, Inc.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DailybotHQ/texuli.git",
    "directory": "packages/sheets"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "svelte": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./formula": {
      "types": "./src/formula/index.ts",
      "default": "./src/formula/index.ts"
    },
    "./model": {
      "types": "./src/model/index.ts",
      "default": "./src/model/index.ts"
    },
    "./csv": {
      "types": "./src/csv/index.ts",
      "default": "./src/csv/index.ts"
    },
    "./view": {
      "types": "./src/view/index.ts",
      "svelte": "./src/view/index.ts",
      "default": "./src/view/index.ts"
    },
    "./host": {
      "types": "./src/host/index.ts",
      "default": "./src/host/index.ts"
    }
  },
  "scripts": {
    "typecheck": "node ../../scripts/typecheck-svelte.mjs"
  },
  "dependencies": {
    "@texuli/core": "0.11.4",
    "@texuli/data": "0.11.4",
    "@texuli/date": "0.11.4",
    "texuli": "0.11.4"
  },
  "peerDependencies": {
    "svelte": "^5.57.2"
  }
}
