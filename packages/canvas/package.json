{
  "name": "@texuli/canvas",
  "version": "0.10.1",
  "private": true,
  "description": "Infinite canvas for Texuli: a framework-free canvas model (shapes, text, connectors, frames, transforms, snapping, an op log with undo), CRDT sync on @texuli/document/sync, an accessible Svelte 5 editor and viewer, and SVG and PNG export.",
  "keywords": [
    "canvas",
    "whiteboard",
    "diagram",
    "crdt",
    "svelte",
    "texuli"
  ],
  "homepage": "https://github.com/DailybotHQ/texuli#readme",
  "bugs": "https://github.com/DailybotHQ/texuli/issues",
  "license": "MIT",
  "author": "Dailybot, Inc.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DailybotHQ/texuli.git",
    "directory": "packages/canvas"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "svelte": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./model": {
      "types": "./src/model/index.ts",
      "default": "./src/model/index.ts"
    },
    "./sync": {
      "types": "./src/sync/index.ts",
      "default": "./src/sync/index.ts"
    },
    "./export": {
      "types": "./src/export/index.ts",
      "default": "./src/export/index.ts"
    },
    "./editor": {
      "types": "./src/editor/index.ts",
      "svelte": "./src/editor/index.ts",
      "default": "./src/editor/index.ts"
    },
    "./viewer": {
      "types": "./src/viewer/index.ts",
      "svelte": "./src/viewer/index.ts",
      "default": "./src/viewer/index.ts"
    },
    "./host": {
      "types": "./src/host/index.ts",
      "default": "./src/host/index.ts"
    }
  },
  "scripts": {
    "typecheck": "node ../../scripts/typecheck-svelte.mjs"
  },
  "dependencies": {
    "@texuli/core": "0.10.0",
    "@texuli/deck": "0.10.0",
    "@texuli/document": "0.10.0",
    "@texuli/drag": "0.10.0",
    "texuli": "0.10.1"
  },
  "peerDependencies": {
    "svelte": "^5.57.2"
  }
}
