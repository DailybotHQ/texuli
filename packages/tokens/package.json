{
  "name": "@texuli/tokens",
  "version": "0.11.3",
  "private": true,
  "description": "The OKLCH theme engine, the --tx-* token contract, 200+ themes and compiled CSS.",
  "keywords": [
    "svelte",
    "svelte-5",
    "components",
    "design-system",
    "texuli"
  ],
  "homepage": "https://github.com/DailybotHQ/texuli#readme",
  "bugs": "https://github.com/DailybotHQ/texuli/issues",
  "license": "MIT",
  "author": "Dailybot, Inc.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DailybotHQ/texuli.git",
    "directory": "packages/tokens"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./aa-gate": "./src/aa-gate/index.ts",
    "./aa-gate/components": "./src/aa-gate/components.ts",
    "./base.css": {
      "types": "./src/css/styles.ts",
      "default": "./src/css/base.css"
    },
    "./build": "./src/build/index.ts",
    "./components": "./src/components/index.ts",
    "./contract": "./src/contract/index.ts",
    "./css": "./src/css/index.ts",
    "./data-viz": "./src/data-viz/index.ts",
    "./design-system/apply": "./src/design-system/apply.ts",
    "./design-system/compile": "./src/design-system/compile.ts",
    "./design-system/compile-core": "./src/design-system/compile-core.ts",
    "./design-system/diff": "./src/design-system/diff.ts",
    "./design-system/emit": "./src/design-system/emit.ts",
    "./design-system/fixtures": "./src/design-system/fixtures.ts",
    "./design-system/import": "./src/design-system/import.ts",
    "./design-system/report": "./src/design-system/report.ts",
    "./design-system/validate": "./src/design-system/validate.ts",
    "./forced-colors": "./src/forced-colors/index.ts",
    "./forced-colors.css": "./src/forced-colors/forced-colors.css",
    "./generator": "./src/generator/index.ts",
    "./library": "./src/library-port/index.ts",
    "./library-expand": "./src/library-expand/index.ts",
    "./library-ids": "./src/library-ids/index.ts",
    "./modes": "./src/modes/index.ts",
    "./motion": "./src/motion/index.ts",
    "./no-flash": "./src/no-flash/index.ts",
    "./palette": "./src/palette/index.ts",
    "./renames": "./src/renames/index.ts",
    "./renames.json": "./src/renames/renames.json",
    "./style-presets": "./src/style-presets/index.ts",
    "./system": "./src/system/index.ts",
    "./system.css": {
      "types": "./src/css/styles.ts",
      "default": "./src/css/system.css"
    },
    "./tailwind": "./src/tailwind/index.ts",
    "./tailwind/preset.css": "./src/tailwind/preset.css"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@texuli/spec": "0.11.3"
  }
}
