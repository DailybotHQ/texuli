    "./library-expand": "./src/library-expand/index.ts",
    "./modes": "./src/modes/index.ts",
    "./no-flash": "./src/no-flash/index.ts",
    "./palette": "./src/palette/index.ts",
    "./style-presets": "./src/style-presets/index.ts",
