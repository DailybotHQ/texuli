{
  "name": "@texuli/player",
  "version": "0.11.4",
  "private": true,
  "description": "Svelte paint runtime for validated Texuli catalog blueprints.",
  "keywords": [
    "svelte",
    "svelte-5",
    "components",
    "design-system",
    "texuli"
  ],
  "homepage": "https://github.com/DailybotHQ/texuli#readme",
  "bugs": "https://github.com/DailybotHQ/texuli/issues",
  "license": "MIT",
  "author": "Dailybot, Inc.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DailybotHQ/texuli.git",
    "directory": "packages/player"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "svelte": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./design-system": {
      "types": "./src/design-system.ts",
      "svelte": "./src/design-system.ts",
      "default": "./src/design-system.ts"
    },
    "./design-system-core": {
      "types": "./src/design-system-core.ts",
      "svelte": "./src/design-system-core.ts",
      "default": "./src/design-system-core.ts"
    },
    "./styles.css": "./src/player.css"
  },
  "scripts": {
    "typecheck": "node ../../scripts/typecheck-svelte.mjs"
  },
  "dependencies": {
    "@texuli/blocks": "0.11.4",
    "@texuli/catalog": "0.11.4",
    "@texuli/charts": "0.11.4",
    "@texuli/chat": "0.11.4",
    "@texuli/core": "0.11.4",
    "@texuli/data": "0.11.4",
    "@texuli/media": "0.11.4",
    "@texuli/primitives": "0.11.4",
    "@texuli/spec": "0.11.4",
    "@texuli/workflows": "0.11.4",
    "texuli": "0.11.4"
  },
  "peerDependencies": {
    "svelte": "^5.57.2"
  }
}
