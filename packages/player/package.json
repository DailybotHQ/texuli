{
  "name": "@texuli/player",
  "version": "0.2.0",
  "private": true,
  "description": "Svelte paint runtime for validated Texuli catalog blueprints.",
  "keywords": [
    "svelte",
    "svelte-5",
    "components",
    "design-system",
    "texuli"
  ],
  "homepage": "https://github.com/DailybotHQ/texuli#readme",
  "bugs": "https://github.com/DailybotHQ/texuli/issues",
  "license": "MIT",
  "author": "Dailybot, Inc.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DailybotHQ/texuli.git",
    "directory": "packages/player"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "svelte": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./styles.css": "./src/player.css"
  },
  "scripts": {
    "typecheck": "node ../../scripts/typecheck-svelte.mjs"
  },
  "dependencies": {
    "@texuli/blocks": "0.2.0",
    "@texuli/catalog": "0.2.0",
    "@texuli/charts": "0.2.0",
    "@texuli/media": "0.2.0"
  },
  "peerDependencies": {
    "svelte": "^5.57.2"
  }
}
