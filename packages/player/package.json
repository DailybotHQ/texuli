{
  "name": "@texuli/player",
  "version": "0.0.0",
  "private": true,
  "description": "Svelte paint runtime for validated Texuli catalog blueprints.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "svelte": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./styles.css": "./src/player.css"
  },
  "scripts": {
    "typecheck": "node ../../scripts/typecheck-svelte.mjs"
  },
  "dependencies": {
    "@texuli/blocks": "workspace:*",
    "@texuli/catalog": "workspace:*",
    "@texuli/charts": "workspace:*",
    "@texuli/media": "workspace:*"
  },
  "peerDependencies": {
    "svelte": "^5.57.2"
  },
  "sideEffects": [
    "**/*.css"
  ]
}
