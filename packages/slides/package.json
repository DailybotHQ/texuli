{
  "name": "@texuli/slides",
  "version": "0.1.0-next.1",
  "private": true,
  "description": "Presentation deck model, grammar, and responsive stage runtime.",
  "keywords": [
    "svelte",
    "svelte-5",
    "components",
    "design-system",
    "texuli"
  ],
  "homepage": "https://github.com/DailybotHQ/texuli#readme",
  "bugs": "https://github.com/DailybotHQ/texuli/issues",
  "license": "MIT",
  "author": "Dailybot, Inc.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DailybotHQ/texuli.git",
    "directory": "packages/slides"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "svelte": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./model": {
      "types": "./src/model/index.ts",
      "default": "./src/model/index.ts"
    },
    "./grammar": {
      "types": "./src/grammar/index.ts",
      "default": "./src/grammar/index.ts"
    },
    "./export": {
      "types": "./src/export/index.ts",
      "default": "./src/export/index.ts"
    },
    "./templates": {
      "types": "./src/templates/index.ts",
      "default": "./src/templates/index.ts"
    },
    "./stage": {
      "types": "./src/stage/index.ts",
      "svelte": "./src/stage/index.ts",
      "default": "./src/stage/index.ts"
    },
    "./styles.css": "./src/styles.css"
  },
  "scripts": {
    "typecheck": "node ../../scripts/typecheck-svelte.mjs"
  },
  "dependencies": {
    "@texuli/blocks": "0.1.0-next.1",
    "@texuli/catalog": "0.1.0-next.1",
    "@texuli/media": "0.1.0-next.1",
    "@texuli/tokens": "0.1.0-next.1"
  },
  "peerDependencies": {
    "svelte": "^5.57.2"
  }
}
