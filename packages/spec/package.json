{
  "name": "@texuli/spec",
  "version": "0.8.0",
  "private": true,
  "description": "The schema-first blueprint contract: JSON schemas, the catalog vocabulary, deterministic TypeScript and Kotlin projections, and the conformance harness.",
  "keywords": [
    "svelte",
    "svelte-5",
    "components",
    "design-system",
    "texuli"
  ],
  "homepage": "https://github.com/DailybotHQ/texuli#readme",
  "bugs": "https://github.com/DailybotHQ/texuli/issues",
  "license": "MIT",
  "author": "Dailybot, Inc.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DailybotHQ/texuli.git",
    "directory": "packages/spec"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./workflow": {
      "types": "./src/workflow.ts",
      "default": "./src/workflow.ts"
    },
    "./migrate": {
      "types": "./src/migrations/index.ts",
      "default": "./src/migrations/index.ts"
    },
    "./codegen": {
      "types": "./src/codegen/index.ts",
      "default": "./src/codegen/index.ts"
    },
    "./surface": {
      "types": "./src/surface.ts",
      "default": "./src/surface.ts"
    },
    "./motion": {
      "types": "./src/motion.ts",
      "default": "./src/motion.ts"
    },
    "./stream": {
      "types": "./src/stream/index.ts",
      "default": "./src/stream/index.ts"
    },
    "./source": {
      "types": "./src/source.ts",
      "default": "./src/source.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json"
  }
}
