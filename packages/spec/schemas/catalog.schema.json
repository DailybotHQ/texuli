{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://texuli.example/spec/schemas/catalog.schema.json",
  "title": "SpecCatalog",
  "description": "The platform-neutral catalog vocabulary, bootstrapped from the built catalog. Placement, emission trust and portability are separate fields.",
  "type": "object",
  "properties": {
    "catalogHash": {
      "description": "The built catalog this vocabulary was projected from.",
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "components": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/component"
      }
    }
  },
  "required": ["catalogHash", "components"],
  "additionalProperties": false,
  "$defs": {
    "component": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "group": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
        },
        "placement": {
          "description": "Product placement: the manifest tier.",
          "type": "string",
          "enum": ["app", "content"]
        },
        "emit": {
          "description": "Emission trust: the tiers that may emit the id.",
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["developer", "untrusted"]
          }
        },
        "capability": {
          "description": "ADR-003 portability. unknown until audited.",
          "type": "string",
          "enum": ["portable-core", "web-only", "native-only", "unknown"]
        },
        "props": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/prop"
          }
        },
        "events": {
          "description": "The closed events the component fires; a node's on keys must be listed here.",
          "type": "array",
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/eventName"
          }
        },
        "bindable": {
          "description": "Props a node may two-way bind (node bind).",
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          }
        },
        "sourceable": {
          "description": "Props a node may read from a host data source (spec 0.8.0, ADR-015): {\"$source\": name, \"query\": {...}}. Each names an array prop whose items are rows.",
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          }
        },
        "deprecated": {
          "$ref": "#/$defs/deprecation"
        }
      },
      "required": ["id", "label", "summary", "group", "placement", "emit", "capability", "props"],
      "additionalProperties": false
    },
    "prop": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
        },
        "kind": {
          "type": "string",
          "enum": [
            "string",
            "number",
            "boolean",
            "enum",
            "array",
            "object",
            "slot",
            "event",
            "unknown"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "enumValues": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "extension": {
          "description": "A named platform extension: the prop does not cross the shared boundary (slot, event and unknown kinds).",
          "type": "string",
          "enum": ["web"]
        },
        "schema": {
          "$ref": "#/$defs/propSchema"
        },
        "deprecated": {
          "$ref": "#/$defs/deprecation"
        }
      },
      "required": ["name", "kind"],
      "additionalProperties": false
    },
    "eventName": {
      "description": "The closed event vocabulary.",
      "type": "string",
      "enum": ["press", "change", "select", "submit", "dismiss", "move"]
    },
    "deprecation": {
      "description": "Deprecated since a spec version; warns for one minor before removal.",
      "type": "object",
      "properties": {
        "since": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "replacement": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
        }
      },
      "required": ["since"],
      "additionalProperties": false
    },
    "propSchema": {
      "description": "A dialect subset an array or object prop's value must match. Objects are closed unless additionalProperties gives a map. No pattern (cross-target regex parity). $ref names one of binding, reorder, action, eventMap, condition (blueprint $defs) or workflowGraph.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["object", "array", "string", "number", "integer", "boolean"]
        },
        "description": {
          "type": "string"
        },
        "properties": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/propSchema"
          }
        },
        "required": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "additionalProperties": {
          "$ref": "#/$defs/propSchema"
        },
        "items": {
          "$ref": "#/$defs/propSchema"
        },
        "enum": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "string"
          }
        },
        "minLength": {
          "type": "integer",
          "minimum": 0
        },
        "maxLength": {
          "type": "integer",
          "minimum": 0
        },
        "minimum": {
          "type": "number"
        },
        "maximum": {
          "type": "number"
        },
        "minItems": {
          "type": "integer",
          "minimum": 0
        },
        "maxItems": {
          "type": "integer",
          "minimum": 0
        },
        "$ref": {
          "type": "string",
          "pattern": "^#/\\$defs/(binding|reorder|action|eventMap|condition|workflowGraph|document|formSchema|canvas)$"
        }
      },
      "additionalProperties": false
    }
  }
}
