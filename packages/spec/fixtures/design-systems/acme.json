  "typography": {
    "families": {
      "sans": {
        "stack": ["Acme Sans", "system-ui", "sans-serif"],
        "files": [
          {
            "src": "fonts/acme-sans.woff2",
            "weight": "100 900",
            "style": "normal",
            "display": "swap",
            "preload": true
          }
        ]
      },
      "heading": {
        "stack": ["Acme Display", "Acme Sans", "system-ui"],
        "files": [
          {
            "src": "fonts/acme-display.woff2",
            "weight": "100 900",
            "style": "normal",
            "display": "swap",
            "preload": true
          }
        ]
      },
      "mono": {
        "stack": ["Acme Mono", "ui-monospace", "monospace"]
      },
      "serif": {
        "stack": ["Georgia", "serif"]
      }
    },
    "scale": {
      "base": 16,
      "ratio": 1.2
    },
    "roles": {
      "display": {
        "family": "heading",
        "size": 48,
        "weight": 700,
        "line": 1.1,
        "tracking": -0.02
      },
      "title": {
        "family": "heading",
        "size": 30,
        "weight": 650,
        "line": 1.2
      },
      "heading": {
        "family": "heading",
        "size": 20,
        "weight": 600,
        "line": 1.3
      },
      "body": {
        "family": "sans",
        "size": 16,
        "weight": 400,
        "line": 1.5
      },
      "label": {
        "family": "sans",
        "size": 14,
        "weight": 500,
        "line": 1.4
      },
      "caption": {
        "family": "sans",
        "size": 12,
        "weight": 400,
        "line": 1.4,
        "tracking": 0.01
      },
      "code": {
        "family": "mono",
        "size": 14,
        "weight": 400,
        "line": 1.6
      }
    }
  },
  "shape": {
    "radius": 8,
    "radiusScale": 1,
    "borderWidth": 1
  },
  "space": {
    "base": 4,
    "density": 1
  },
  "elevation": {
    "style": "soft"
  },
  "surface": {
    "style": "glass",
    "glass": {
      "alpha": 0.72,
      "blur": 16
    }
  },
  "motion": {
    "personality": "standard",
    "durations": {
      "fast": 120,
      "base": 200,
      "slow": 320
    },
    "easing": "emphasized"
  },
  "layout": {
    "contentMax": 1120,
    "wideMax": 1440,
    "breakpoints": {
      "sm": 640,
      "md": 960,
      "lg": 1280
    },
    "grid": {
      "columns": {
        "base": 4,
        "sm": 8,
        "md": 12,
        "lg": 12
      },
      "gutter": {
        "base": "space-4",
        "sm": "space-4",
        "md": "space-6",
        "lg": "space-8"
      }
    }
  },
  "icons": {
    "style": "outline",
    "stroke": 1.75,
    "size": {
      "sm": 16,
      "md": 20,
      "lg": 24
    }
  },
  "components": {
    "button": {
      "radius": "full",
      "height-md": "control-md",
      "font-weight": "label",
      "elevation": 1,
      "disabled-opacity": "disabled",
      "defaults": {
        "variant": "default",
        "size": "md"
      }
    },
    "icon-button": {
      "defaults": {
        "variant": "ghost",
        "size": "icon"
      }
    },
    "card": {
      "radius": "xl",
      "background": "surface",
      "border-width": "thin",
      "defaults": {
        "variant": "flat"
      }
    },
    "icon": {
      "stroke-width": 1.5
    }
  },
  "assets": {
    "logo": {
      "light": "assets/logo.svg",
      "dark": "assets/logo-dark.svg",
      "mark": "./assets/mark.svg",
      "wordmark": "/assets/wordmark.png"
    },
    "favicon": "assets/favicon.ico"
  },
  "voice": {
    "tone": ["clear", "warm"],
    "lexicon": {
      "workspace": "team space",
      "board": "canvas"
    },
    "guidelines": ["Write in the second person.", "Prefer short sentences."]
  },
  "accessibility": {
    "contrast": "AA",
    "targetMin": 24,
    "focus": "ring",
    "focusWidth": 2,
    "focusOffset": 2
