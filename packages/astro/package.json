{
  "name": "@texuli/astro",
  "version": "0.11.4",
  "private": true,
  "description": "Astro integration, content layouts and Svelte islands for Texuli sites.",
  "keywords": [
    "svelte",
    "svelte-5",
    "components",
    "design-system",
    "texuli"
  ],
  "homepage": "https://github.com/DailybotHQ/texuli#readme",
  "bugs": "https://github.com/DailybotHQ/texuli/issues",
  "license": "MIT",
  "author": "Dailybot, Inc.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DailybotHQ/texuli.git",
    "directory": "packages/astro"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./appearance": "./src/appearance/index.ts",
    "./content": "./src/content/index.ts",
    "./design-system": "./src/design-system/index.ts",
    "./integration": "./src/integration/index.ts",
    "./site": "./src/site/index.ts",
    "./styles.css": "./src/styles.css",
    "./layouts/ContentLayout": "./src/layouts/ContentLayout.ts",
    "./sections/Hero": "./src/sections/Hero.ts",
    "./sections/Section": "./src/sections/Section.ts"
  },
  "scripts": {
    "typecheck": "node ../../scripts/typecheck-svelte.mjs"
  },
  "dependencies": {
    "@texuli/blocks": "0.11.4",
    "@texuli/core": "0.11.4",
    "@texuli/tokens": "0.11.4",
    "astro": "^7.4.0"
  },
  "peerDependencies": {
    "@astrojs/svelte": "^9.1.0",
    "svelte": "^5.57.2"
  }
}
