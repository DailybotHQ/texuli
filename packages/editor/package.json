{
  "name": "@texuli/editor",
  "version": "0.11.0",
  "private": true,
  "description": "Rich text editor for Svelte 5 on the @texuli/core editor texels: owned document model, transforms, history, Markdown in and out, and a sink-free rendering.",
  "keywords": [
    "svelte",
    "svelte-5",
    "rich-text",
    "editor",
    "markdown",
    "design-system",
    "texuli"
  ],
  "homepage": "https://github.com/DailybotHQ/texuli#readme",
  "bugs": "https://github.com/DailybotHQ/texuli/issues",
  "license": "MIT",
  "author": "Dailybot, Inc.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DailybotHQ/texuli.git",
    "directory": "packages/editor"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "svelte": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./controller": {
      "types": "./src/controller/index.ts",
      "svelte": "./src/controller/index.ts",
      "default": "./src/controller/index.ts"
    },
    "./editor": {
      "types": "./src/editor/index.ts",
      "svelte": "./src/editor/index.ts",
      "default": "./src/editor/index.ts"
    },
    "./link-dialog": {
      "types": "./src/link-dialog/index.ts",
      "svelte": "./src/link-dialog/index.ts",
      "default": "./src/link-dialog/index.ts"
    },
    "./markdown": {
      "types": "./src/markdown/index.ts",
      "default": "./src/markdown/index.ts"
    },
    "./paste": {
      "types": "./src/paste/index.ts",
      "default": "./src/paste/index.ts"
    },
    "./toolbar": {
      "types": "./src/toolbar/index.ts",
      "svelte": "./src/toolbar/index.ts",
      "default": "./src/toolbar/index.ts"
    }
  },
  "scripts": {
    "typecheck": "node ../../scripts/typecheck-svelte.mjs"
  },
  "dependencies": {
    "@texuli/core": "0.11.0",
    "@texuli/primitives": "0.11.0",
    "@texuli/tokens": "0.11.0",
    "texuli": "0.11.0"
  },
  "peerDependencies": {
    "svelte": "^5.57.2"
  }
}
