{
  "name": "@texuli/emojis",
  "version": "0.18.0",
  "private": true,
  "description": "Framework-free Unicode emoji catalog and compatibility data for Texuli.",
  "keywords": [
    "emoji",
    "unicode",
    "cldr",
    "texuli"
  ],
  "homepage": "https://github.com/DailybotHQ/texuli#readme",
  "bugs": "https://github.com/DailybotHQ/texuli/issues",
  "license": "MIT",
  "author": "Dailybot, Inc.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DailybotHQ/texuli.git",
    "directory": "packages/emojis"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./catalog": {
      "types": "./src/catalog.ts",
      "default": "./src/catalog.ts"
    },
    "./search": {
      "types": "./src/search.ts",
      "default": "./src/search.ts"
    },
    "./legacy-engine": {
      "types": "./src/legacy-engine.ts",
      "default": "./src/legacy-engine.ts"
    },
    "./legacy": {
      "types": "./src/data/legacy.ts",
      "default": "./src/data/legacy.ts"
    },
    "./data": {
      "types": "./src/data/index.ts",
      "default": "./src/data/index.ts"
    }
  }
}
