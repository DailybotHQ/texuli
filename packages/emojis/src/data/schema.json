{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://texuli.com/schemas/texuli-emoji-v1.json",
  "title": "Texuli Emoji catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "unicodeEmojiVersion",
    "cldrVersion",
    "catalogVersion",
    "generatedAt",
    "records"
  ],
  "properties": {
    "schemaVersion": {
      "const": "texuli-emoji/v1"
    },
    "unicodeEmojiVersion": {
      "type": "string",
      "const": "18.0"
    },
    "cldrVersion": {
      "type": "string",
      "const": "49"
    },
    "catalogVersion": {
      "type": "string",
      "const": "18.0.0+cldr.49"
    },
    "generatedAt": {
      "type": "string",
      "format": "date"
    },
    "records": {
      "type": "array",
      "minItems": 3963,
      "maxItems": 3963,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "unicode",
          "codepoints",
          "name",
          "shortcode",
          "aliases",
          "category",
          "subcategory",
          "sortOrder",
          "emojiVersion",
          "keywords",
          "qualificationAliases",
          "artAvailable"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-f]+(?:-[0-9a-f]+)*$"
          },
          "unicode": {
            "type": "string",
            "minLength": 1
          },
          "codepoints": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[0-9A-F]{1,6}$"
            }
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "shortcode": {
            "type": "string",
            "pattern": "^:[a-z0-9_]+:$"
          },
          "aliases": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "category": {
            "enum": [
              "smileys-emotion",
              "people-body",
              "animals-nature",
              "food-drink",
              "travel-places",
              "activities",
              "objects",
              "symbols",
              "flags"
            ]
          },
          "subcategory": {
            "type": "string",
            "minLength": 1
          },
          "sortOrder": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3962
          },
          "emojiVersion": {
            "type": "string",
            "pattern": "^[0-9]+(?:\\.[0-9]+)*$"
          },
          "keywords": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "qualificationAliases": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "variantOf": {
            "type": "string",
            "pattern": "^[0-9a-f]+(?:-[0-9a-f]+)*$"
          },
          "variants": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "tone": {
            "enum": ["light", "medium-light", "medium", "medium-dark", "dark"]
          },
          "artAvailable": {
            "const": false
          }
        }
      }
    }
  }
}
