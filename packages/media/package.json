  "scripts": {
    "typecheck": "node ../../scripts/typecheck-svelte.mjs"
  },
  "dependencies": {
    "@texuli/core": "0.11.5",
    "@texuli/primitives": "0.11.5",
    "@texuli/tokens": "0.11.5",
