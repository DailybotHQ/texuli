    },
    "./animation": {
      "types": "./src/animation/index.ts",
      "default": "./src/animation/index.ts"
    },
    "./animation/player": {
      "types": "./src/animation/player.ts",
      "svelte": "./src/animation/player.ts",
      "default": "./src/animation/player.ts"
    },
    "./audio": {
      "types": "./src/audio/entry.ts",
      "svelte": "./src/audio/entry.ts",
      "default": "./src/audio/entry.ts"
    },
    "./captions": {
      "types": "./src/captions/entry.ts",
      "svelte": "./src/captions/entry.ts",
      "default": "./src/captions/entry.ts"
    },
