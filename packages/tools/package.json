{
  "name": "@texuli/tools",
  "version": "0.11.3",
  "private": true,
  "description": "Agent and developer tools: the copy-in CLI, the MCP server, custom elements, adapters and the golden set.",
  "keywords": [
    "svelte",
    "svelte-5",
    "components",
    "design-system",
    "texuli"
  ],
  "homepage": "https://github.com/DailybotHQ/texuli#readme",
  "bugs": "https://github.com/DailybotHQ/texuli/issues",
  "license": "MIT",
  "author": "Dailybot, Inc.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DailybotHQ/texuli.git",
    "directory": "packages/tools"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./a2ui": {
      "types": "./src/a2ui/index.ts",
      "default": "./src/a2ui/index.ts"
    },
    "./cli-add": {
      "types": "./src/cli-add/index.ts",
      "default": "./src/cli-add/index.ts"
    },
    "./cli-init": {
      "types": "./src/cli-init/index.ts",
      "default": "./src/cli-init/index.ts"
    },
    "./cli-update": {
      "types": "./src/cli-update/index.ts",
      "default": "./src/cli-update/index.ts"
    },
    "./llms": {
      "types": "./src/llms/index.ts",
      "default": "./src/llms/index.ts"
    },
    "./elements": {
      "types": "./src/elements/index.ts",
      "default": "./src/elements/index.ts"
    },
    "./golden": {
      "types": "./src/golden/index.ts",
      "default": "./src/golden/index.ts"
    },
    "./deck": {
      "types": "./src/deck/index.ts",
      "default": "./src/deck/index.ts"
    },
    "./document": {
      "types": "./src/document/index.ts",
      "default": "./src/document/index.ts"
    },
    "./email": {
      "types": "./src/email/index.ts",
      "default": "./src/email/index.ts"
    },
    "./print": {
      "types": "./src/print/index.ts",
      "default": "./src/print/index.ts"
    },
    "./ops": {
      "types": "./src/ops/index.ts",
      "default": "./src/ops/index.ts"
    },
    "./ds-check": {
      "types": "./src/ds-check/index.ts",
      "default": "./src/ds-check/index.ts"
    },
    "./ds-check/host": {
      "types": "./src/ds-check/host.ts",
      "default": "./src/ds-check/host.ts"
    },
    "./mcp": {
      "types": "./src/mcp/index.ts",
      "default": "./src/mcp/index.ts"
    }
  },
  "bin": {
    "texuli": "./src/cli/texuli.ts",
    "texuli-add": "./src/cli-add/cli.ts",
    "texuli-init": "./src/cli-init/cli.ts",
    "texuli-llms": "./src/llms/cli.ts",
    "texuli-update": "./src/cli-update/cli.ts",
    "texuli-deck": "./src/cli/deck.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@texuli/core": "0.11.3",
    "@texuli/catalog": "0.11.3",
    "@texuli/tokens": "0.11.3",
    "@texuli/blocks": "0.11.3",
    "@texuli/charts": "0.11.3",
    "@texuli/media": "0.11.3",
    "@texuli/deck": "0.11.3",
    "@texuli/document": "0.11.3"
  },
  "peerDependencies": {
    "svelte": "^5.57.2"
  }
}
